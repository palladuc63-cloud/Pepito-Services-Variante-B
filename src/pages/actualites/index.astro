---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/Section.astro';
import EmptyState from '../../components/EmptyState.astro';
import { articles } from '../../data/articles';
---

<MainLayout
  title="Actualités"
  description="Les actualités et conseils de Pépito Services autour des clôtures, palissades, portillons et aménagements extérieurs."
  canonicalPath="/actualites"
>
  <Section>
    <div class="page-header">
      <h1 class="section-title">Actualités</h1>
      <p class="section-subtitle">
        Retrouvez prochainement ici les actualités, conseils et inspirations de
        Pépito Services. Aucun article n’est publié pour le moment afin de ne pas
        diffuser de contenu non validé.
      </p>
    </div>

    {
      articles.length > 0 ? (
        <div class="articles-grid"><!-- future ArticleCard mapping --></div>
      ) : (
        <EmptyState
          title="Aucun article pour le moment"
          message="Le blog sera alimenté une fois les premiers contenus validés avec l’entreprise. Les articles futurs pourront être créés via le back-office prévu."
        />
      )
    }
  </Section>
</MainLayout>

<style>
  .page-header {
    margin-bottom: var(--space-8);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
