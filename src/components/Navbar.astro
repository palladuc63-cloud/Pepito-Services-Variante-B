---
import { settings } from '../data/settings';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const logoSrc = typeof settings.logo === 'string' ? settings.logo : settings.logo.src;

const navLinks = settings.nav.map((link) => ({
  ...link,
  href: link.href === '/' ? base : `${base}${link.href.replace(/^\//, '')}`,
  isActive: link.href === '/'
    ? currentPath === base || currentPath === `${base}`
    : currentPath.startsWith(`${base}${link.href.replace(/^\//, '')}`),
}));
---

<header class="site-header sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-stone-200">
  <div class="container mx-auto px-4">
    <nav class="main-nav flex items-center justify-between min-h-20" aria-label="Navigation principale">
      <a href={base} class="inline-flex items-center flex-shrink-0" aria-label={`Accueil ${settings.name}`}>
        <img
          src={logoSrc}
          alt=""
          width="140"
          height="56"
          class="w-auto object-contain"
          style="height: 3.5rem;"
        />
      </a>

      <ul class="desktop-nav hidden md:flex items-center gap-2 list-none m-0 p-0" role="menubar">
        {
          navLinks.map((link) => (
            <li role="none">
              <a
                href={link.href}
                class:list={[
                  'nav-link inline-flex items-center rounded-full px-4 py-2 text-sm font-medium no-underline transition-colors',
                  link.isActive
                    ? 'text-emerald-700 bg-emerald-50'
                    : 'text-stone-600 hover:bg-stone-100 hover:text-emerald-700',
                ]}
                aria-current={link.isActive ? 'page' : undefined}
                role="menuitem"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        class="mobile-menu-toggle md:hidden inline-flex items-center justify-center w-11 h-11 rounded-full border border-stone-200 bg-white shadow-sm"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Ouvrir le menu"
      >
        <span class="hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </nav>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu principal" hidden>
  <div class="mobile-menu__header">
    <span class="mobile-menu__title">Menu</span>
    <button type="button" class="mobile-menu__close" aria-label="Fermer le menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <ul class="mobile-menu__list" role="menubar">
    {
      navLinks.map((link) => (
        <li class="mobile-menu__item" role="none">
          <a
            href={link.href}
            class="mobile-menu__link"
            aria-current={link.isActive ? 'page' : undefined}
            role="menuitem"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  (function () {
    const toggle = document.querySelector('.mobile-menu-toggle') as HTMLButtonElement | null;
    const menu = document.getElementById('mobile-menu') as HTMLElement | null;
    if (!toggle || !menu) return;

    const menuEl = menu;
    const toggleEl = toggle;
    const closeBtn = menuEl.querySelector('.mobile-menu__close') as HTMLButtonElement | null;

    function openMenu() {
      menuEl.hidden = false;
      document.body.style.overflow = 'hidden';
      toggleEl.setAttribute('aria-expanded', 'true');
      toggleEl.setAttribute('aria-label', 'Fermer le menu');
      closeBtn?.focus();
    }

    function closeMenu() {
      menuEl.hidden = true;
      document.body.style.overflow = '';
      toggleEl.setAttribute('aria-expanded', 'false');
      toggleEl.setAttribute('aria-label', 'Ouvrir le menu');
      toggleEl.focus();
    }

    toggleEl.addEventListener('click', () => {
      menuEl.hidden ? openMenu() : closeMenu();
    });

    closeBtn?.addEventListener('click', closeMenu);

    menuEl.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menuEl.hidden) {
        closeMenu();
      }
    });
  })();
</script>

<style>
  /* Hamburger icon */
  .hamburger {
    width: 1.25rem;
    height: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #1f2937;
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
    transform-origin: center;
  }

  .mobile-menu-toggle[aria-expanded='true'] .hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-toggle[aria-expanded='true'] .hamburger span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle[aria-expanded='true'] .hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu overlay */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
    background: var(--color-secondary);
    color: var(--color-warm-white);
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    overflow-y: auto;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .mobile-menu__title {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .mobile-menu__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-warm-white);
    border: none;
    cursor: pointer;
    transition: background-color 200ms ease;
  }

  .mobile-menu__close:hover,
  .mobile-menu__close:focus {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .mobile-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu__item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-menu__link {
    display: block;
    padding: 1rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-warm-white);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link:focus {
    color: var(--color-sand);
  }

  .mobile-menu__link[aria-current='page'] {
    color: var(--color-primary-light);
  }
</style>
