---
import { Image } from 'astro:assets';
import { settings } from '../data/settings';
import NavItem from './NavItem.astro';

const currentPath = Astro.url.pathname;
const splitAt = Math.ceil(settings.nav.length / 2);
const leftItems = settings.nav.slice(0, splitAt);
const rightItems = settings.nav.slice(splitAt);

// Find the dropdown item (Réalisations) to build a mega-menu panel
const dropdownItem = settings.nav.find((link) => link.children);

const logoSrc = typeof settings.logo === 'string' ? settings.logo : settings.logo.src;
const base = import.meta.env.BASE_URL;
---

<header class="site-header sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-stone-200" data-has-dropdown={!!dropdownItem}>
  <div class="container">
    <nav class="main-nav relative flex items-center justify-center min-h-20 gap-4" aria-label="Navigation principale">
      <button
        type="button"
        class="nav-toggle absolute right-0 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-11 h-11 rounded-full border border-stone-200 bg-white shadow-sm cursor-pointer z-30 transition-all duration-200 hover:bg-stone-100 hover:shadow-md hover:border-stone-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 md:hidden"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Ouvrir le menu"
      >
        <span class="hamburger relative block w-5 h-0.5 bg-stone-700 rounded-sm transition-all duration-200" aria-hidden="true"></span>
      </button>

      <a href={base} class="brand-mobile inline-flex items-center flex-shrink-0 z-20 md:hidden" aria-label={`Accueil ${settings.name}`}>
        <img
          src={logoSrc}
          alt=""
          width="140"
          height="56"
          class="w-auto object-contain"
          style="height: 3.5rem;"
        />
      </a>

      <ul class="nav-side nav-side--left hidden md:flex list-none m-0 p-0" role="menubar">
        {
          leftItems.map((link, index) => (
            <NavItem
              link={link}
              currentPath={currentPath}
              dropdownId={`nav-dropdown-left-${index}`}
              megaMode={!!dropdownItem}
            />
          ))
        }
      </ul>

      <a href={base} class="brand hidden md:inline-flex items-center flex-shrink-0 z-20 group" aria-label={`Accueil ${settings.name}`}>
        <img
          src={logoSrc}
          alt=""
          width="180"
          height="72"
          class="w-auto object-contain transition-all duration-300 group-hover:scale-105"
          style="height: 4rem;"
        />
      </a>

      <ul class="nav-side nav-side--right hidden md:flex list-none m-0 p-0" role="menubar">
        {
          rightItems.map((link, index) => (
            <NavItem
              link={link}
              currentPath={currentPath}
              dropdownId={`nav-dropdown-right-${index}`}
              megaMode={!!dropdownItem}
            />
          ))
        }
      </ul>

      <div id="nav-menu" class="nav-menu--mobile" role="dialog" aria-modal="true" aria-label="Menu principal" hidden>
        <div class="nav-menu__panel">
          <div class="nav-menu__header">
            <span class="nav-menu__title">Menu</span>
            <button type="button" class="nav-menu__close" aria-label="Fermer le menu">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <ul class="nav-menu__list" role="menubar">
            {
              settings.nav.map((link, index) => (
                <NavItem
                  link={link}
                  currentPath={currentPath}
                  dropdownId={`nav-dropdown-mobile-${index}`}
                />
              ))
            }
          </ul>
        </div>
      </div>

      <div class="nav-menu__backdrop" id="nav-menu-backdrop" aria-hidden="true" hidden></div>
    </nav>
  </div>

  {
    dropdownItem && (
      <div class="mega-panel absolute top-full left-0 right-0 bg-white/95 backdrop-blur-sm border-b border-stone-200 shadow-2xl py-8 z-40" id="mega-panel" role="region" aria-label={`Catégories de ${dropdownItem.label}`} hidden>
        <div class="container mega-grid grid grid-cols-2 gap-5 lg:grid-cols-4">
          {dropdownItem.children!.map((child) => {
            const childHref = child.href === '/' ? base : `${base}${child.href.replace(/^\//, '')}`;
            return (
            <a href={childHref} class="group relative block overflow-hidden rounded-2xl border border-stone-200 bg-white transition-all duration-300 hover:shadow-xl hover:-translate-y-1 hover:border-emerald-300">
              {child.image && (
                <div class="relative overflow-hidden h-32">
                  <Image
                    src={child.image}
                    alt=""
                    width={320}
                    height={180}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
                </div>
              )}
              <span class="relative z-10 block px-5 py-4 text-sm font-semibold text-stone-700 group-hover:text-emerald-700">{child.label}</span>
            </a>
          )})}
        </div>
      </div>
    )
  }
</header>

<script>
  (function () {
    const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
    const menu = document.getElementById('nav-menu') as HTMLElement | null;
    const backdrop = document.getElementById('nav-menu-backdrop') as HTMLElement | null;
    const closeBtn = menu?.querySelector('.nav-menu__close') as HTMLButtonElement | null;

    function openMenu() {
      if (!toggle || !menu) return;
      menu.hidden = false;
      backdrop && (backdrop.hidden = false);
      // Force reflow so the transition runs from the hidden state
      void menu.offsetHeight;
      backdrop && void backdrop.offsetHeight;
      menu.classList.add('is-open');
      backdrop?.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Fermer le menu');
      document.body.classList.add('mobile-menu-open');
      closeBtn?.focus();
    }

    function closeMenu() {
      if (!toggle || !menu) return;
      menu.classList.remove('is-open');
      backdrop?.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Ouvrir le menu');
      document.body.classList.remove('mobile-menu-open');
      setTimeout(() => {
        if (!menu.classList.contains('is-open')) {
          menu.hidden = true;
          backdrop && (backdrop.hidden = true);
        }
      }, 300);
      toggle.focus();
    }

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        expanded ? closeMenu() : openMenu();
      });

      closeBtn?.addEventListener('click', closeMenu);
      backdrop?.addEventListener('click', closeMenu);

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeMenu();
        });
      });
    }

    // --- Mega panel (desktop) ---
    const megaPanel = document.getElementById('mega-panel');
    const hasDropdownItem = document.querySelector<HTMLElement>('.nav-side [data-has-children="true"]');

    function openMega() {
      if (megaPanel) megaPanel.hidden = false;
      hasDropdownItem?.classList.add('is-active');
    }
    function closeMega() {
      if (megaPanel) megaPanel.hidden = true;
      hasDropdownItem?.classList.remove('is-active');
    }

    if (megaPanel && hasDropdownItem) {
      hasDropdownItem.addEventListener('mouseenter', openMega);
      hasDropdownItem.addEventListener('mouseleave', () => {
        setTimeout(() => {
          if (!megaPanel.matches(':hover') && !hasDropdownItem.matches(':hover')) closeMega();
        }, 150);
      });
      megaPanel.addEventListener('mouseleave', closeMega);
      megaPanel.addEventListener('mouseenter', openMega);

      hasDropdownItem.addEventListener('focusin', openMega);
      hasDropdownItem.addEventListener('focusout', () => {
        setTimeout(() => {
          if (!hasDropdownItem.contains(document.activeElement) && !megaPanel.contains(document.activeElement)) {
            closeMega();
          }
        }, 50);
      });

      const ddToggle = hasDropdownItem.querySelector<HTMLButtonElement>('.dropdown-toggle');
      if (ddToggle) {
        ddToggle.addEventListener('click', (event) => {
          event.stopPropagation();
          if (megaPanel.hidden) openMega(); else closeMega();
        });
      }

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (!target.closest('.has-dropdown') && !target.closest('.mega-panel') && !target.closest('[data-has-children="true"]')) {
          closeMega();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMega();
          if (menu?.classList.contains('is-open')) {
            closeMenu();
          }
        }
      });
    }

    // --- Mobile dropdowns (inline) ---
    const dropdownToggles = document.querySelectorAll<HTMLButtonElement>('.nav-menu--mobile .dropdown-toggle');

    function closeAllMobileDropdowns() {
      dropdownToggles.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        const id = btn.getAttribute('aria-controls');
        if (id) {
          document.getElementById(id)?.classList.remove('is-open');
        }
      });
    }

    dropdownToggles.forEach((btn) => {
      const id = btn.getAttribute('aria-controls');
      const dropdown = id ? document.getElementById(id) : null;
      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        if (expanded) {
          btn.setAttribute('aria-expanded', 'false');
          dropdown?.classList.remove('is-open');
        } else {
          closeAllMobileDropdowns();
          btn.setAttribute('aria-expanded', 'true');
          dropdown?.classList.add('is-open');
        }
      });
    });
  })();
</script>

<style>
  /* Hamburger lines */
  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    display: block;
    width: 1.25rem;
    height: 2px;
    background-color: #1f2937;
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
  }

  .hamburger::before {
    top: -6px;
  }

  .hamburger::after {
    top: 6px;
  }

  /* Hamburger -> X animation */
  .nav-toggle[aria-expanded='true'] .hamburger {
    background-color: transparent;
  }

  .nav-toggle[aria-expanded='true'] .hamburger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .hamburger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Backdrop behind mobile menu */
  .nav-menu__backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(21, 35, 43, 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms ease, visibility 300ms ease;
    z-index: 40;
  }

  .nav-menu__backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Mobile menu container */
  .nav-menu--mobile {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
  }

  .nav-menu--mobile[hidden] {
    display: none;
  }

  .nav-menu--mobile:not([hidden]) {
    display: flex;
  }

  .nav-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: linear-gradient(180deg, var(--color-secondary) 0%, var(--color-secondary-dark) 100%);
    color: var(--color-warm-white);
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    transform: translateX(100%);
    opacity: 0;
    transition: transform 300ms ease, opacity 300ms ease;
    overflow-y: auto;
  }
    display: flex;
    justify-content: flex-end;
    z-index: 50;
    pointer-events: none;
  }

  .nav-menu--mobile[hidden] {
    display: none;
  }

  .nav-menu--mobile:not([hidden]) {
    display: flex;
  }

  .nav-menu__panel {
    width: min(100%, 20rem);
    height: 100%;
    background: linear-gradient(180deg, var(--color-secondary) 0%, var(--color-secondary-dark) 100%);
    color: var(--color-warm-white);
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    transform: translateX(100%);
    opacity: 0;
    transition: transform 300ms ease, opacity 300ms ease;
    pointer-events: auto;
    overflow-y: auto;
  }

  .nav-menu--mobile.is-open .nav-menu__panel {
    transform: translateX(0);
    opacity: 1;
  }

  .nav-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .nav-menu__title {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .nav-menu__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-warm-white);
    border: none;
    cursor: pointer;
    transition: background-color 200ms ease;
  }

  .nav-menu__close:hover,
  .nav-menu__close:focus {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .nav-menu__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu__list .nav-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }

  .nav-menu__list .nav-link {
    display: block;
    flex: 1 1 auto;
    padding: 0.75rem 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-warm-white);
    background-color: transparent;
    border-radius: 0;
  }

  .nav-menu__list .nav-link:hover,
  .nav-menu__list .nav-link:focus {
    color: var(--color-sand);
    background-color: rgba(255, 255, 255, 0.05);
  }

  .nav-menu__list .nav-link[aria-current='page'] {
    color: var(--color-primary-light);
  }

  .nav-menu__list .dropdown-toggle {
    color: var(--color-warm-white);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
  }

  .nav-menu__list .dropdown-toggle:hover,
  .nav-menu__list .dropdown-toggle:focus {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-sand);
  }

  .nav-menu__list .dropdown-menu {
    flex: 1 1 100%;
    width: 100%;
    display: none;
    margin: 0.25rem 0 0.75rem;
    padding: 0.5rem;
    list-style: none;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 0.5rem;
  }

  .nav-menu__list .dropdown-menu.is-open {
    display: block;
  }

  .nav-menu__list .dropdown-link {
    display: block;
    padding: 0.5rem;
    color: var(--color-warm-white);
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .nav-menu__list .dropdown-link:hover,
  .nav-menu__list .dropdown-link:focus {
    background-color: rgba(255, 255, 255, 0.12);
    color: var(--color-sand);
  }

  .nav-menu__list :global(.dropdown-link img) {
    display: none;
  }

  /* Chevron rotation when open */
  .dropdown-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* Mega trigger rotation */
  .mega-trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* Desktop 3-column layout */
  @media (min-width: 768px) {
    .main-nav {
      justify-content: space-between;
      gap: 1.5rem;
    }

    .nav-side {
      flex: 1 1 0;
      min-width: 0;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-side--left {
      justify-content: flex-end;
    }

    .nav-side--right {
      justify-content: flex-start;
    }

    .nav-menu--mobile,
    .nav-menu__backdrop {
      display: none !important;
    }

    /* Highlight the Réalisations item when mega panel is open */
    .nav-side [data-has-children="true"].is-active .nav-link {
      color: #047857;
      background-color: #ecfdf5;
    }
  }
</style>
