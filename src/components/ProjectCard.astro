---
import { Image } from 'astro:assets';
import type { Project } from '../data/types';
import { projectCategories } from '../data/projects';
import ContentBadge from './ContentBadge.astro';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const categoryLabel =
  projectCategories.find((c) => c.id === project.category)?.label ?? project.category;
---

<article class="card project-card" data-category={project.category}>
  <div class="card-media">
    <Image
      src={project.image}
      alt={`Aperçu de la réalisation ${project.title}`}
      widths={[400, 800]}
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
    />
  </div>
  <div class="card-body">
    <span class="project-category">{categoryLabel}</span>
    <h3 class="card-title">{project.title}</h3>
    <p class="card-text">{project.summary}</p>
    <div class="project-footer">
      <ContentBadge />
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-category {
    display: inline-block;
    width: fit-content;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-secondary);
    background-color: var(--color-secondary-light);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .project-footer {
    margin-top: auto;
    padding-top: var(--space-4);
  }
</style>
