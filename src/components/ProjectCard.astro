---
import { Image } from 'astro:assets';
import type { Project } from '../data/types';
import { projectCategories } from '../data/projects';
import ContentBadge from './ContentBadge.astro';

export interface Props {
  project: Project;
  secondaryImage?: Project['image'];
  categoryLabel?: string;
}

const { project, secondaryImage, categoryLabel: customCategoryLabel } = Astro.props;
const categoryLabel = customCategoryLabel ??
  projectCategories.find((c) => c.id === project.category)?.label ?? project.category;
---

<article class="card project-card" data-category={project.category}>
  <div class:list={['card-media', { 'card-media--mockup': secondaryImage }] }>
    <Image
      src={project.image}
      alt={`Aperçu de la réalisation ${project.title}`}
      widths={[400, 800]}
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
    />
    {secondaryImage && (
      <div class="mockup-thumbnail">
        <Image
          src={secondaryImage}
          alt={`Vue de face de ${project.title}`}
          width={180}
          height={180}
          loading="lazy"
        />
      </div>
    )}
  </div>
  <div class="card-body">
    <span class="project-category">{categoryLabel}</span>
    <h3 class="card-title">{project.title}</h3>
    <p class="card-text">{project.summary}</p>
    <div class="project-footer">
      <ContentBadge />
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-media--mockup {
    position: relative;
  }

  .mockup-thumbnail {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 30%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 3px solid var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .mockup-thumbnail :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-category {
    display: inline-block;
    width: fit-content;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-secondary);
    background-color: var(--color-secondary-light);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .project-footer {
    margin-top: auto;
    padding-top: var(--space-4);
  }
</style>
