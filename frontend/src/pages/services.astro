---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import SigHero from '../components/SigHero.astro';
import { sigHeroImgs } from '../data/signature';
import { getSite } from '../lib/site.js';
import { getProjects } from '../lib/api.js';

const { settings } = await getSite();
const projects = await getProjects();
const images = sigHeroImgs(projects);
const base = import.meta.env.BASE_URL;
---

<MainLayout
  title={`Nos services — ${settings.name}`}
  description={settings.description}
  canonicalPath="/services/"
>
  <div class="signature-home">
    <SigHero images={images} />

    <section class="container" style="padding-block: 2.5rem 4rem; text-align: center;">
      <a href={`${base}contact/`} class="sig-btn sig-btn--primary">Demander un devis<Icon name="move-right" size={16} class="cta-arrow" /></a>
    </section>
  </div>
</MainLayout>
