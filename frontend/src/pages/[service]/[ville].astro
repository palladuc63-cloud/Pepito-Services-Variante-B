---
import MainLayout from '../../layouts/MainLayout.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import CityMap from '../../components/CityMap.astro';
import { getCityPage, getCityPages, getContent, getProjects } from '../../lib/api.js';
import type { CityPage, Project, Service } from '../../data/types';

const { service = '', ville = '' } = Astro.params;
const preview = Astro.url.searchParams.get('preview') === '1';
const headers = preview ? { cookie: Astro.request.headers.get('cookie') ?? '' } : undefined;
const page = await getCityPage(service, ville, { preview, headers });
if (!page) {
  return new Response(null, { status: 404, statusText: 'Page introuvable' });
}

const [{ services }, allCityPages, projects] = await Promise.all([
  getContent(), getCityPages(), getProjects(),
]);

// ── Maillage interne ────────────────────────────────────────
const slugify = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

// Réalisations dans la même ville
const localProjects = (projects as Project[]).filter(
  (p) => p.city && slugify(p.city) === page.slug,
);

// Carrousel : 1 image aléatoire par catégorie
// (priorité aux chantiers de cette ville, sinon n'importe quel chantier)
const byCat = new Map<number, { local: Project[]; all: Project[] }>();
for (const p of projects as Project[]) {
  if (!p.category?.id) continue;
  const g = byCat.get(p.category.id) ?? { local: [], all: [] };
  g.all.push(p);
  if (p.city && slugify(p.city) === page.slug) g.local.push(p);
  byCat.set(p.category.id, g);
}
const pickOne = <T,>(arr: T[]) => arr[Math.floor(Math.random() * arr.length)];
const slides = [...byCat.values()]
  .map((g) => {
    const p = pickOne(g.local.length ? g.local : g.all);
    const imgs = (p.images?.length ? p.images : [{ imageUrl: p.imageUrl, alt: p.title }])
      .filter((i) => i.imageUrl);
    const img = imgs.length ? pickOne(imgs) : null;
    return img ? { url: img.imageUrl as string, alt: img.alt ?? p.title } : null;
  })
  .filter((s): s is { url: string; alt: string } => s !== null);

// Pages villes proches (haversine), max 5
const haversine = (a1: number, o1: number, a2: number, o2: number) => {
  const R = 6371, d = (x: number) => (x * Math.PI) / 180;
  const h = Math.sin(d(a2 - a1) / 2) ** 2 + Math.cos(d(a1)) * Math.cos(d(a2)) * Math.sin(d(o2 - o1) / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(h));
};
const nearby = page.lat != null && page.lng != null
  ? allCityPages
      .filter((c: { id: number; lat: number | null; lng: number | null }) => c.id !== page.id && c.lat != null && c.lng != null)
      .map((c: { id: number; lat: number; lng: number } & Record<string, unknown>) => ({ ...c, d: haversine(page.lat, page.lng, c.lat, c.lng) }))
      .sort((a: { d: number }, b: { d: number }) => a.d - b.d)
      .slice(0, 5)
  : allCityPages.filter((c: { id: number }) => c.id !== page.id).slice(0, 5);
const serviceInfo = (services as Service[]).find((s) => s.slug === service);
const base = import.meta.env.BASE_URL;
const pageImage = page.imageUrl
  ? (page.imageUrl.startsWith('http') ? page.imageUrl : `https://www.pepito-services.fr${page.imageUrl}`)
  : undefined;
---

<MainLayout
  title={page.title}
  description={page.content?.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160)}
  image={pageImage}
  canonicalPath={`/${page.serviceSlug}/${page.slug}/`}
  seoMeta={page.seoMeta}
  noIndex={preview}
>
  {preview && (
    <div class="preview-banner">👁 Prévisualisation — ce brouillon n'est pas publié.</div>
  )}
  <article class="section city-page">
    <div class:list={['container article-container', { 'with-carousel': slides.length > 0 }]}>
      <header class="page-header">
        {serviceInfo && <span class="tag">{serviceInfo.title}</span>}
        <h1 class="section-title">{page.title}</h1>
        <p class="city-name">📍 {page.city}</p>
      </header>

      <div class:list={['city-layout', { 'with-carousel': slides.length > 0 }]}>
        {slides.length > 0 && <ImageCarousel images={slides} />}

        <div class="article-content" set:html={page.content ?? ''} />
      </div>

      {localProjects.length > 0 && (
        <section class="local-reals">
          <h2 class="mesh-title">Nos réalisations à {page.city}</h2>
          <div class="mesh-grid">
            {localProjects.map((p: { slug: string; title: string; imageUrl: string | null; category?: { label: string } | null }) => (
              <a href={`${base}realisations/`} class="mesh-card">
                {p.imageUrl && <img src={p.imageUrl} alt={p.title} loading="lazy" />}
                <span class="mesh-card-body">
                  <strong>{p.title}</strong>
                  {p.category?.label && <small>{p.category.label}</small>}
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      {nearby.length > 0 && (
        <section class="nearby">
          <h2 class="mesh-title">Nous intervenons aussi à</h2>
          <ul class="nearby-list">
            {nearby.map((c: { serviceSlug: string; slug: string; city: string }) => (
              <li><a href={`${base}${c.serviceSlug}/${c.slug}/`}>{c.city}</a></li>
            ))}
          </ul>
        </section>
      )}

      {allCityPages.length > 0 && (
        <section class="zone-section">
          <h2 class="section-title">Nos zones d'intervention</h2>
          <p class="section-subtitle">
            Cliquez sur une ville pour découvrir nos réalisations et prestations locales.
          </p>
          <CityMap pages={allCityPages as CityPage[]} />
          <ul class="zone-links">
            {allCityPages.map((c: CityPage) => (
              <li><a href={`${base}${c.serviceSlug}/${c.slug}/`}>{c.city}</a></li>
            ))}
          </ul>
        </section>
      )}

      <footer class="article-footer">
        <p>Vous avez un projet à {page.city} ?</p>
        <a href={`${base}contact/`} class="btn btn-primary">Demander un devis gratuit</a>
      </footer>
    </div>
  </article>
</MainLayout>

<style>
  .preview-banner {
    padding: 10px 16px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: #92400e;
    background: #fef3c7;
    border-bottom: 1px solid #f59e0b;
  }

  .article-container {
    max-width: 70ch;
  }

  .article-container.with-carousel {
    max-width: var(--max-width);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .city-name {
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .city-layout.with-carousel {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-8);
    align-items: start;
    margin-bottom: var(--space-10);
  }

  .city-layout:not(.with-carousel) {
    margin-bottom: var(--space-10);
  }

  @media (max-width: 900px) {
    .city-layout.with-carousel {
      grid-template-columns: 1fr;
    }
  }

  .article-content {
    line-height: var(--leading-relaxed);
  }

  .mesh-title {
    font-size: var(--text-xl, 1.4rem);
    margin-bottom: var(--space-4);
  }

  .mesh-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .mesh-card {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .mesh-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .mesh-card-body {
    display: block;
    padding: var(--space-3);
  }

  .mesh-card-body small {
    display: block;
    color: var(--color-text-muted);
  }

  .nearby {
    margin-bottom: var(--space-10);
  }

  .zone-section {
    margin-bottom: var(--space-10);
  }

  .zone-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
  }

  .zone-links a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: inherit;
  }

  .nearby-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .nearby-list a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: inherit;
  }

  .article-footer {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .article-footer .btn {
    margin-top: var(--space-4);
  }
</style>
