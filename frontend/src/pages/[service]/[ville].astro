---
import MainLayout from '../../layouts/MainLayout.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import CityMap from '../../components/CityMap.astro';
import { getCityPage, getCityPages, getProjects } from '../../lib/api.js';
import { getSite } from '../../lib/site.js';
import type { CityPage, Project } from '../../data/types';

const { service = '', ville = '' } = Astro.params;
const preview = Astro.url.searchParams.get('preview') === '1';
const headers = preview ? { cookie: Astro.request.headers.get('cookie') ?? '' } : undefined;
const page = await getCityPage(service, ville, { preview, headers });
if (!page) {
  return new Response(null, { status: 404, statusText: 'Page introuvable' });
}

const [allCityPages, projects, { settings, services }] = await Promise.all([
  getCityPages(), getProjects(), getSite(),
]);

// ── Maillage interne ────────────────────────────────────────
const slugify = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

// Réalisations dans la même ville
const localProjects = (projects as Project[]).filter(
  (p) => p.city && slugify(p.city) === page.slug,
);

// Carrousel : 1 image aléatoire par catégorie
// (priorité aux chantiers de cette ville, sinon n'importe quel chantier)
const byCat = new Map<number, { local: Project[]; all: Project[] }>();
for (const p of projects as Project[]) {
  if (!p.category?.id) continue;
  const g = byCat.get(p.category.id) ?? { local: [], all: [] };
  g.all.push(p);
  if (p.city && slugify(p.city) === page.slug) g.local.push(p);
  byCat.set(p.category.id, g);
}
const pickOne = <T,>(arr: T[]) => arr[Math.floor(Math.random() * arr.length)];
const catSlides = [...byCat.values()]
  .map((g) => {
    const p = pickOne(g.local.length ? g.local : g.all);
    const imgs = (p.images?.length ? p.images : [{ imageUrl: p.imageUrl, alt: p.title }])
      .filter((i) => i.imageUrl);
    const img = imgs.length ? pickOne(imgs) : null;
    return img ? { url: img.imageUrl as string, alt: img.alt ?? p.title } : null;
  })
  .filter((s): s is { url: string; alt: string } => s !== null);
// Premier slide : photo de la ville (Wikipédia) quand disponible
const slides = page.imageUrl ? [{ url: page.imageUrl, alt: page.city }, ...catSlides] : catSlides;

// Liens villes sous la carte : triés par proximité (haversine)
const haversine = (a1: number, o1: number, a2: number, o2: number) => {
  const R = 6371, d = (x: number) => (x * Math.PI) / 180;
  const h = Math.sin(d(a2 - a1) / 2) ** 2 + Math.cos(d(a1)) * Math.cos(d(a2)) * Math.sin(d(o2 - o1) / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(h));
};
const orderedCityPages = page.lat != null && page.lng != null
  ? [...(allCityPages as CityPage[])]
      .filter((c) => c.id !== page.id && c.lat != null && c.lng != null)
      .sort((a, b) => haversine(page.lat!, page.lng!, a.lat!, a.lng!) - haversine(page.lat!, page.lng!, b.lat!, b.lng!))
  : (allCityPages as CityPage[]).filter((c) => c.id !== page.id);
const base = import.meta.env.BASE_URL;
const pageImage = page.imageUrl
  ? (page.imageUrl.startsWith('http') ? page.imageUrl : `https://www.pepito-services.fr${page.imageUrl}`)
  : undefined;

// ── SEO local : fil d'Ariane + données structurées ──────────
const svc = (services as { slug: string; title: string }[]).find((s) => s.slug === page.serviceSlug);
const siteUrl = settings.siteUrl.replace(/\/$/, '');
const pageUrl = `${siteUrl}/${page.serviceSlug}/${page.slug}/`;
const serviceUrl = `${siteUrl}/#services`;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HomeAndConstructionBusiness',
      '@id': `${siteUrl}/#business`,
      name: settings.name,
      url: siteUrl,
      image: `${siteUrl}/pepito-logo.svg`,
      ...(settings.contact.phone && { telephone: settings.contact.phone }),
      ...(settings.contact.email && { email: settings.contact.email }),
      ...(settings.contact.address && {
        address: { '@type': 'PostalAddress', streetAddress: settings.contact.address, addressCountry: 'FR' },
      }),
      ...(settings.contact.serviceArea && { areaServed: settings.contact.serviceArea }),
    },
    {
      '@type': 'Service',
      name: page.title,
      serviceType: svc?.title ?? page.title,
      provider: { '@id': `${siteUrl}/#business` },
      areaServed: {
        '@type': 'City',
        name: page.city,
        ...(page.lat != null && page.lng != null && {
          geo: { '@type': 'GeoCoordinates', latitude: page.lat, longitude: page.lng },
        }),
      },
      url: pageUrl,
      ...(pageImage && { image: pageImage }),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: svc?.title ?? 'Nos services', item: serviceUrl },
        { '@type': 'ListItem', position: 3, name: page.city, item: pageUrl },
      ],
    },
  ],
}];

// FAQ locale — contenu unique + résultats enrichis (FAQPage)
const svcLower = (svc?.title ?? 'travaux').toLowerCase();
const faq = [
  {
    q: `Faites-vous des devis gratuits à ${page.city} ?`,
    a: `Oui. Chaque projet à ${page.city} commence par une visite technique sur place, gratuite et sans engagement : relevés, conseils sur les matériaux et chiffrage détaillé.`,
  },
  {
    q: `Quels sont vos délais d'intervention à ${page.city} ?`,
    a: `Ils dépendent de la nature et de l'ampleur du chantier. Un calendrier précis vous est communiqué avec votre devis, et nos équipes basées dans le secteur interviennent rapidement à ${page.city} et ses alentours.`,
  },
  {
    q: `Faut-il une autorisation pour des travaux de ${svcLower} à ${page.city} ?`,
    a: `Cela dépend du projet et du PLU de votre commune. Lors de la visite technique, nous vous indiquons les démarches éventuelles à effectuer auprès de la mairie de ${page.city}.`,
  },
  ...(orderedCityPages.length ? [{
    q: `Dans quelles communes proches de ${page.city} intervenez-vous ?`,
    a: `Nous intervenons dans tout le secteur : ${orderedCityPages.slice(0, 6).map((c) => c.city).join(', ')}, ainsi que dans les communes voisines.`,
  }] : []),
];
jsonLd[0]['@graph'].push({
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<MainLayout
  title={page.title}
  description={page.content?.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160)}
  image={pageImage}
  canonicalPath={`/${page.serviceSlug}/${page.slug}/`}
  seoMeta={page.seoMeta}
  noIndex={preview}
  jsonLd={jsonLd}
>
  {preview && (
    <div class="preview-banner">👁 Prévisualisation — ce brouillon n'est pas publié.</div>
  )}
  <article class="section city-page">
    <div class:list={['container article-container', { 'with-carousel': slides.length > 0 }]}>
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href={base}>Accueil</a>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <a href={`${base}#services`}>{svc?.title ?? 'Nos services'}</a>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <span aria-current="page">{page.city}</span>
      </nav>
      <header class="page-header">
        <h1 class="section-title">{page.title}</h1>
      </header>

      <div class:list={['city-layout', { 'with-carousel': slides.length > 0 }]}>
        {slides.length > 0 && <ImageCarousel images={slides} />}

        <div class="article-content" set:html={page.content ?? ''} />
      </div>

      <section class="faq">
        <h2 class="section-title">Questions fréquentes à {page.city}</h2>
        {faq.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>

      {localProjects.length > 0 && (
        <section class="local-reals">
          <h2 class="mesh-title">Nos réalisations à {page.city}</h2>
          <div class="mesh-grid">
            {localProjects.map((p: { slug: string; title: string; imageUrl: string | null; category?: { label: string } | null }) => (
              <a href={`${base}realisations/`} class="mesh-card">
                {p.imageUrl && <img src={p.imageUrl} alt={p.title} loading="lazy" />}
                <span class="mesh-card-body">
                  <strong>{p.title}</strong>
                  {p.category?.label && <small>{p.category.label}</small>}
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      {orderedCityPages.length > 0 && (
        <section class="zone-section">
          <h2 class="section-title">Nos zones d'intervention</h2>
          <p class="section-subtitle">
            Cliquez sur une ville pour découvrir nos réalisations et prestations locales.
          </p>
          <CityMap pages={allCityPages as CityPage[]} />
          <ul class="zone-links">
            {orderedCityPages.map((c) => (
              <li><a href={`${base}${c.serviceSlug}/${c.slug}/`}>{c.city}</a></li>
            ))}
          </ul>
        </section>
      )}

      <footer class="article-footer">
        <p>Vous avez un projet à {page.city} ?</p>
        <a href={`${base}contact/`} class="btn btn-primary">Demander un devis gratuit</a>
      </footer>
    </div>
  </article>
</MainLayout>

<style>
  .preview-banner {
    padding: 10px 16px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: #92400e;
    background: #fef3c7;
    border-bottom: 1px solid #f59e0b;
  }

  .article-container {
    max-width: 70ch;
  }

  .article-container.with-carousel {
    max-width: var(--max-width);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm, 0.9rem);
    margin-bottom: var(--space-4);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: var(--color-text-muted);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .city-layout.with-carousel {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-8);
    align-items: start;
    margin-bottom: var(--space-10);
  }

  .city-layout:not(.with-carousel) {
    margin-bottom: var(--space-10);
  }

  @media (max-width: 900px) {
    .city-layout.with-carousel {
      grid-template-columns: 1fr;
    }
  }

  .article-content {
    line-height: var(--leading-relaxed);
  }

  .mesh-title {
    font-size: var(--text-xl, 1.4rem);
    margin-bottom: var(--space-4);
  }

  .mesh-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .mesh-card {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .mesh-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .mesh-card-body {
    display: block;
    padding: var(--space-3);
  }

  .mesh-card-body small {
    display: block;
    color: var(--color-text-muted);
  }

  .faq {
    margin-bottom: var(--space-10);
  }

  .faq .section-title {
    font-size: var(--text-xl, 1.4rem);
    margin-bottom: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
  }

  .faq-item p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .zone-section {
    margin-bottom: var(--space-10);
  }

  .zone-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
  }

  .zone-links a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: inherit;
  }

  .article-footer {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .article-footer .btn {
    margin-top: var(--space-4);
  }
</style>
