---
import '../../styles/admin.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Back-office — Pépito Services</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body class="admin">
    <div class="admin-shell">
      <aside class="admin-side">
        <a href={base} target="_blank" rel="noopener" title="Voir le site" class="admin-logo-link">
          <img class="admin-logo" src={`${base}pepito-logo-white.svg`} alt="Pépito Services — clôtures et portails" width="553" height="256" />
        </a>
        <button class="admin-nav-link active" data-tab="overview">📊 Vue d'ensemble</button>
        <button class="admin-nav-link" data-tab="messages">📩 Messages</button>
        <button class="admin-nav-link" data-tab="projects">🚧 Réalisations</button>
        <button class="admin-nav-link" data-tab="citypages">📍 Pages villes</button>
        <button class="admin-nav-link" data-tab="articles">📰 Articles</button>
        <button class="admin-nav-link" data-tab="services">🛠️ Services</button>
        <button class="admin-nav-link" data-tab="categories">🗂️ Catégories</button>
        <button class="admin-nav-link" data-tab="social">📣 Réseaux</button>
        <button class="admin-nav-link" data-tab="seo">🔗 SEO / Redirections</button>
        <button class="admin-nav-link" data-tab="settings">⚙️ Paramètres</button>
        <button class="admin-nav-link" id="btn-logout">🚪 Déconnexion</button>
        <button id="nav-burger" aria-label="Ouvrir le menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </aside>

      <main class="admin-main">
        <div class="admin-top">
          <div>
            <h1 id="page-title">Vue d'ensemble</h1>
            <p id="page-sub">L'essentiel du site en un coup d'œil</p>
          </div>
        </div>

        <p id="global-alert" class="alert" style="display:none"></p>
        <div id="guardrails"></div>

        <!-- VUE D'ENSEMBLE -->
        <section id="tab-overview">
          <div id="overview-stats" class="stat-grid"></div>
          <div class="card" style="margin-bottom:16px">
            <h2 style="margin:0 0 12px">📩 Derniers messages</h2>
            <div id="overview-messages"></div>
          </div>
          <div class="card" style="margin-bottom:16px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
              <h2 style="margin:0">📈 Statistiques de visite</h2>
              <div style="display:flex;gap:6px">
                <select id="analytics-days" class="input" style="padding:4px 8px;width:auto">
                  <option value="7">7 jours</option>
                  <option value="30" selected>30 jours</option>
                  <option value="90">90 jours</option>
                </select>
                <a id="umami-link" class="btn btn-sm" href="#" target="_blank" rel="noopener" hidden>Umami ↗</a>
              </div>
            </div>
            <div id="analytics-stats" class="stat-grid" style="margin-bottom:12px"></div>
            <div class="grid-2">
              <div id="analytics-pages"></div>
              <div id="analytics-refs"></div>
            </div>
          </div>
          <div class="card" style="margin-top:16px">
            <div class="cal-header">
              <button class="btn btn-sm" id="cal-prev">‹ Préc.</button>
              <h2 id="cal-title" style="margin:0;flex:1;text-align:center"></h2>
              <button class="btn btn-sm" id="cal-next">Suiv. ›</button>
            </div>
            <div id="calendar-alerts"></div>
            <div id="calendar-grid" class="cal-grid"></div>
            <div class="cal-legend">
              <span><i class="dot" style="background:#4ade80"></i>Réalisation</span>
              <span><i class="dot" style="background:#93c5fd"></i>Article</span>
              <span><i class="dot" style="background:#fbbf24"></i>Page ville</span>
              <span><i class="dot dot-sched"></i>Programmé</span>
            </div>
          </div>
        </section>

        <!-- RÉALISATIONS -->
        <section id="tab-projects" hidden>
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <h2 style="margin:0">Réalisations</h2>
              <div style="display:flex;gap:8px;align-items:center">
                <div class="view-toggle" data-view-for="projects">
                  <button type="button" data-v="list" title="Affichage liste">☰</button>
                  <button type="button" data-v="cards" title="Affichage cards">▦</button>
                </div>
                <button class="btn btn-primary btn-sm" id="btn-new-project">+ Nouvelle réalisation</button>
              </div>
            </div>
            <div id="projects-table">
              <table class="admin-table">
                <thead><tr><th></th><th>Titre</th><th>Catégorie</th><th>Statut</th><th></th></tr></thead>
                <tbody id="projects-body"></tbody>
              </table>
            </div>
            <div id="projects-cards" class="item-cards" hidden></div>
          </div>
        </section>

        <!-- ARTICLES -->
        <section id="tab-articles" hidden>
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <h2 style="margin:0">Articles</h2>
              <div style="display:flex;gap:8px;align-items:center">
                <div class="view-toggle" data-view-for="articles">
                  <button type="button" data-v="list" title="Affichage liste">☰</button>
                  <button type="button" data-v="cards" title="Affichage cards">▦</button>
                </div>
                <button class="btn btn-primary btn-sm" id="btn-new-article">+ Nouvel article</button>
              </div>
            </div>
            <div id="articles-table">
              <table class="admin-table">
                <thead><tr><th></th><th>Titre</th><th>Publié le</th><th>Statut</th><th></th></tr></thead>
                <tbody id="articles-body"></tbody>
              </table>
            </div>
            <div id="articles-cards" class="item-cards" hidden></div>
          </div>
        </section>

        <!-- SERVICES -->
        <section id="tab-services" hidden>
          <div class="card">
            <h2>Services affichés sur la homepage</h2>
            <table class="admin-table">
              <thead><tr><th></th><th>Titre</th><th>Ordre</th><th>Actif</th><th></th></tr></thead>
              <tbody id="services-body"></tbody>
            </table>
          </div>
        </section>

        <!-- CATÉGORIES -->
        <section id="tab-categories" hidden>
          <div class="card">
            <h2>Catégories de réalisations</h2>
            <table class="admin-table">
              <thead><tr><th>Slug</th><th>Label</th><th>Ordre</th><th>Active</th><th></th></tr></thead>
              <tbody id="categories-body"></tbody>
            </table>
            <form id="category-form" class="form-row cols-3" style="margin-top:16px;align-items:end">
              <div><label class="form-label">Nouveau label</label><input class="form-input" id="cat-label" required /></div>
              <div><label class="form-label">Ordre</label><input class="form-input" id="cat-order" type="number" value="0" /></div>
              <button class="btn btn-primary" type="submit">+ Ajouter</button>
            </form>
          </div>
        </section>

        <!-- PAGES VILLES -->
        <section id="tab-citypages" hidden>
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <h2 style="margin:0">Pages villes (SEO local)</h2>
              <div style="display:flex;gap:8px;align-items:center">
                <div class="view-toggle" data-view-for="citypages">
                  <button type="button" data-v="list" title="Affichage liste">☰</button>
                  <button type="button" data-v="cards" title="Affichage cards">▦</button>
                </div>
                <button class="btn btn-sm hide-mobile" id="btn-schedule-city-drafts" title="Mettre en file les brouillons dans l'ordre">📅 Planifier les brouillons</button>
                <button class="btn btn-primary btn-sm" id="btn-new-city">+ Nouvelle page ville</button>
              </div>
            </div>
            <div id="city-map" aria-label="Carte des pages villes"></div>
            <div id="citypages-table">
              <table class="admin-table">
                <thead><tr><th>URL</th><th>Titre</th><th>Statut</th><th></th></tr></thead>
                <tbody id="citypages-body"></tbody>
              </table>
            </div>
            <div id="citypages-cards" class="item-cards" hidden></div>
            <p class="form-hint">Chaque page publiée est servie sur /&lt;service&gt;/&lt;ville&gt;/ — ex. /clotures/saint-etienne/</p>
          </div>
        </section>

        <!-- SEO / REDIRECTIONS -->
        <section id="tab-seo" hidden>
          <div class="card" style="margin-bottom:16px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <h2 style="margin:0">Redirections</h2>
              <button class="btn btn-primary btn-sm" id="btn-new-redirect">+ Nouvelle redirection</button>
            </div>
            <table class="admin-table">
              <thead><tr><th>Ancien chemin</th><th>Nouveau chemin</th><th>Code</th><th></th></tr></thead>
              <tbody id="redirects-body"></tbody>
            </table>
            <p class="form-hint">Chemins relatifs au site, sans le préfixe /test — ex. /ancienne-page/ → /realisations/</p>
          </div>
          <div class="card">
            <h2>Overrides SEO</h2>
            <table class="admin-table">
              <thead><tr><th>Type</th><th>Entité</th><th>Meta title</th><th></th></tr></thead>
              <tbody id="seometa-body"></tbody>
            </table>
            <p class="form-hint">Les champs « SEO » des formulaires (réalisation, article, page ville) créent ces overrides automatiquement.</p>
          </div>
        </section>

        <!-- MESSAGES -->
        <section id="tab-messages" hidden>
          <div class="card"><h2>Messages reçus</h2><div id="messages-list"></div></div>
        </section>

        <!-- RÉSEAUX -->
        <section id="tab-social" hidden>
          <div class="card">
            <h2>Posts Facebook</h2>
            <p id="fb-status" class="alert alert-info" style="display:none"></p>
            <div id="social-list"></div>
          </div>
        </section>

        <!-- PARAMÈTRES -->
        <section id="tab-settings" hidden>
          <div class="card">
            <h2>Coordonnées & contenu du site</h2>
            <form id="settings-form">
              <div class="form-row cols-2">
                <div><label class="form-label">Téléphone</label><input class="form-input" name="phone" /></div>
                <div><label class="form-label">Email</label><input class="form-input" name="email" type="email" /></div>
              </div>
              <div class="form-row cols-2">
                <div><label class="form-label">Adresse</label><input class="form-input" name="address" /></div>
                <div><label class="form-label">Zone d'intervention</label><input class="form-input" name="service_area" /></div>
              </div>
              <div class="form-row">
                <div><label class="form-label">Horaires</label><input class="form-input" name="hours" placeholder="Lun - Ven : 8h - 18h" /></div>
              </div>
              <div class="form-row">
                <div><label class="form-label">Baseline (sous-titre hero)</label><input class="form-input" name="baseline" /></div>
              </div>
              <div class="form-row">
                <div><label class="form-label">Description SEO</label><textarea class="form-textarea" name="description"></textarea></div>
              </div>
              <div class="form-row">
                <div><label class="form-label">Texte « À propos »</label><textarea class="form-textarea" name="about_text"></textarea></div>
              </div>
              <div class="form-row cols-2">
                <div><label class="form-label">URL Facebook</label><input class="form-input" name="facebook_url" /></div>
                <div><label class="form-label">URL Instagram</label><input class="form-input" name="instagram_url" /></div>
              </div>
              <button class="btn btn-primary" type="submit">Enregistrer</button>
            </form>
          </div>
          <div class="card" style="margin-top:16px">
            <h2>📅 Planification automatique</h2>
            <p class="form-hint">
              Les contenus créés sans date rejoignent la file et sont publiés automatiquement
              au prochain créneau, dans l'ordre. Une date saisie manuellement est toujours respectée.
            </p>
            <div id="schedule-rows"></div>
            <button class="btn btn-primary" id="btn-save-schedule" type="button">Enregistrer la planification</button>
          </div>
        </section>
      </main>
    </div>

    <!-- MODAL générique -->
    <div id="modal-backdrop" class="modal-backdrop" style="display:none">
      <div class="modal">
        <h3 id="modal-title"></h3>
        <div id="modal-body"></div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px">
          <button class="btn" id="modal-cancel">Annuler</button>
          <button class="btn btn-primary" id="modal-save">Enregistrer</button>
        </div>
      </div>
    </div>

<script>
  // @ts-nocheck — DOM vanilla, le typage strict ajoute du bruit sans valeur ici.
  import { api, auth, ApiError } from '../../lib/adminApi.js';

  const $ = (s) => document.querySelector(s);
  const siteBase = import.meta.env.BASE_URL;
  // Échappement HTML systématique — les valeurs issues de la DB (dont les
  // messages du formulaire public) ne doivent JAMAIS entrer en innerHTML brut.
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  // datetime-local ↔ ISO (heure locale)
  const dtLocal = (v) => {
    if (!v) return '';
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? '' : new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
  };
  // Badge « ⏰ programmé » si publication dans le futur
  // Pilule de statut à 3 états : Brouillon / ⏰ Programmé / Publié
  const statusBadge = (e) => {
    if (!e.published) return '<span class="tag-pill draft">Brouillon</span>';
    if (e.publishedAt && new Date(e.publishedAt) > new Date()) {
      return `<span class="tag-pill sched" title="En ligne le ${new Date(e.publishedAt).toLocaleString('fr-FR')}">⏰ ${new Date(e.publishedAt).toLocaleDateString('fr-FR')}</span>`;
    }
    return '<span class="tag-pill pub">Publié</span>';
  };
  const alertEl = $('#global-alert');
  const showAlert = (msg, ok = true) => {
    alertEl.textContent = msg;
    alertEl.className = `alert ${ok ? 'alert-ok' : 'alert-err'}`;
    alertEl.style.display = 'block';
    setTimeout(() => { alertEl.style.display = 'none'; }, 4000);
  };

  // ── Auth guard ──
  const loginUrl = `${import.meta.env.BASE_URL}admin/login`;
  try { await auth.me(); } catch { window.location.href = loginUrl; }
  $('#btn-logout').addEventListener('click', async () => {
    await auth.logout().catch(() => {});
    window.location.href = loginUrl;
  });

  // ── Tabs ──
  const titles = {
    projects: ['Réalisations', 'Chantiers publiés sur le site'],
    articles: ['Articles', 'Actualités du blog'],
    services: ['Services', 'Services affichés sur la homepage'],
    categories: ['Catégories', 'Catégories de réalisations'],
    citypages: ['Pages villes', 'Pages SEO local « service + ville »'],
    messages: ['Messages', 'Demandes reçues via le formulaire et Janus'],
    social: ['Réseaux sociaux', 'Posts Facebook générés automatiquement'],
    overview: ["Vue d'ensemble", "L'essentiel du site en un coup d'œil"],
    seo: ['SEO / Redirections', 'Overrides meta et redirections 301/302'],
    settings: ['Paramètres', 'Coordonnées et contenus du site'],
  };
  const loaders = {};

  // Tables : conteneur scrollable (mobile) — préserve l'alignement des colonnes
  document.querySelectorAll('table.admin-table').forEach((t) => {
    const wrap = document.createElement('div');
    wrap.className = 'table-scroll';
    t.replaceWith(wrap);
    wrap.appendChild(t);
  });

  // ── Toggle affichage liste ⇄ cards (préférence par onglet) ──
  const viewKey = (n) => `pepito-view-${n}`;
  const cardShell = (img, inner, actions) => `
    <div class="item-card">
      <div class="item-card-img">${img ? `<img src="${esc(img)}" alt="" loading="lazy" />` : '<span class="item-card-noimg">📷</span>'}</div>
      <div class="item-card-body">${inner}</div>
      <div class="item-card-actions">${actions}</div>
    </div>`;
  function applyView(name) {
    const mode = localStorage.getItem(viewKey(name))
      || (window.matchMedia('(max-width: 800px)').matches ? 'cards' : 'list');
    const table = $(`#${name}-table`), cards = $(`#${name}-cards`);
    if (!table || !cards) return;
    table.hidden = mode === 'cards';
    cards.hidden = mode !== 'cards';
    document.querySelectorAll(`.view-toggle[data-view-for="${name}"] button`)
      .forEach((b) => b.classList.toggle('active', b.dataset.v === mode));
  }
  document.querySelectorAll('.view-toggle button').forEach((b) => b.addEventListener('click', () => {
    const name = b.closest('.view-toggle').dataset.viewFor;
    localStorage.setItem(viewKey(name), b.dataset.v);
    applyView(name);
  }));

  // ══════════ VUE D'ENSEMBLE ══════════
  loaders.overview = async () => {
    const [projects, articles, citypages, messages] = await Promise.all([
      api.get('/api/admin/projects'), api.get('/api/admin/articles'),
      api.get('/api/admin/city-pages'), api.get('/api/admin/messages'),
    ]);
    window._projects = projects;
    window._articles = articles;
    window._citypages = citypages;
    const now = Date.now(), D = 864e5;

    // ── Cartes stats ──
    const stat = (num, label, warn = false) =>
      `<div class="stat-card${warn ? ' warn' : ''}"><strong>${num}</strong><span>${label}</span></div>`;
    const unread = messages.filter((m) => !m.isRead).length;
    const scheduled = [
      ...projects.map((p) => ({ ...p, _type: 'Réalisation', _at: p.publishedAt })),
      ...articles.map((a) => ({ ...a, _type: 'Article', _at: a.publishedAt })),
      ...citypages.map((c) => ({ ...c, _type: 'Page ville', _at: c.publishedAt })),
    ].filter((e) => e._at && new Date(e._at) > now)
      .sort((a, b) => new Date(a._at) - new Date(b._at));
    $('#overview-stats').innerHTML = [
      stat(projects.filter((p) => p.published).length, 'réalisations publiées'),
      stat(articles.filter((a) => a.published).length, 'articles publiés'),
      stat(citypages.filter((c) => c.published).length, 'pages villes publiées'),
      stat(unread, 'messages non lus', unread > 0),
    ].join('');

    // ── Derniers messages ──
    $('#overview-messages').innerHTML = messages.length
      ? `<ul class="ov-list">${messages.slice(0, 5).map((m) => `
          <li>${m.isRead ? '' : '<span class="tag-pill pub">Nouveau</span> '}
            <strong>${esc(m.name)}</strong> — ${esc((m.message ?? '').slice(0, 60))}${(m.message ?? '').length > 60 ? '…' : ''}
            <time>${new Date(m.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}</time></li>`).join('')}</ul>
        <button class="btn btn-sm" data-goto="messages" style="margin-top:8px">Tous les messages →</button>`
      : '<p style="color:var(--muted);margin:0">Aucun message pour l\'instant.</p>';

    document.querySelectorAll('[data-goto]').forEach((b) => b.addEventListener('click', () => {
      document.querySelector(`.admin-nav-link[data-tab="${b.dataset.goto}"]`)?.click();
    }));
    loaders.analytics();
    loaders.calendar();
    checkGuardrails();
  };

  // ── Statistiques Umami ──
  loaders.analytics = async () => {
    const statsEl = $('#analytics-stats');
    const pagesEl = $('#analytics-pages');
    const refsEl = $('#analytics-refs');
    statsEl.innerHTML = '<p style="color:var(--muted);margin:0">Chargement…</p>';
    pagesEl.innerHTML = ''; refsEl.innerHTML = '';
    let a;
    try { a = await api.get(`/api/admin/analytics?days=${$('#analytics-days').value}`); }
    catch { statsEl.innerHTML = '<p style="color:var(--muted);margin:0">Statistiques indisponibles — Umami ne répond pas.</p>'; return; }
    if (!a.configured) {
      statsEl.innerHTML = '<p style="color:var(--muted);margin:0">Statistiques non configurées.</p>';
      return;
    }
    if (a.dashboardUrl) {
      const link = $('#umami-link');
      link.href = a.dashboardUrl;
      link.hidden = false;
    }
    const s = a.stats ?? {};
    const v = (x) => Number(x?.value ?? x ?? 0);
    const delta = (x) => {
      const c = Number(x?.change ?? 0);
      return c ? `<span class="delta ${c > 0 ? 'up' : 'down'}">${c > 0 ? '+' : ''}${c}%</span>` : '';
    };
    statsEl.innerHTML = [
      `<div class="stat-card"><strong>${v(s.visitors)}${delta(s.visitors)}</strong><span>visiteurs</span></div>`,
      `<div class="stat-card"><strong>${v(s.pageviews)}${delta(s.pageviews)}</strong><span>pages vues</span></div>`,
      `<div class="stat-card"><strong>${v(s.visits)}${delta(s.visits)}</strong><span>visites</span></div>`,
      `<div class="stat-card"><strong>${v(s.bounces)}${delta(s.bounces)}</strong><span>rebonds</span></div>`,
    ].join('');
    const list = (rows, empty) => rows?.length
      ? `<ul class="ov-list">${rows.map((r) => `<li>${esc(String(r.x))}<time>${r.y}</time></li>`).join('')}</ul>`
      : `<p style="color:var(--muted);margin:0">${empty}</p>`;
    pagesEl.innerHTML = `<h3 style="margin:0 0 8px;font-size:.9rem">Pages les plus vues</h3>` + list(a.topPages, 'Pas encore de données.');
    refsEl.innerHTML = `<h3 style="margin:0 0 8px;font-size:.9rem">Sources de trafic</h3>` + list(a.referrers, 'Pas encore de données.');
  };
  $('#analytics-days').addEventListener('change', () => loaders.analytics());

  // ── Calendrier des publications ──
  let calCursor = new Date();
  loaders.calendar = async () => {
    const [projects, articles, citypages] = await Promise.all([
      window._projects ? Promise.resolve(window._projects) : api.get('/api/admin/projects'),
      window._articles ? Promise.resolve(window._articles) : api.get('/api/admin/articles'),
      window._citypages ? Promise.resolve(window._citypages) : api.get('/api/admin/city-pages'),
    ]);
    const now = new Date();
    const mk = (arr, type, cls, tab) => arr
      .map((x) => ({
        type, cls, tab, title: x.title ?? x.city,
        at: x.publishedAt ?? x.createdAt,
        future: x.publishedAt && new Date(x.publishedAt) > now,
      }))
      .filter((x) => x.at);
    renderCalendar([
      ...mk(projects, 'Réalisation', 'proj', 'projects'),
      ...mk(articles, 'Article', 'art', 'articles'),
      ...mk(citypages, 'Page ville', 'city', 'citypages'),
    ], now);
  };

  function renderCalendar(items, now) {
    const y = calCursor.getFullYear(), m = calCursor.getMonth();
    $('#cal-title').textContent = calCursor.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
    const key = (d) => `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
    const byDay = {};
    items.forEach((it) => { const k = key(new Date(it.at)); (byDay[k] ??= []).push(it); });
    const offset = (new Date(y, m, 1).getDay() + 6) % 7; // lundi = 0
    const first = new Date(y, m, 1 - offset);
    let html = ['lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.', 'dim.']
      .map((d) => `<div class="cal-dow">${d}</div>`).join('');
    for (let i = 0; i < 42; i++) {
      const d = new Date(first.getFullYear(), first.getMonth(), first.getDate() + i);
      const day = byDay[key(d)] ?? [];
      const extra = day.length - 2;
      html += `<div class="cal-day${d.getMonth() !== m ? ' other' : ''}${key(d) === key(now) ? ' today' : ''}">
        <span class="num">${d.getDate()}</span>
        ${day.slice(0, 2).map((it) => `<span class="cal-pill ${it.cls}${it.future ? ' future' : ''}" data-goto-tab="${it.tab}" title="${esc(it.type)} — ${esc(it.title)}">${esc(it.title)}</span>`).join('')}
        ${extra > 0 ? `<span class="cal-more">+${extra} autre${extra > 1 ? 's' : ''}</span>` : ''}
      </div>`;
      if (i >= 27 && d.getMonth() !== m && (i + 1) % 7 === 0) break;
    }
    $('#calendar-grid').innerHTML = html;

    // Alertes : semaines des 8 prochaines semaines sans aucune publication (passée ou programmée)
    const monday = new Date(now);
    monday.setDate(now.getDate() - ((now.getDay() + 6) % 7));
    monday.setHours(0, 0, 0, 0);
    const alerts = [];
    for (let w = 0; w < 8; w++) {
      const ws = new Date(monday); ws.setDate(monday.getDate() + w * 7);
      const we = new Date(ws); we.setDate(ws.getDate() + 7);
      if (!items.some((it) => { const t = new Date(it.at); return t >= ws && t < we; }))
        alerts.push(`Semaine du ${ws.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })} : aucune publication prévue.`);
    }
    const lastPub = items.filter((it) => new Date(it.at) <= now).sort((a, b) => new Date(b.at) - new Date(a.at))[0];
    if (lastPub && now - new Date(lastPub.at) > 30 * 864e5)
      alerts.unshift('Dernière publication il y a plus de 30 jours — le référencement aime la régularité.');
    $('#calendar-alerts').innerHTML = alerts.length
      ? `<div class="guardrails-box"><ul>${alerts.slice(0, 5).map((a) => `<li>${a}</li>`).join('')}</ul></div>`
      : '';
    document.querySelectorAll('[data-goto-tab]').forEach((p) => p.addEventListener('click', () => {
      document.querySelector(`.admin-nav-link[data-tab="${p.dataset.gotoTab}"]`)?.click();
    }));
  }
  $('#cal-prev').addEventListener('click', () => { calCursor.setMonth(calCursor.getMonth() - 1); loaders.calendar(); });
  $('#cal-next').addEventListener('click', () => { calCursor.setMonth(calCursor.getMonth() + 1); loaders.calendar(); });
  // Menu burger mobile
  const side = document.querySelector('.admin-side');
  const burger = $('#nav-burger');
  burger?.addEventListener('click', () => {
    const open = side.classList.toggle('nav-open');
    document.body.style.overflow = open ? 'hidden' : '';
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
  });
  document.querySelectorAll('.admin-nav-link[data-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      side.classList.remove('nav-open');
      document.body.style.overflow = '';
      burger?.setAttribute('aria-expanded', 'false');
      document.querySelectorAll('.admin-nav-link').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.admin-main section').forEach((s) => { s.hidden = true; });
      $(`#tab-${btn.dataset.tab}`).hidden = false;
      const [t, sub] = titles[btn.dataset.tab];
