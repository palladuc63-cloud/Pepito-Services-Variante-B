  // Carte des pages villes (Leaflet chargé à la demande)
  let cityMap = null, cityMapLayer = null, leafletLoading = null;
  function ensureLeaflet() {
    if (window.L) return Promise.resolve();
    if (!leafletLoading) {
      leafletLoading = new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        s.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
        s.crossOrigin = '';
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    return leafletLoading;
  }
  async function renderCityMap(citypages) {
    const el = document.getElementById('city-map');
    if (!el) return;
    const withCoords = citypages.filter((c) => c.lat && c.lng);
    if (!withCoords.length) { el.style.display = 'none'; return; }
    el.style.display = '';
    await ensureLeaflet();
    if (!cityMap) {
      cityMap = L.map(el, { scrollWheelZoom: false }).setView([45.6, 4.2], 8);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap',
        maxZoom: 18,
      }).addTo(cityMap);
      setTimeout(() => cityMap.invalidateSize(), 100);
    }
    if (cityMapLayer) cityMapLayer.remove();
    cityMapLayer = L.layerGroup().addTo(cityMap);
    const bounds = [];
    withCoords.forEach((c) => {
      const scheduled = c.publishedAt && new Date(c.publishedAt) > new Date();
      const color = scheduled ? '#f59e0b' : c.published ? '#22c55e' : '#9ca3af';
      const status = scheduled ? '⏰ Programmé' : c.published ? 'Publié' : 'Brouillon';
      const marker = L.circleMarker([c.lat, c.lng], {
        radius: 8, color, weight: 2, fillColor: color, fillOpacity: 0.75,
      });
      marker.bindPopup(
        `<strong>${esc(c.title)}</strong><br/>/${esc(c.serviceSlug)}/${esc(c.slug)}/<br/>${status}` +
        `<br/><a href="${siteBase}${c.serviceSlug}/${c.slug}/${c.published ? '' : '?preview=1'}" target="_blank">Voir la page ↗</a>`
      );
      cityMapLayer.addLayer(marker);
      bounds.push([c.lat, c.lng]);
    });
    if (bounds.length) cityMap.fitBounds(bounds, { padding: [40, 40], maxZoom: 11 });
  }

