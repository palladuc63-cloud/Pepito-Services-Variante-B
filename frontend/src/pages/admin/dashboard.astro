  // ── Gardes-fous rythme de publication ──
  // Règles SEO local : max ~2 pages villes/semaine, ~35 villes total,
  // 1-2 publications/mois minimum. Recalculé à chaque chargement d'onglet.
  function checkGuardrails() {
    const el = $('#guardrails');
    if (!el) return;
    const projs = window._projects ?? [];
    const arts = window._articles ?? [];
    const cps = window._citypages ?? [];
    const now = Date.now(), D = 864e5;
    const all = [...projs, ...arts, ...cps];
    const warns = [];

    const lastPub = all
      .filter((e) => e.publishedAt ? new Date(e.publishedAt) <= now : e.published && e.createdAt)
      .map((e) => new Date(e.publishedAt ?? e.createdAt))
      .sort((a, b) => b - a)[0];
    const scheduled = all.filter((e) => e.publishedAt && new Date(e.publishedAt) > now);

    // Trop : villes programmées en rafale
    const byWeek = {};
    cps.filter((c) => c.publishedAt && new Date(c.publishedAt) > now)
      .forEach((c) => { const w = Math.floor(+new Date(c.publishedAt) / (7 * D)); byWeek[w] = (byWeek[w] || 0) + 1; });
    const maxW = Math.max(0, ...Object.values(byWeek));
    if (maxW > 2) warns.push(`${maxW} pages villes programmées la même semaine — maximum conseillé : 2/semaine.`);
    const liveCities = cps.filter((c) => c.published && !(c.publishedAt && new Date(c.publishedAt) > now)).length;
    const schedCities = cps.filter((c) => c.publishedAt && new Date(c.publishedAt) > now).length;
    if (liveCities + schedCities > 35) warns.push(`${liveCities + schedCities} pages villes au total (${liveCities} en ligne, ${schedCities} programmées) — plafond recommandé ~35 (risque « doorway pages »).`);
    const scheduled30 = scheduled.filter((e) => new Date(e.publishedAt) <= now + 30 * D).length;
    if (scheduled30 > 15) warns.push(`${scheduled30} publications sur les 30 prochains jours (>3/semaine) — ralentis le rythme.`);

    // Pas assez : inactivité + file vide
    const nothingScheduled30 = scheduled.every((e) => new Date(e.publishedAt) > now + 30 * D);
    if (lastPub && now - lastPub > 30 * D && (scheduled.length === 0 || nothingScheduled30)) {
      warns.push(`Aucune publication depuis ${Math.floor((now - lastPub) / D)} jours et rien de programmé sous 30 jours — cadence cible : 1-2 réalisations/mois.`);
    } else if (scheduled.length === 0 && lastPub) {
      warns.push(`Aucune publication programmée — pense à planifier les prochaines sorties.`);
    } else if (!lastPub) {
      warns.push(`Aucun contenu publié pour l'instant — commence par une réalisation.`);
    }

    el.innerHTML = warns.length
      ? `<div class="guardrails-box"><strong>📊 Rythme de publication</strong><ul>${warns.map((w) => `<li>${esc(w)}</li>`).join('')}</ul></div>`
      : '';
  }

