---
import '../../styles/admin.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Back-office — Pépito Services</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body class="admin">
    <div class="admin-shell">
      <aside class="admin-side">
        <img class="admin-logo" src={`${base}pepito-logo.svg`} alt="Pépito Services — clôtures et portails" width="553" height="256" />
        <button class="admin-nav-link active" data-tab="projects">🚧 Réalisations</button>
        <button class="admin-nav-link" data-tab="articles">📰 Articles</button>
        <button class="admin-nav-link" data-tab="services">🛠️ Services</button>
        <button class="admin-nav-link" data-tab="categories">🗂️ Catégories</button>
        <button class="admin-nav-link" data-tab="citypages">📍 Pages villes</button>
        <button class="admin-nav-link" data-tab="messages">📩 Messages</button>
        <button class="admin-nav-link" data-tab="social">📣 Réseaux</button>
        <button class="admin-nav-link" data-tab="seo">🔗 SEO / Redirections</button>
        <button class="admin-nav-link" data-tab="settings">⚙️ Paramètres</button>
        <button class="admin-nav-link" id="btn-logout" style="margin-top:auto">🚪 Déconnexion</button>
      </aside>

      <main class="admin-main">
        <div class="admin-top">
          <div>
            <h1 id="page-title">Réalisations</h1>
            <p id="page-sub">Chantiers publiés sur le site</p>
          </div>
          <a href={base} target="_blank" class="btn btn-sm">Voir le site ↗</a>
        </div>

        <p id="global-alert" class="alert" style="display:none"></p>

        <!-- RÉALISATIONS -->
        <section id="tab-projects">
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <h2 style="margin:0">Réalisations</h2>
              <button class="btn btn-primary btn-sm" id="btn-new-project">+ Nouvelle réalisation</button>
            </div>
            <table class="admin-table">
              <thead><tr><th></th><th>Titre</th><th>Catégorie</th><th>Statut</th><th></th></tr></thead>
              <tbody id="projects-body"></tbody>
            </table>
          </div>
        </section>

        <!-- ARTICLES -->
        <section id="tab-articles" hidden>
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <h2 style="margin:0">Articles</h2>
              <button class="btn btn-primary btn-sm" id="btn-new-article">+ Nouvel article</button>
            </div>
            <table class="admin-table">
              <thead><tr><th></th><th>Titre</th><th>Publié le</th><th>Statut</th><th></th></tr></thead>
              <tbody id="articles-body"></tbody>
            </table>
          </div>
        </section>

        <!-- SERVICES -->
        <section id="tab-services" hidden>
          <div class="card">
            <h2>Services affichés sur la homepage</h2>
            <table class="admin-table">
              <thead><tr><th></th><th>Titre</th><th>Ordre</th><th>Actif</th><th></th></tr></thead>
              <tbody id="services-body"></tbody>
            </table>
          </div>
        </section>

        <!-- CATÉGORIES -->
        <section id="tab-categories" hidden>
          <div class="card">
            <h2>Catégories de réalisations</h2>
            <table class="admin-table">
              <thead><tr><th>Slug</th><th>Label</th><th>Ordre</th><th>Active</th><th></th></tr></thead>
              <tbody id="categories-body"></tbody>
            </table>
            <form id="category-form" class="form-row cols-3" style="margin-top:16px;align-items:end">
              <div><label class="form-label">Nouveau label</label><input class="form-input" id="cat-label" required /></div>
              <div><label class="form-label">Ordre</label><input class="form-input" id="cat-order" type="number" value="0" /></div>
              <button class="btn btn-primary" type="submit">+ Ajouter</button>
            </form>
          </div>
        </section>

        <!-- PAGES VILLES -->
        <section id="tab-citypages" hidden>
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <h2 style="margin:0">Pages villes (SEO local)</h2>
              <button class="btn btn-primary btn-sm" id="btn-new-city">+ Nouvelle page ville</button>
            </div>
            <table class="admin-table">
              <thead><tr><th>URL</th><th>Titre</th><th>Statut</th><th></th></tr></thead>
              <tbody id="citypages-body"></tbody>
            </table>
            <p class="form-hint">Chaque page publiée est servie sur /&lt;service&gt;/&lt;ville&gt;/ — ex. /clotures/saint-etienne/</p>
          </div>
        </section>

        <!-- SEO / REDIRECTIONS -->
        <section id="tab-seo" hidden>
          <div class="card" style="margin-bottom:16px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <h2 style="margin:0">Redirections</h2>
              <button class="btn btn-primary btn-sm" id="btn-new-redirect">+ Nouvelle redirection</button>
            </div>
            <table class="admin-table">
              <thead><tr><th>Ancien chemin</th><th>Nouveau chemin</th><th>Code</th><th></th></tr></thead>
              <tbody id="redirects-body"></tbody>
            </table>
            <p class="form-hint">Chemins relatifs au site, sans le préfixe /test — ex. /ancienne-page/ → /realisations/</p>
          </div>
          <div class="card">
            <h2>Overrides SEO</h2>
            <table class="admin-table">
              <thead><tr><th>Type</th><th>Entité</th><th>Meta title</th><th></th></tr></thead>
              <tbody id="seometa-body"></tbody>
            </table>
            <p class="form-hint">Les champs « SEO » des formulaires (réalisation, article, page ville) créent ces overrides automatiquement.</p>
          </div>
        </section>

        <!-- MESSAGES -->
        <section id="tab-messages" hidden>
          <div class="card"><h2>Messages reçus</h2><div id="messages-list"></div></div>
        </section>

        <!-- RÉSEAUX -->
        <section id="tab-social" hidden>
          <div class="card">
            <h2>Posts Facebook</h2>
            <p id="fb-status" class="alert alert-info" style="display:none"></p>
            <div id="social-list"></div>
          </div>
        </section>

        <!-- PARAMÈTRES -->
        <section id="tab-settings" hidden>
          <div class="card">
            <h2>Coordonnées & contenu du site</h2>
            <form id="settings-form">
              <div class="form-row cols-2">
                <div><label class="form-label">Téléphone</label><input class="form-input" name="phone" /></div>
                <div><label class="form-label">Email</label><input class="form-input" name="email" type="email" /></div>
              </div>
              <div class="form-row cols-2">
                <div><label class="form-label">Adresse</label><input class="form-input" name="address" /></div>
                <div><label class="form-label">Zone d'intervention</label><input class="form-input" name="service_area" /></div>
              </div>
              <div class="form-row">
                <div><label class="form-label">Horaires</label><input class="form-input" name="hours" placeholder="Lun - Ven : 8h - 18h" /></div>
              </div>
              <div class="form-row">
                <div><label class="form-label">Baseline (sous-titre hero)</label><input class="form-input" name="baseline" /></div>
              </div>
              <div class="form-row">
                <div><label class="form-label">Description SEO</label><textarea class="form-textarea" name="description"></textarea></div>
              </div>
              <div class="form-row">
                <div><label class="form-label">Texte « À propos »</label><textarea class="form-textarea" name="about_text"></textarea></div>
              </div>
              <div class="form-row cols-2">
                <div><label class="form-label">URL Facebook</label><input class="form-input" name="facebook_url" /></div>
                <div><label class="form-label">URL Instagram</label><input class="form-input" name="instagram_url" /></div>
              </div>
              <button class="btn btn-primary" type="submit">Enregistrer</button>
            </form>
          </div>
        </section>
      </main>
    </div>

    <!-- MODAL générique -->
    <div id="modal-backdrop" class="modal-backdrop" style="display:none">
      <div class="modal">
        <h3 id="modal-title"></h3>
        <div id="modal-body"></div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px">
          <button class="btn" id="modal-cancel">Annuler</button>
          <button class="btn btn-primary" id="modal-save">Enregistrer</button>
        </div>
      </div>
    </div>

<script>
  // @ts-nocheck — DOM vanilla, le typage strict ajoute du bruit sans valeur ici.
  import { api, auth, ApiError } from '../../lib/adminApi.js';

  const $ = (s) => document.querySelector(s);
  const siteBase = import.meta.env.BASE_URL;
  // Échappement HTML systématique — les valeurs issues de la DB (dont les
  // messages du formulaire public) ne doivent JAMAIS entrer en innerHTML brut.
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const alertEl = $('#global-alert');
  const showAlert = (msg, ok = true) => {
    alertEl.textContent = msg;
    alertEl.className = `alert ${ok ? 'alert-ok' : 'alert-err'}`;
    alertEl.style.display = 'block';
    setTimeout(() => { alertEl.style.display = 'none'; }, 4000);
  };

  // ── Auth guard ──
  const loginUrl = `${import.meta.env.BASE_URL}admin/login`;
  try { await auth.me(); } catch { window.location.href = loginUrl; }
  $('#btn-logout').addEventListener('click', async () => {
    await auth.logout().catch(() => {});
    window.location.href = loginUrl;
  });

  // ── Tabs ──
  const titles = {
    projects: ['Réalisations', 'Chantiers publiés sur le site'],
    articles: ['Articles', 'Actualités du blog'],
    services: ['Services', 'Services affichés sur la homepage'],
    categories: ['Catégories', 'Catégories de réalisations'],
    citypages: ['Pages villes', 'Pages SEO local « service + ville »'],
    messages: ['Messages', 'Demandes reçues via le formulaire et Janus'],
    social: ['Réseaux sociaux', 'Posts Facebook générés automatiquement'],
    seo: ['SEO / Redirections', 'Overrides meta et redirections 301/302'],
    settings: ['Paramètres', 'Coordonnées et contenus du site'],
  };
  const loaders = {};
  document.querySelectorAll('.admin-nav-link[data-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.admin-nav-link').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.admin-main section').forEach((s) => { s.hidden = true; });
      $(`#tab-${btn.dataset.tab}`).hidden = false;
      const [t, sub] = titles[btn.dataset.tab];
      $('#page-title').textContent = t;
      $('#page-sub').textContent = sub;
      loaders[btn.dataset.tab]?.();
    });
  });

  // ── Modal générique ──
  const backdrop = $('#modal-backdrop');
  let onSave = null;
  function openModal(title, bodyHtml, save) {
    $('#modal-title').textContent = title;
    $('#modal-body').innerHTML = bodyHtml;
    onSave = save;
    backdrop.style.display = 'flex';
  }
  $('#modal-cancel').addEventListener('click', () => { backdrop.style.display = 'none'; });
  backdrop.addEventListener('click', (e) => { if (e.target === backdrop) backdrop.style.display = 'none'; });
  $('#modal-save').addEventListener('click', async () => { if (onSave) await onSave(); });

  // Upload d'image → renseigne l'input ciblé
  async function bindUpload(inputId) {
    const fileInput = $(`#${inputId}-file`);
    const urlInput = $(`#${inputId}`);
    fileInput?.addEventListener('change', async () => {
      if (!fileInput.files[0]) return;
      const fd = new FormData();
      fd.append('image', fileInput.files[0]);
      try {
        const { url } = await api.post('/api/upload/image', fd);
        urlInput.value = url;
      } catch (err) { showAlert(err.message, false); }
    });
  }

  // ── SEO meta (overrides par entité) ──
  let seoIndex = [];
  async function refreshSeo() { seoIndex = await api.get('/api/admin/seo-meta'); }
  const seoFor = (type, id) => seoIndex.find((m) => m.entityType === type && Number(m.entityId) === Number(id));
  const seoFields = (m, pfx) => `
    <div class="form-row cols-2">
      <div><label class="form-label">Meta title SEO</label><input class="form-input" id="${pfx}-meta-title" value="${esc(m?.metaTitle ?? '')}" /></div>
      <div><label class="form-label">Image OG (URL)</label><input class="form-input" id="${pfx}-og-image" value="${esc(m?.ogImage ?? '')}" /></div>
    </div>
    <div class="form-row"><label class="form-label">Meta description SEO</label><textarea class="form-textarea" id="${pfx}-meta-desc" placeholder="Laisse vide pour la description automatique">${esc(m?.metaDesc ?? '')}</textarea></div>`;
  const readSeoFields = (pfx) => ({
    metaTitle: $(`#${pfx}-meta-title`).value.trim() || null,
    metaDesc: $(`#${pfx}-meta-desc`).value.trim() || null,
    ogImage: $(`#${pfx}-og-image`).value.trim() || null,
  });

  // ══════════ RÉALISATIONS ══════════
  let categories = [];
  loaders.categories = async () => {
    categories = await api.get('/api/admin/categories');
    $('#categories-body').innerHTML = categories.map((c) => `
      <tr>
        <td><code>${esc(c.slug)}</code></td><td>${esc(c.label)}</td><td>${c.sortOrder}</td>
        <td><span class="status-dot ${c.active ? 'on' : 'off'}"></span>${c.active ? 'Oui' : 'Non'}</td>
        <td style="text-align:right;white-space:nowrap">
          <button class="btn btn-sm" data-cat-toggle="${c.id}" data-active="${c.active ? 0 : 1}">${c.active ? 'Désactiver' : 'Activer'}</button>
          <button class="btn btn-sm btn-danger" data-cat-del="${c.id}">✕</button>
        </td>
      </tr>`).join('');
    document.querySelectorAll('[data-cat-toggle]').forEach((b) => b.addEventListener('click', async () => {
      await api.put(`/api/admin/categories/${b.dataset.catToggle}`, { active: b.dataset.active === '1' });
      loaders.categories();
    }));
    document.querySelectorAll('[data-cat-del]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Supprimer cette catégorie ?')) return;
      await api.del(`/api/admin/categories/${b.dataset.catDel}`);
      loaders.categories();
    }));
  };
  $('#category-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    await api.post('/api/admin/categories', { label: $('#cat-label').value, sortOrder: Number($('#cat-order').value) });
    $('#cat-label').value = '';
    loaders.categories();
    showAlert('Catégorie ajoutée.');
  });

  loaders.projects = async () => {
    if (!categories.length) categories = await api.get('/api/admin/categories');
    const [projects] = await Promise.all([api.get('/api/admin/projects'), refreshSeo()]);
    $('#projects-body').innerHTML = projects.map((p) => `
      <tr>
        <td>${p.imageUrl ? `<img src="${esc(p.imageUrl)}" alt="" />` : ''}</td>
        <td><strong>${esc(p.title)}</strong><br/><span style="color:var(--muted);font-size:12px">${esc(p.summary ?? '')}</span></td>
        <td>${esc(p.category?.label ?? '—')}</td>
        <td><span class="tag-pill ${p.published ? 'pub' : 'draft'}">${p.published ? 'Publié' : 'Brouillon'}</span></td>
        <td style="text-align:right;white-space:nowrap">
          <a class="btn btn-sm" href="${siteBase}realisations/?preview=1" target="_blank">Voir</a>
          <button class="btn btn-sm" data-proj-edit="${p.id}">Éditer</button>
          <button class="btn btn-sm btn-danger" data-proj-del="${p.id}">✕</button>
        </td>
      </tr>`).join('');
    window._projects = projects;
    document.querySelectorAll('[data-proj-edit]').forEach((b) => b.addEventListener('click', () => editProject(b.dataset.projEdit)));
    document.querySelectorAll('[data-proj-del]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Supprimer cette réalisation ?')) return;
      await api.del(`/api/admin/projects/${b.dataset.projDel}`);
      loaders.projects();
    }));
  };

  function projectForm(p = {}, meta = {}) {
    return `
      <div class="form-row"><label class="form-label">Titre *</label><input class="form-input" id="p-title" value="${esc(p.title ?? '')}" /></div>
      <div class="form-row cols-2">
        <div><label class="form-label">Catégorie</label>
          <select class="form-select" id="p-cat">
            <option value="">—</option>
            ${categories.map((c) => `<option value="${c.id}" ${c.id === p.categoryId ? 'selected' : ''}>${esc(c.label)}</option>`).join('')}
          </select></div>
        <div><label class="form-label">Ordre</label><input class="form-input" id="p-order" type="number" value="${p.sortOrder ?? 0}" /></div>
      </div>
      <div class="form-row"><label class="form-label">Résumé</label><input class="form-input" id="p-summary" value="${esc(p.summary ?? '')}" /></div>
      <div class="form-row"><label class="form-label">Ville du chantier</label><input class="form-input" id="p-city" value="${esc(p.city ?? '')}" placeholder="Saint-Étienne" />
        <p class="form-hint">Génère automatiquement un brouillon de page ville (SEO local) à valider dans l'onglet « Pages villes ».</p></div>
      <div class="form-row"><label class="form-label">Description (HTML accepté)</label><textarea class="form-textarea tall" id="p-desc">${esc(p.description ?? '')}</textarea></div>
      <div class="form-row"><label class="form-label">Photos du chantier (la 1re sert de couverture)</label>
        <div id="p-gallery" class="gallery-list"></div>
        <input class="form-input" id="p-gallery-file" type="file" accept="image/*" multiple />
        <p class="form-hint">Sélectionne plusieurs fichiers ou colle des URLs (/uploads/…). Flèches pour réordonner.</p>
      </div>
      <div class="form-row"><label class="form-label">Tags (séparés par des virgules)</label><input class="form-input" id="p-tags" value="${esc((p.tags ?? []).join(', '))}" /></div>
      ${seoFields(meta, 'p')}
      <div class="switch-row"><input type="checkbox" id="p-published" ${p.published !== false ? 'checked' : ''} /><label for="p-published">Publié sur le site</label></div>
      <p class="form-hint">Une publication crée automatiquement un brouillon de post Facebook (onglet Réseaux).</p>`;
  }

  // ── Galerie projet ──
  let galleryUrls = [];
  function renderGallery() {
    $('#p-gallery').innerHTML = galleryUrls.map((u, i) => `
      <div class="gallery-item">
        <img src="${esc(u)}" alt="" />
        <span class="gallery-num">${i === 0 ? 'Couverture' : i + 1}</span>
        <span class="gallery-actions">
          ${i > 0 ? `<button type="button" class="btn btn-sm" data-gup="${i}">←</button>` : ''}
          ${i < galleryUrls.length - 1 ? `<button type="button" class="btn btn-sm" data-gdown="${i}">→</button>` : ''}
          <button type="button" class="btn btn-sm btn-danger" data-gdel="${i}">✕</button>
        </span>
      </div>`).join('');
    document.querySelectorAll('[data-gup]').forEach((b) => b.addEventListener('click', () => {
      const i = Number(b.dataset.gup);
      [galleryUrls[i - 1], galleryUrls[i]] = [galleryUrls[i], galleryUrls[i - 1]];
      renderGallery();
    }));
    document.querySelectorAll('[data-gdown]').forEach((b) => b.addEventListener('click', () => {
      const i = Number(b.dataset.gdown);
      [galleryUrls[i + 1], galleryUrls[i]] = [galleryUrls[i], galleryUrls[i + 1]];
      renderGallery();
    }));
    document.querySelectorAll('[data-gdel]').forEach((b) => b.addEventListener('click', () => {
      galleryUrls.splice(Number(b.dataset.gdel), 1);
      renderGallery();
    }));
  }

  function initGallery(p) {
    const fromDb = Array.isArray(p.images) && p.images.length
      ? p.images.map((i) => i.imageUrl)
      : (p.imageUrl ? [p.imageUrl] : []);
    galleryUrls = fromDb;
    renderGallery();
    const fileInput = $('#p-gallery-file');
    fileInput?.addEventListener('change', async () => {
      for (const file of fileInput.files) {
        const fd = new FormData();
        fd.append('image', file);
        try {
          const { url } = await api.post('/api/upload/image', fd);
          galleryUrls.push(url);
          renderGallery();
        } catch (err) { showAlert(err.message, false); }
      }
      fileInput.value = '';
    });
  }

  async function saveProject(id) {
    const body = {
      title: $('#p-title').value.trim(),
      categoryId: $('#p-cat').value ? Number($('#p-cat').value) : null,
      summary: $('#p-summary').value.trim(),
      description: $('#p-desc').value,
      city: $('#p-city').value.trim() || null,
      images: galleryUrls,
      tags: $('#p-tags').value.split(',').map((t) => t.trim()).filter(Boolean),
      published: $('#p-published').checked,
      sortOrder: Number($('#p-order').value) || 0,
      ...readSeoFields('p'),
    };
    if (!body.title) return showAlert('Titre requis.', false);
    if (id) await api.put(`/api/admin/projects/${id}`, body);
    else await api.post('/api/admin/projects', body);
    backdrop.style.display = 'none';
    showAlert(id ? 'Réalisation mise à jour.' : 'Réalisation créée — brouillon FB généré.');
    loaders.projects();
  }

  function editProject(id) {
    const p = window._projects.find((x) => String(x.id) === String(id));
    openModal('Éditer la réalisation', projectForm(p, seoFor('project', p.id)), () => saveProject(p.id));
    initGallery(p);
  }

  $('#btn-new-project').addEventListener('click', async () => {
    if (!categories.length) categories = await api.get('/api/admin/categories');
    openModal('Nouvelle réalisation', projectForm(), () => saveProject(null));
    initGallery({});
  });

  // ══════════ ARTICLES ══════════
  loaders.articles = async () => {
    const [articles] = await Promise.all([api.get('/api/admin/articles'), refreshSeo()]);
    $('#articles-body').innerHTML = articles.map((a) => `
      <tr>
        <td>${a.imageUrl ? `<img src="${esc(a.imageUrl)}" alt="" />` : ''}</td>
        <td><strong>${esc(a.title)}</strong><br/><span style="color:var(--muted);font-size:12px">/${esc(a.slug)}/</span></td>
        <td>${a.publishedAt ? new Date(a.publishedAt).toLocaleDateString('fr-FR') : '—'}</td>
        <td><span class="tag-pill ${a.published ? 'pub' : 'draft'}">${a.published ? 'Publié' : 'Brouillon'}</span></td>
        <td style="text-align:right;white-space:nowrap">
          <a class="btn btn-sm" href="${siteBase}actualites/${a.slug}/?preview=1" target="_blank">Voir</a>
          <button class="btn btn-sm" data-art-edit="${a.id}">Éditer</button>
          <button class="btn btn-sm btn-danger" data-art-del="${a.id}">✕</button>
        </td>
      </tr>`).join('');
    window._articles = articles;
    document.querySelectorAll('[data-art-edit]').forEach((b) => b.addEventListener('click', () => editArticle(b.dataset.artEdit)));
    document.querySelectorAll('[data-art-del]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Supprimer cet article ?')) return;
      await api.del(`/api/admin/articles/${b.dataset.artDel}`);
      loaders.articles();
    }));
  };

  function articleForm(a = {}, meta = {}) {
    return `
      <div class="form-row"><label class="form-label">Titre *</label><input class="form-input" id="a-title" value="${esc(a.title ?? '')}" /></div>
      <div class="form-row"><label class="form-label">Résumé</label><input class="form-input" id="a-summary" value="${esc(a.summary ?? '')}" /></div>
      <div class="form-row"><label class="form-label">Contenu (HTML accepté)</label><textarea class="form-textarea tall" id="a-content">${esc(a.content ?? '')}</textarea></div>
      <div class="form-row cols-2">
        <div><label class="form-label">Image (URL)</label><input class="form-input" id="a-image" value="${esc(a.imageUrl ?? '')}" /></div>
        <div><label class="form-label">ou upload</label><input class="form-input" id="a-image-file" type="file" accept="image/*" /></div>
      </div>
      ${seoFields(meta, 'a')}
      <div class="switch-row"><input type="checkbox" id="a-published" ${a.published ? 'checked' : ''} /><label for="a-published">Publié</label></div>`;
  }

  async function saveArticle(id) {
    const body = {
      title: $('#a-title').value.trim(),
      summary: $('#a-summary').value.trim(),
      content: $('#a-content').value,
      imageUrl: $('#a-image').value.trim() || null,
      published: $('#a-published').checked,
      ...readSeoFields('a'),
    };
    if (!body.title) return showAlert('Titre requis.', false);
    if (id) await api.put(`/api/admin/articles/${id}`, body);
    else await api.post('/api/admin/articles', body);
    backdrop.style.display = 'none';
    showAlert('Article enregistré.');
    loaders.articles();
  }

  function editArticle(id) {
    const a = window._articles.find((x) => String(x.id) === String(id));
    openModal('Éditer l’article', articleForm(a, seoFor('article', a.id)), () => saveArticle(a.id));
    bindUpload('a-image');
  }

  $('#btn-new-article').addEventListener('click', () => {
    openModal('Nouvel article', articleForm(), () => saveArticle(null));
    bindUpload('a-image');
  });

  // ══════════ SERVICES ══════════
  loaders.services = async () => {
    const services = await api.get('/api/admin/services');
    $('#services-body').innerHTML = services.map((s) => `
      <tr>
        <td>${s.imageUrl ? `<img src="${esc(s.imageUrl)}" alt="" />` : ''}</td>
        <td><strong>${esc(s.title)}</strong><br/><span style="color:var(--muted);font-size:12px">${esc(s.summary ?? '')}</span></td>
        <td>${s.sortOrder}</td>
        <td><span class="status-dot ${s.active ? 'on' : 'off'}"></span>${s.active ? 'Oui' : 'Non'}</td>
        <td style="text-align:right"><button class="btn btn-sm" data-svc-edit="${s.id}">Éditer</button></td>
      </tr>`).join('');
    window._services = services;
    document.querySelectorAll('[data-svc-edit]').forEach((b) => b.addEventListener('click', () => editService(b.dataset.svcEdit)));
  };

  function editService(id) {
    const s = window._services.find((x) => String(x.id) === String(id));
    openModal('Éditer le service', `
      <div class="form-row"><label class="form-label">Titre</label><input class="form-input" id="s-title" value="${esc(s.title)}" /></div>
      <div class="form-row"><label class="form-label">Résumé</label><input class="form-input" id="s-summary" value="${esc(s.summary ?? '')}" /></div>
      <div class="form-row"><label class="form-label">Description</label><textarea class="form-textarea" id="s-desc">${esc(s.description ?? '')}</textarea></div>
      <div class="form-row cols-2">
        <div><label class="form-label">Image (URL)</label><input class="form-input" id="s-image" value="${esc(s.imageUrl ?? '')}" /></div>
        <div><label class="form-label">ou upload</label><input class="form-input" id="s-image-file" type="file" accept="image/*" /></div>
      </div>
      <div class="form-row cols-3">
        <div><label class="form-label">Ordre</label><input class="form-input" id="s-order" type="number" value="${s.sortOrder}" /></div>
        <div class="switch-row" style="align-items:end"><input type="checkbox" id="s-active" ${s.active ? 'checked' : ''} /><label for="s-active">Actif</label></div>
        <div class="switch-row" style="align-items:end"><input type="checkbox" id="s-prov" ${s.provisional ? 'checked' : ''} /><label for="s-prov">Badge « à valider »</label></div>
      </div>`, async () => {
      await api.put(`/api/admin/services/${s.id}`, {
        title: $('#s-title').value.trim(),
        summary: $('#s-summary').value.trim(),
        description: $('#s-desc').value,
        imageUrl: $('#s-image').value.trim() || null,
        sortOrder: Number($('#s-order').value) || 0,
        active: $('#s-active').checked,
        provisional: $('#s-prov').checked,
      });
      backdrop.style.display = 'none';
      showAlert('Service mis à jour.');
      loaders.services();
    });
    bindUpload('s-image');
  }

  // ══════════ PAGES VILLES ══════════
  let servicesList = [];
  loaders.citypages = async () => {
    if (!servicesList.length) servicesList = await api.get('/api/admin/services');
    const [citypages] = await Promise.all([api.get('/api/admin/city-pages'), refreshSeo()]);
    window._citypages = citypages;
    $('#citypages-body').innerHTML = citypages.length ? citypages.map((c) => `
      <tr>
        <td><code>/${esc(c.serviceSlug)}/${esc(c.slug)}/</code>${c.auto ? '<br/><span class="tag-pill">Auto</span>' : ''}</td>
        <td><strong>${esc(c.title)}</strong><br/><span style="color:var(--muted);font-size:12px">${esc(c.city)}</span></td>
        <td><span class="tag-pill ${c.published ? 'pub' : 'draft'}">${c.published ? 'Publié' : 'Brouillon'}</span></td>
        <td style="text-align:right;white-space:nowrap">
          ${!c.published ? `<button class="btn btn-sm btn-primary" data-city-pub="${c.id}">Publier</button>` : ''}
          <a class="btn btn-sm" href="${siteBase}${c.serviceSlug}/${c.slug}/${c.published ? '' : '?preview=1'}" target="_blank">Voir</a>
          <button class="btn btn-sm" data-city-edit="${c.id}">Éditer</button>
          <button class="btn btn-sm btn-danger" data-city-del="${c.id}">✕</button>
        </td>
      </tr>`).join('') : '<tr><td colspan="4" style="color:var(--muted)">Aucune page ville pour l’instant.</td></tr>';
    document.querySelectorAll('[data-city-pub]').forEach((b) => b.addEventListener('click', async () => {
      await api.put(`/api/admin/city-pages/${b.dataset.cityPub}`, { published: true });
      showAlert('Page ville publiée.');
      loaders.citypages();
    }));
    document.querySelectorAll('[data-city-edit]').forEach((b) => b.addEventListener('click', () => editCityPage(b.dataset.cityEdit)));
    document.querySelectorAll('[data-city-del]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Supprimer cette page ville ?')) return;
      await api.del(`/api/admin/city-pages/${b.dataset.cityDel}`);
      loaders.citypages();
    }));
  };

  function cityPageForm(c = {}, meta = {}) {
    return `
      <div class="form-row cols-2">
        <div><label class="form-label">Ville *</label><input class="form-input" id="cp-city" value="${esc(c.city ?? '')}" placeholder="Saint-Étienne" /></div>
        <div><label class="form-label">Service *</label>
          <select class="form-select" id="cp-service">
            ${servicesList.map((s) => `<option value="${esc(s.slug)}" ${s.slug === c.serviceSlug ? 'selected' : ''}>${esc(s.title)}</option>`).join('')}
          </select></div>
      </div>
      <div class="form-row"><label class="form-label">Titre *</label><input class="form-input" id="cp-title" value="${esc(c.title ?? '')}" placeholder="Pose de clôtures à Saint-Étienne" /></div>
      <div class="form-row"><label class="form-label">Contenu (HTML accepté)</label><textarea class="form-textarea tall" id="cp-content">${esc(c.content ?? '')}</textarea></div>
      <div class="form-row cols-2">
        <div><label class="form-label">Image (URL)</label><input class="form-input" id="cp-image" value="${esc(c.imageUrl ?? '')}" /></div>
        <div><label class="form-label">ou upload</label><input class="form-input" id="cp-image-file" type="file" accept="image/*" /></div>
      </div>
      <div class="form-row cols-2">
        <div><label class="form-label">Ordre</label><input class="form-input" id="cp-order" type="number" value="${c.sortOrder ?? 0}" /></div>
        <div class="switch-row" style="align-items:end"><input type="checkbox" id="cp-published" ${c.published ? 'checked' : ''} /><label for="cp-published">Publié</label></div>
      </div>
      ${seoFields(meta, 'cp')}`;
  }

  async function saveCityPage(id) {
    const body = {
      city: $('#cp-city').value.trim(),
      serviceSlug: $('#cp-service').value,
      title: $('#cp-title').value.trim(),
      content: $('#cp-content').value,
      imageUrl: $('#cp-image').value.trim() || null,
      sortOrder: Number($('#cp-order').value) || 0,
      published: $('#cp-published').checked,
      ...readSeoFields('cp'),
    };
    if (!body.city || !body.title) return showAlert('Ville et titre requis.', false);
    try {
      if (id) await api.put(`/api/admin/city-pages/${id}`, body);
      else await api.post('/api/admin/city-pages', body);
    } catch (err) { return showAlert(err.message, false); }
    backdrop.style.display = 'none';
    showAlert('Page ville enregistrée.');
    loaders.citypages();
  }

  function editCityPage(id) {
    const c = window._citypages.find((x) => String(x.id) === String(id));
    openModal('Éditer la page ville', cityPageForm(c, seoFor('city_page', c.id)), () => saveCityPage(c.id));
    bindUpload('cp-image');
  }

  $('#btn-new-city').addEventListener('click', async () => {
    if (!servicesList.length) servicesList = await api.get('/api/admin/services');
    openModal('Nouvelle page ville', cityPageForm(), () => saveCityPage(null));
    bindUpload('cp-image');
  });

  // ══════════ SEO / REDIRECTIONS ══════════
  const entityLabel = (m) => {
    const pools = { project: window._projects, article: window._articles, city_page: window._citypages, service: window._services };
    const row = (pools[m.entityType] ?? []).find((x) => Number(x.id) === Number(m.entityId));
    return row ? (row.title ?? row.label ?? `#${m.entityId}`) : `#${m.entityId}`;
  };

  function redirectForm(r = {}) {
    return `
      <div class="form-row"><label class="form-label">Ancien chemin *</label><input class="form-input" id="r-old" value="${esc(r.oldPath ?? '')}" placeholder="/ancienne-page/" /></div>
      <div class="form-row"><label class="form-label">Nouveau chemin *</label><input class="form-input" id="r-new" value="${esc(r.newPath ?? '')}" placeholder="/realisations/" /></div>
      <div class="form-row"><label class="form-label">Code HTTP</label>
        <select class="form-select" id="r-status">
          <option value="301" ${r.status !== 302 ? 'selected' : ''}>301 — permanent</option>
          <option value="302" ${r.status === 302 ? 'selected' : ''}>302 — temporaire</option>
        </select></div>`;
  }

  async function saveRedirect(id) {
    const body = {
      oldPath: $('#r-old').value.trim(),
      newPath: $('#r-new').value.trim(),
      status: Number($('#r-status').value),
    };
    if (!body.oldPath || !body.newPath) return showAlert('Les deux chemins sont requis.', false);
    try {
      if (id) await api.put(`/api/admin/redirects/${id}`, body);
      else await api.post('/api/admin/redirects', body);
    } catch (err) { return showAlert(err.message, false); }
    backdrop.style.display = 'none';
    showAlert('Redirection enregistrée — active sous ~30 s.');
    loaders.seo();
  }

  loaders.seo = async () => {
    const [redirects] = await Promise.all([api.get('/api/admin/redirects'), refreshSeo()]);
    window._redirects = redirects;
    $('#redirects-body').innerHTML = redirects.length ? redirects.map((r) => `
      <tr>
        <td><code>${esc(r.oldPath)}</code></td>
        <td><code>${esc(r.newPath)}</code></td>
        <td><span class="tag-pill">${r.status}</span></td>
        <td style="text-align:right;white-space:nowrap">
          <button class="btn btn-sm" data-red-edit="${r.id}">Éditer</button>
          <button class="btn btn-sm btn-danger" data-red-del="${r.id}">✕</button>
        </td>
      </tr>`).join('') : '<tr><td colspan="4" style="color:var(--muted)">Aucune redirection.</td></tr>';
    document.querySelectorAll('[data-red-edit]').forEach((b) => b.addEventListener('click', () => {
      const r = window._redirects.find((x) => String(x.id) === b.dataset.redEdit);
      openModal('Éditer la redirection', redirectForm(r), () => saveRedirect(r.id));
    }));
    document.querySelectorAll('[data-red-del]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Supprimer cette redirection ?')) return;
      await api.del(`/api/admin/redirects/${b.dataset.redDel}`);
      loaders.seo();
    }));

    $('#seometa-body').innerHTML = seoIndex.length ? seoIndex.map((m) => `
      <tr>
        <td><span class="tag-pill">${esc(m.entityType)}</span></td>
        <td>${esc(entityLabel(m))}</td>
        <td>${esc(m.metaTitle ?? '—')}</td>
        <td style="text-align:right"><button class="btn btn-sm btn-danger" data-meta-del="${m.id}">✕</button></td>
      </tr>`).join('') : '<tr><td colspan="4" style="color:var(--muted)">Aucun override — les metas sont générées automatiquement.</td></tr>';
    document.querySelectorAll('[data-meta-del]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Supprimer cet override SEO ?')) return;
      await api.del(`/api/admin/seo-meta/${b.dataset.metaDel}`);
      loaders.seo();
    }));
  };

  $('#btn-new-redirect').addEventListener('click', () => {
    openModal('Nouvelle redirection', redirectForm(), () => saveRedirect(null));
  });

  // ══════════ MESSAGES ══════════
  loaders.messages = async () => {
    const messages = await api.get('/api/admin/messages');
    $('#messages-list').innerHTML = messages.length ? messages.map((m) => `
      <div class="card ${m.isRead ? '' : 'msg-unread'}" style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:start;gap:12px">
          <div>
            <strong>${esc(m.name)}</strong>
            <span class="tag-pill">${esc(m.projectType ?? m.source)}</span>
            <div style="font-size:12px;color:var(--muted);margin:4px 0">
              ${esc(m.email ?? '')} ${m.phone ? `· ${esc(m.phone)}` : ''} · ${new Date(m.createdAt).toLocaleString('fr-FR')}
            </div>
            <div class="msg-body">${esc(m.message)}</div>
          </div>
          <div style="white-space:nowrap">
            <button class="btn btn-sm" data-msg-read="${m.id}" data-read="${m.isRead ? 0 : 1}">${m.isRead ? 'Non lu' : 'Marquer lu'}</button>
            <button class="btn btn-sm btn-danger" data-msg-del="${m.id}">✕</button>
          </div>
        </div>
      </div>`).join('') : '<p style="color:var(--muted)">Aucun message.</p>';
    document.querySelectorAll('[data-msg-read]').forEach((b) => b.addEventListener('click', async () => {
      await api.put(`/api/admin/messages/${b.dataset.msgRead}`, { isRead: b.dataset.read === '1' });
      loaders.messages();
    }));
    document.querySelectorAll('[data-msg-del]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Supprimer ce message ?')) return;
      await api.del(`/api/admin/messages/${b.dataset.msgDel}`);
      loaders.messages();
    }));
  };

  // ══════════ RÉSEAUX ══════════
  loaders.social = async () => {
    const { configured, posts } = await api.get('/api/admin/social-posts');
    const st = $('#fb-status');
    st.style.display = 'block';
    st.textContent = configured
      ? '✅ Facebook connecté — les posts peuvent être publiés.'
      : '⚠️ Facebook non connecté — les posts restent en brouillon (tokens à configurer côté serveur).';
    $('#social-list').innerHTML = posts.length ? posts.map((p) => `
      <div class="card" style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:start;gap:12px">
          <div style="flex:1">
            <span class="tag-pill">${p.refType === 'article' ? '📰 Article' : '🚧 Réalisation'}</span>
            <span class="tag-pill ${p.status === 'published' ? 'pub' : p.status === 'failed' ? 'failed' : 'draft'}">${p.status}</span>
            <div class="msg-body" style="margin-top:8px" id="sp-content-${p.id}">${esc(p.content)}</div>
            ${p.error ? `<div style="color:var(--danger);font-size:12px;margin-top:4px">${esc(p.error)}</div>` : ''}
          </div>
          <div style="white-space:nowrap;display:flex;flex-direction:column;gap:6px">
            ${p.status !== 'published' ? `<button class="btn btn-sm btn-primary" data-sp-pub="${p.id}">Publier sur FB</button>` : ''}
            <button class="btn btn-sm btn-danger" data-sp-del="${p.id}">✕</button>
          </div>
        </div>
      </div>`).join('') : '<p style="color:var(--muted)">Aucun post généré pour l’instant — publiez une réalisation ou un article.</p>';
    document.querySelectorAll('[data-sp-pub]').forEach((b) => b.addEventListener('click', async () => {
      try {
        await api.post(`/api/admin/social-posts/${b.dataset.spPub}/publish`, {});
        showAlert('Publié sur Facebook.');
      } catch (err) { showAlert(err.message, false); }
      loaders.social();
    }));
    document.querySelectorAll('[data-sp-del]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Supprimer ce post ?')) return;
      await api.del(`/api/admin/social-posts/${b.dataset.spDel}`);
      loaders.social();
    }));
  };

  // ══════════ PARAMÈTRES ══════════
  loaders.settings = async () => {
    const s = await api.get('/api/admin/settings');
    const form = $('#settings-form');
    for (const [key, value] of Object.entries(s)) {
      const field = form.querySelector(`[name="${key}"]`);
      if (field && value !== null) field.value = value;
    }
  };
  $('#settings-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = Object.fromEntries(new FormData(e.target).entries());
    await api.put('/api/admin/settings', body);
    showAlert('Paramètres enregistrés.');
  });

  // Chargement initial
  loaders.projects();
</script>
  </body>
</html>
