      loaders.social();
    }));
    document.querySelectorAll('[data-sp-edit]').forEach((b) => b.addEventListener('click', () => {
      $(`#sp-content-${b.dataset.spEdit}`).style.display = 'none';
      $(`#sp-edit-${b.dataset.spEdit}`).style.display = 'block';
    }));
    document.querySelectorAll('[data-sp-cancel]').forEach((b) => b.addEventListener('click', () => {
      $(`#sp-edit-${b.dataset.spCancel}`).style.display = 'none';
      $(`#sp-content-${b.dataset.spCancel}`).style.display = 'block';
    }));
    document.querySelectorAll('[data-sp-save]').forEach((b) => b.addEventListener('click', async () => {
      const content = document.querySelector(`#sp-edit-${b.dataset.spSave} .sp-edit-area`).value.trim();
      try {
        await api.put(`/api/admin/social-posts/${b.dataset.spSave}`, { content });
        showAlert('Post mis à jour.');
      } catch (err) { showAlert(err.message, false); }
      loaders.social();
    }));
    document.querySelectorAll('[data-sp-del]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Supprimer ce post ?')) return;
      await api.del(`/api/admin/social-posts/${b.dataset.spDel}`);
      loaders.social();
    }));
  };

  // ══════════ PARAMÈTRES ══════════
  const SCHED_TYPES = [
    ['project', 'Réalisations'],
    ['article', 'Articles'],
    ['city_page', 'Pages villes'],
  ];
  const SCHED_DAYS = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
  const SCHED_DEFAULTS = {
    project: { enabled: true, intervalDays: 30, weekday: 2, hour: 9 },
    article: { enabled: true, intervalDays: 30, weekday: 4, hour: 9 },
    city_page: { enabled: true, intervalDays: 7, weekday: 2, hour: 9 },
  };

  function renderScheduleRows(conf) {
    $('#schedule-rows').innerHTML = SCHED_TYPES.map(([type, label]) => {
      const c = conf[type] ?? SCHED_DEFAULTS[type];
      return `
        <div class="sched-row" data-sched="${type}">
          <label class="switch-row" style="margin:0;min-width:150px">
            <input type="checkbox" data-f="enabled" ${c.enabled ? 'checked' : ''} />
            <strong>${label}</strong>
          </label>
          <span class="muted">tous les</span>
          <input class="form-input sched-num" type="number" min="1" max="90" data-f="intervalDays" value="${c.intervalDays}" />
          <span class="muted">jours, le</span>
          <select class="form-select sched-day" data-f="weekday">
            ${SCHED_DAYS.map((d, i) => `<option value="${i}" ${i === c.weekday ? 'selected' : ''}>${d}</option>`).join('')}
          </select>
          <span class="muted">à</span>
          <input class="form-input sched-num" type="number" min="0" max="23" data-f="hour" value="${c.hour}" />
          <span class="muted">h</span>
        </div>`;
    }).join('');
  }

  loaders.settings = async () => {
    const s = await api.get('/api/admin/settings');
    const form = $('#settings-form');
    for (const [key, value] of Object.entries(s)) {
      const field = form.querySelector(`[name="${key}"]`);
      if (field && value !== null) field.value = value;
    }
    let conf = {};
    try { conf = s.schedule_config ? JSON.parse(s.schedule_config) : {}; } catch {}
    renderScheduleRows(conf);
  };

  $('#btn-save-schedule').addEventListener('click', async () => {
    const conf = {};
    document.querySelectorAll('.sched-row').forEach((row) => {
      const get = (f) => row.querySelector(`[data-f="${f}"]`);
      conf[row.dataset.sched] = {
        enabled: get('enabled').checked,
        intervalDays: Math.max(1, Number(get('intervalDays').value) || 7),
        weekday: Number(get('weekday').value),
        hour: Math.min(23, Math.max(0, Number(get('hour').value) || 9)),
      };
    });
    await api.put('/api/admin/settings', { schedule_config: JSON.stringify(conf) });
    showAlert('Planification enregistrée — elle s’applique aux prochaines créations.');
  });
  $('#settings-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = Object.fromEntries(new FormData(e.target).entries());
    await api.put('/api/admin/settings', body);
    showAlert('Paramètres enregistrés.');
  });

  // Chargement initial — la vue d'ensemble charge tout et nourrit les gardes-fous
  loaders.overview();
</script>
  </body>
</html>
