---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import ArrowDivider from '../components/ArrowDivider.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import logo from '../assets/pepito-logo.svg';
import { signature } from '../data/signature';
import { ICONS } from '../lib/icons';
import GateScene from '../components/GateScene.astro';
import { getSite } from '../lib/site.js';
import { getProjects } from '../lib/api.js';
import type { Project, Service } from '../data/types';

const { settings, services, slides } = await getSite();
const projects = await getProjects();
const previewProjects = projects.slice(0, 3);
const base = import.meta.env.BASE_URL;

// Le contenu « Signature » (hero, activités, arguments, processus) est
// dans src/data/signature.ts — partagé avec la page Nos services.

// Entité locale canonique (@id #business, référencée par les pages villes
// et réalisations). sameAs relie la fiche Google et les réseaux au site —
// Google s'en sert pour associer l'entité web à la fiche Business Profile.
const siteUrl = settings.siteUrl.replace(/\/$/, '');
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${siteUrl}/#business`,
  name: settings.name,
  url: siteUrl,
  image: `${siteUrl}/pepito-logo.svg`,
  ...(settings.contact.phone && { telephone: settings.contact.phone }),
  ...(settings.contact.email && { email: settings.contact.email }),
  ...(settings.contact.address && {
    address: { '@type': 'PostalAddress', streetAddress: settings.contact.address, addressCountry: 'FR' },
  }),
  ...(settings.contact.serviceArea && { areaServed: settings.contact.serviceArea }),
  ...(settings.sameAs?.length && { sameAs: settings.sameAs }),
}];
---

<MainLayout
  title={settings.name}
  description={settings.description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <HeroSlideshow settings={settings} projects={projects} slides={slides} />

  <ArrowDivider
    background="var(--color-surface)"
    prolongement
  />

  {/* GateScroll en pause — remonter ce composant autour de #a-propos pour réactiver le portail au scroll */}
  <Section id="a-propos" class="section-alt">
    <div class="section-header">
      <h2 class="section-title">À propos de Pépito Services</h2>
      <p class="section-subtitle">
        Une entreprise artisanale au service de vos projets extérieurs.
      </p>
    </div>

    <div class="about-content">
      <img
        src={logo.src}
        alt="Pépito Services"
        class="about-logo"
        loading="lazy"
      />
      <div class="prose">
        <p>{settings.aboutText || settings.description}</p>
      </div>
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-surface)"
    background="var(--color-cream)"
  />

  <Section id="services" class="section-cream">
    <div class="section-header">
      <h2 class="section-title">Nos services</h2>
      <p class="section-subtitle">
        Des solutions de clôture, portails et aménagements extérieurs sur
        mesure, à adapter ensemble selon votre terrain et vos envies.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service: Service, i: number) => <ServiceCard service={service} index={i} />)}
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-cream)"
    background="var(--color-surface)"
  />

  <Section id="realisations" class="section-alt">
    <div class="section-header">
      <h2 class="section-title">Quelques réalisations</h2>
      <p class="section-subtitle">
        Découvrez un aperçu de nos chantiers réalisés sur mesure,
        du terrain à la pose.
      </p>
    </div>

    <div class="projects-grid-preview">
      {previewProjects.map((project: Project) => <ProjectCard project={project} />)}
    </div>

    <div class="section-actions">
      <a href={`${base}realisations/`} class="btn btn-secondary">Voir toutes les réalisations</a>
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-surface)"
    background="var(--color-secondary)"
  />

  <Section class="section-cta">
    <div class="cta-box">
      <h2 class="section-title">Un projet en tête ?</h2>
      <p class="cta-text">
        Discutons-en ensemble. Demandez une estimation personnalisée pour votre
        clôture, portail, palissade ou aménagement extérieur.
      </p>
      <a href={`${base}contact/`} class="btn btn-primary">Demander un chiffrage</a>
    </div>
  </Section>

  {/* ── Thème « Signature » : landing produit (visible uniquement sous
      data-theme='signature', masquée via theme-signature.css) ── */}
  <div class="signature-home">
    <GateScene />

    <div class="sig-scrollpath">
      <svg class="sig-scrollpath__svg" aria-hidden="true" preserveAspectRatio="none">
        <defs>
          <clipPath id="sig-fence-clip">
            <rect class="sig-scrollpath__clip" x="0" y="0" width="0" height="0" />
          </clipPath>
        </defs>
        <g class="sig-fence" clip-path="url(#sig-fence-clip)">
          <g class="sig-fence__mesh"></g>
          <line class="sig-fence__rail" />
          <line class="sig-fence__rail" />
        </g>
        <rect class="sig-fence__post" rx="2" />
        <rect class="sig-fence__post" rx="2" />
        <rect class="sig-fence__post" rx="2" />
        <rect class="sig-fence__post" rx="2" />
        <rect class="sig-fence__post" rx="2" />
        <path class="sig-scrollpath__path" />
      </svg>
      <div class="sig-scrollpath__sticky">
        <div class="sig-scrollpath__inner">
          <section class="sig-benefits">
      <div class="container">
        <h2 class="sig-title">{signature.benefitsTitle}</h2>
        <div class="sig-benefits__grid">
          {signature.benefits.map((b) => (
            <div class="sig-benefit">
              <span class="sig-benefit__icon" aria-hidden="true">
                {b.icon === 'shield' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z" />
                    <path d="M9 12l2 2 4-4" />
                  </svg>
                )}
                {b.icon === 'finish' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 20l4-1 11-11a2.1 2.1 0 0 0-3-3L5 16l-1 4z" />
                    <path d="M13.5 6.5l3 3" />
                  </svg>
                )}
                {b.icon === 'clock' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="13" r="8" />
                    <path d="M12 9v4l2.5 2.5" />
                    <path d="M9 2h6" />
                  </svg>
                )}
              </span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sig-process">
      <div class="container">
        <h2 class="sig-title">{signature.processTitle}</h2>
        <ol class="sig-steps">
          {signature.steps.map((s, i) => (
            <li class="sig-step">
              <span class="sig-step__marker" aria-hidden="true">
                <svg
                  class="sig-step__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={ICONS[s.icon] ?? ICONS.check}
                />
                <span class="sig-step__num">{i + 1}</span>
              </span>
              <div class="sig-step__body">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
        </div>
      </div>
    </div>

    <section class="sig-activities container" id="activites">
      <h2 class="sig-title">{signature.activitiesTitle}</h2>
      <ul class="sig-activities__row">
        {signature.activities.map((a) => (
          <li class="sig-activity">
            <img src={a.img.src} alt="" aria-hidden="true" loading="lazy" />
            <span>{a.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="sig-installs container">
      <h2 class="sig-title">{signature.installsTitle}</h2>
      <div class="projects-grid-preview">
        {previewProjects.map((project: Project) => <ProjectCard project={project} />)}
      </div>
      <div class="sig-installs__more">
        <a href={`${base}realisations/`} class="sig-btn sig-btn--primary">Voir toutes les réalisations</a>
      </div>
    </section>
  </div>

  <script>

    // Clôture rigide construite par le scroll : le trait épais descend
    // le bord gauche (il EST le poteau de départ), puis au niveau du
    // ruban deux lisses se déroulent, le grillage soudé apparaît fil à
    // fil et chaque poteau se plante sous son cercle d'étape qui pop.
    // Le clip-path du groupe .sig-fence révèle lisses + grillage au
    // passage du front de construction ; les poteaux basculent en
    // .is-on. Mobile : tracé vertical simple, étapes de haut en bas.
    // Reduced motion : pas de dessin, tout visible normalement.
    const scrollPath = document.querySelector<HTMLElement>('.sig-scrollpath');
    const svgEl = scrollPath?.querySelector<SVGElement>('.sig-scrollpath__svg');
    const pathEl = scrollPath?.querySelector<SVGPathElement>('.sig-scrollpath__path');
    const innerEl = scrollPath?.querySelector<HTMLElement>('.sig-scrollpath__inner');
    const stepsEl = scrollPath?.querySelector<HTMLElement>('.sig-steps');
    const clipEl = svgEl?.querySelector<SVGRectElement>('.sig-scrollpath__clip');
    const fenceEl = svgEl?.querySelector<SVGGElement>('.sig-fence');
    const meshEl = svgEl?.querySelector<SVGGElement>('.sig-fence__mesh');
    const railEls = svgEl
      ? Array.from(svgEl.querySelectorAll<SVGLineElement>('.sig-fence__rail'))
      : [];
    const postEls = svgEl
      ? Array.from(svgEl.querySelectorAll<SVGRectElement>('.sig-fence__post'))
      : [];
    if (scrollPath && svgEl && pathEl && innerEl && stepsEl && clipEl && fenceEl && meshEl) {
      const mqNarrow = window.matchMedia('(max-width: 899px)');
      const mqReducedPath = window.matchMedia('(prefers-reduced-motion: reduce)');
      const markerEl = stepsEl.querySelector<HTMLElement>('.sig-step__marker');
      const stepEls = Array.from(
        stepsEl.querySelectorAll<HTMLElement>('.sig-step')
      );
      const X0 = 8; // bord gauche écran = demi-épaisseur du trait (16px)
      // Phases de la vue épinglée : pan du contenu quasi immédiat et
      // court, puis le ruban horizontal démarre PENDANT que le bloc
      // finit de se caler — pas de temps mort entre le gel et le 1er
      // chevron.
      const HOLD = 0.02;
      const PAN_END = 0.25;
      const H_START = 0.12;
      let dashTotal = 1, downLen = 0, sideLen = 0, endX = 0;
      let panT = 0;

      // Position de mise en page du ruban dans le bloc inner (offsetTop)
      // : constante, insensible au translateY du pan.
      const naturalTop = () => {
        let n = 0;
        let el: HTMLElement | null = stepsEl;
        while (el && el !== innerEl) {
          n += el.offsetTop;
          el = el.offsetParent as HTMLElement | null;
        }
        return n;
      };

      const SVGNS = 'http://www.w3.org/2000/svg';
      let postXs: number[] = [];

      const measurePath = () => {
        const sr = stepsEl.getBoundingClientRect();
        const ir = innerEl.getBoundingClientRect();
        if (mqNarrow.matches) {
          fenceEl.style.display = 'none';
          postEls.forEach((p) => p.setAttribute('display', 'none'));
          downLen = window.innerHeight;
          pathEl.setAttribute('d', `M ${X0} 0 L ${X0} ${downLen.toFixed(1)}`);
          sideLen = 0;
        } else {
          fenceEl.style.display = '';
          postEls.forEach((p) => p.removeAttribute('display'));
          const vh = window.innerHeight;
          const markerH = markerEl?.offsetHeight ?? 58;
          const stepsTop = naturalTop();
          // Pan : remonte le contenu pour placer le haut du ruban à
          // ~62 % de l'écran — le cadre figé montre le tracé complet.
          panT = Math.max(0, Math.min(stepsTop - vh * 0.6, innerEl.scrollHeight - vh));
          const cy = stepsTop - panT + markerH / 2; // centre des cercles (viewport)
          // Géométrie de la clôture : deux lisses sous les cercles,
          // poteaux plantés sous chaque marqueur (la tête du poteau est
          // masquée par le cercle — le marqueur fait office de chapeau).
          const railTop = cy + markerH / 2 + 13;
          const railBot = railTop + 22;
          const postTop = cy + 4;
          const postBot = railBot + 12;
          const colW = sr.width / stepEls.length;
          postXs = stepEls.map((_, i) => sr.left - ir.left + (i + 0.5) * colW);
          endX = postXs[postXs.length - 1] ?? 0;
          sideLen = Math.max(0, endX - X0);
          // La descente EST le premier poteau : elle va jusqu'au bas
          // des poteaux — les lisses s'arriment ensuite à elle.
          downLen = postBot;
          pathEl.setAttribute('d', `M ${X0} 0 L ${X0} ${postBot.toFixed(1)}`);
          railEls.forEach((rail, ri) => {
            const y = ri === 0 ? railTop : railBot;
            rail.setAttribute('x1', `${X0}`);
            rail.setAttribute('x2', `${endX.toFixed(1)}`);
            rail.setAttribute('y1', y.toFixed(1));
            rail.setAttribute('y2', y.toFixed(1));
          });
          postEls.forEach((p, i) => {
            const px = postXs[i];
            if (px == null) return;
            p.setAttribute('x', (px - 4).toFixed(1));
            p.setAttribute('y', postTop.toFixed(1));
            p.setAttribute('width', '8');
            p.setAttribute('height', (postBot - postTop).toFixed(1));
          });
          // Grillage soudé : fils verticaux serrés entre poteaux, en
          // partant du bord d'écran (la clôture « arrive » de la gauche).
          meshEl.replaceChildren();
          const anchors = [X0, ...postXs];
          for (let b = 0; b < anchors.length - 1; b++) {
            for (let x = anchors[b] + 10; x <= anchors[b + 1] - 10; x += 13) {
              const w = document.createElementNS(SVGNS, 'line');
              w.setAttribute('x1', x.toFixed(1));
              w.setAttribute('x2', x.toFixed(1));
              w.setAttribute('y1', (railTop - 1).toFixed(1));
              w.setAttribute('y2', (railBot + 1).toFixed(1));
              meshEl.appendChild(w);
            }
          }
          clipEl.setAttribute('height', `${vh}`);
        }
        dashTotal = downLen;
        pathEl.style.strokeDasharray = `${dashTotal}`;
      };

      const smooth01 = (t: number) => {
        const c = Math.min(1, Math.max(0, t));
        return c * c * (3 - 2 * c);
      };

      const drawPath = () => {
        const r = scrollPath.getBoundingClientRect();
        const vh = window.innerHeight;
        let drawn: number;
        // Le SVG (fixed) est clippé sous le haut de la section : la
        // ligne ne peut pas s'afficher par-dessus la vidéo — elle
        // « émerge » du bord inférieur de la vidéo.
        svgEl.style.clipPath = `inset(${Math.max(0, r.top).toFixed(1)}px 0 0 0)`;
        if (mqNarrow.matches) {
          // SVG fixed : visible seulement tant que la section est à
          // l'écran.
          svgEl.style.display = r.top < vh && r.bottom > 0 ? '' : 'none';
          const d0 = vh * 0.3;
          const p = Math.min(1, Math.max(0, (vh - r.top - d0) / (r.height - d0)));
          drawn = p * dashTotal;
          // Étapes révélées une à une pendant la descente mobile.
          stepEls.forEach((el, i) =>
            el.classList.toggle('is-on', p > i / 5 + 0.02)
          );
        } else {
          // Descente de la ligne PENDANT le scroll normal : 0 quand la
          // piste entre en bas d'écran, 1 (= ryFinal, au coin du futur
          // ruban) quand la page se fige. Continu ensuite avec le
          // virage horizontal pendant le gel.
          svgEl.style.display = r.top < vh && r.bottom > vh ? '' : 'none';
          const a = smooth01(Math.min(1, Math.max(0, (vh - r.top) / vh)));
          const q = Math.min(1, Math.max(0, -r.top / (r.height - vh)));
          const panE = smooth01((q - HOLD) / (PAN_END - HOLD));
          innerEl.style.transform = `translate3d(0, ${(-panT * panE).toFixed(1)}px, 0)`;
          const hfrac = Math.min(1, Math.max(0, (q - H_START) / (1 - H_START)));
          drawn = a * downLen;
          // Front de construction : le clip révèle lisses + grillage
          // jusqu'à tipX ; chaque poteau se plante et le cercle « pop »
          // quand le front atteint son centre — jamais d'étape en avance.
          const tipX = X0 + hfrac * sideLen;
          clipEl.setAttribute('width', Math.max(0, tipX).toFixed(1));
          const sr = stepsEl.getBoundingClientRect();
          const colW = sr.width / stepEls.length;
          stepEls.forEach((el, i) => {
            const center = sr.left + (i + 0.5) * colW;
            const reached = tipX >= center - 6;
            el.classList.toggle('is-on', reached);
            postEls[i]?.classList.toggle('is-on', reached);
          });
        }
        pathEl.style.strokeDashoffset = `${Math.max(0, dashTotal - drawn)}`;
      };

      const syncPath = () => {
        const pinned = !mqReducedPath.matches && !mqNarrow.matches;
        scrollPath.classList.toggle('is-pinned', pinned);
        // .is-anim masque les étapes (pop à l'arrivée du trait) ; sans
        // JS ou en reduced-motion tout reste visible normalement.
        scrollPath.classList.toggle('is-anim', !mqReducedPath.matches);
        if (mqReducedPath.matches) {
          svgEl.style.display = 'none';
          innerEl.style.transform = '';
          stepEls.forEach((el) => el.classList.remove('is-on'));
          postEls.forEach((p) => p.classList.remove('is-on'));
          return;
        }
        if (!pinned) innerEl.style.transform = '';
        measurePath();
        drawPath();
      };

      window.addEventListener('scroll', drawPath, { passive: true });
      window.addEventListener('resize', syncPath);
      mqNarrow.addEventListener('change', syncPath);
      mqReducedPath.addEventListener('change', syncPath);
      syncPath();
    }
  </script>
</MainLayout>

<style>
  .section-header {
    margin-bottom: var(--space-8);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .projects-grid-preview {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .projects-grid-preview {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid-preview {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .section-actions {
    margin-top: var(--space-8);
    text-align: center;
  }

  .cta-box {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
  }

  .cta-text {
    margin-bottom: var(--space-6);
    opacity: 0.95;
  }

  .prose {
    max-width: 70ch;
    margin-inline: auto;
    color: var(--color-text);
    line-height: var(--leading-relaxed);
  }

  .prose p + p {
    margin-top: var(--space-4);
  }

  .about-content {
    max-width: 80ch;
    margin-inline: auto;
  }

  /* Logo visible uniquement en thème Nature */
  .about-logo {
    display: none;
    width: 100%;
    max-width: 220px;
    height: auto;
    flex-shrink: 0;
  }

  :global([data-theme='nature'] #a-propos) .about-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  :global([data-theme='nature'] #a-propos) .about-logo {
    display: block;
  }

  @media (min-width: 768px) {
    :global([data-theme='nature'] #a-propos) .about-content {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-10);
      text-align: left;
    }

    :global([data-theme='nature'] #a-propos) .about-logo {
      max-width: 250px;
    }
  }

  /* Thème Nature : pas d'en-tête dans la section À propos */
  :global([data-theme='nature'] #a-propos) .section-header {
    display: none;
  }



</style>
