---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import ArrowDivider from '../components/ArrowDivider.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import logo from '../assets/pepito-logo.svg';
import atelierImg from '../assets/atelier-thiers.jpg';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { signature } from '../data/signature';
import { getBlocksMap, blockText } from '../lib/blocks.js';
import { ICONS } from '../lib/icons';
import GateScene from '../components/GateScene.astro';
import { getSite } from '../lib/site.js';
import { getProjects } from '../lib/api.js';
import CityMap from '../components/CityMap.astro';
import type { Project, Service } from '../data/types';

const { settings, services, slides } = await getSite();
const projects = await getProjects();
const previewProjects = projects.slice(0, 3);
const carouselProjects = projects.slice(0, 9);
const base = import.meta.env.BASE_URL;

// Le contenu « Signature » (hero, activités, arguments, processus) est
// dans src/data/signature.ts — partagé avec la page Nos services.

// Textes éditables en BO (content_blocks) — fallback sur les valeurs du
// code si le bloc est absent ou vide, la page ne casse jamais.
const blk = await getBlocksMap();
const T = (k: string, d: string) => blockText(blk, k, d);
const sig = {
  ...signature,
  processTitle: T('home.process.title', signature.processTitle),
  benefitsTitle: T('home.benefits.title', signature.benefitsTitle),
  installsTitle: T('home.installs.title', signature.installsTitle),
  steps: signature.steps.map((s, i) => ({
    ...s,
    title: T(`home.process.step${i + 1}.title`, s.title),
    text: T(`home.process.step${i + 1}.text`, s.text),
  })),
  benefits: signature.benefits.map((b, i) => ({
    ...b,
    title: T(`home.benefits.${i + 1}.title`, b.title),
    text: T(`home.benefits.${i + 1}.text`, b.text),
  })),
};

// Entité locale canonique (@id #business, référencée par les pages villes
// et réalisations). sameAs relie la fiche Google et les réseaux au site —
// Google s'en sert pour associer l'entité web à la fiche Business Profile.
const siteUrl = settings.siteUrl.replace(/\/$/, '');
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${siteUrl}/#business`,
  name: settings.name,
  url: siteUrl,
  image: `${siteUrl}/pepito-logo.svg`,
  ...(settings.contact.phone && { telephone: settings.contact.phone }),
  ...(settings.contact.email && { email: settings.contact.email }),
  ...(settings.contact.address && {
    address: { '@type': 'PostalAddress', streetAddress: settings.contact.address, addressCountry: 'FR' },
  }),
  geo: { '@type': 'GeoCoordinates', latitude: 45.8567, longitude: 3.5489 },
  ...(settings.contact.serviceArea && {
    areaServed: {
      '@type': 'GeoCircle',
      geoMidpoint: { '@type': 'GeoCoordinates', latitude: 45.8567, longitude: 3.5489 },
      geoRadius: '50000',
    },
  }),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  },
  ...(settings.sameAs?.length && { sameAs: settings.sameAs }),
}];
---

<MainLayout
  title="Clôtures & portails à Thiers (63)"
  description={settings.description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <HeroSlideshow settings={settings} projects={projects} slides={slides} />

  <ArrowDivider
    background="var(--color-surface)"
    prolongement
  />

  {/* GateScroll en pause — remonter ce composant autour de #a-propos pour réactiver le portail au scroll */}
  <Section id="a-propos" class="section-alt">
    <div class="section-header">
      <h2 class="section-title">À propos de Pépito Services</h2>
      <p class="section-subtitle">
        Une entreprise artisanale au service de vos projets extérieurs.
      </p>
    </div>

    <div class="about-content">
      <img
        src={logo.src}
        alt="Pépito Services"
        class="about-logo"
        loading="lazy"
      />
      <div class="prose">
        <p>{settings.aboutText || settings.description}</p>
      </div>
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-surface)"
    background="var(--color-cream)"
  />

  <Section id="services" class="section-cream">
    <div class="section-header">
      <h2 class="section-title">Nos services</h2>
      <p class="section-subtitle">
        Des solutions de clôture, portails et aménagements extérieurs sur
        mesure, à adapter ensemble selon votre terrain et vos envies.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service: Service, i: number) => <ServiceCard service={service} index={i} />)}
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-cream)"
    background="var(--color-surface)"
  />

  <Section id="realisations" class="section-alt">
    <div class="section-header">
      <h2 class="section-title">Quelques réalisations</h2>
      <p class="section-subtitle">
        Découvrez un aperçu de nos chantiers réalisés sur mesure,
        du terrain à la pose.
      </p>
    </div>

    <div class="projects-grid-preview">
      {previewProjects.map((project: Project) => <ProjectCard project={project} />)}
    </div>

    <div class="section-actions">
      <a href={`${base}realisations/`} class="btn btn-secondary">Voir toutes les réalisations</a>
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-surface)"
    background="var(--color-secondary)"
  />

  <Section class="section-cta">
    <div class="cta-box">
      <h2 class="section-title">Un projet en tête ?</h2>
      <p class="cta-text">
        Discutons-en ensemble. Demandez une estimation personnalisée pour votre
        clôture, portail, palissade ou aménagement extérieur.
      </p>
      <a href={`${base}contact/`} class="btn btn-primary">Demander un chiffrage</a>
    </div>
  </Section>

  {/* ── Thème « Signature » : landing produit (visible uniquement sous
      data-theme='signature', masquée via theme-signature.css) ── */}
  <div class="signature-home">
    <GateScene />

    <section class="sig-about container" id="entreprise">
      <div class="sig-about__grid">
        <div class="sig-about__body">
          <h2
            class="sig-title sig-about__title"
            set:html={T('home.about.title', 'Pépito Services, artisan installateur à Thiers')}
          />
          <p set:html={T('home.about.p1', "Pépito Services est l'entreprise individuelle de Sylvain Palladuc, artisan installateur basé à Thiers, au cœur du Livradois-Forez. Nous préparons et posons clôtures rigides et souples, palissades occultantes, portails et portillons, motorisations et petits terrassements à la mini-pelle — un seul interlocuteur, de l'étude du terrain à la réception du chantier.")} />
          <p set:html={T('home.about.p2', "Installés dans nos ateliers thiernois, nous intervenons dans tout le Puy-de-Dôme dans un rayon d'environ 50 km. Chaque ouvrage est pensé pour durer : matériaux résistants, sous-bassement béton contre l'humidité et finitions propres. Devis gratuit et personnalisé.")} />
          <ul class="sig-about__facts">
            <li><Icon name="pin" size={13} />{T('home.about.badge1', 'Thiers · Livradois-Forez')}</li>
            <li><Icon name="ruler" size={13} />{T('home.about.badge2', "Rayon d'intervention ~50 km")}</li>
            <li><Icon name="check" size={13} />{T('home.about.badge3', 'Devis gratuit')}</li>
          </ul>
        </div>
        <div class="sig-about__photo">
          <Image
            src={atelierImg}
            alt="Les ateliers Pépito Services à Thiers, dans le Livradois-Forez"
            widths={[640, 1024]}
            sizes="(min-width: 900px) 42vw, 92vw"
            format="webp"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <div class="sig-scrollpath">
      <div class="sig-scrollpath__sticky">
        <div class="sig-scrollpath__inner">
          <div class="sig-divider" aria-hidden="true">
            <svg viewBox="0 0 1200 10" preserveAspectRatio="none">
              <defs>
                <linearGradient id="sig-div-fade" x1="0" x2="1">
                  <stop offset="0" style="stop-color: var(--forest); stop-opacity: 0" />
                  <stop offset="0.06" style="stop-color: var(--forest); stop-opacity: 0.38" />
                  <stop offset="0.94" style="stop-color: var(--forest); stop-opacity: 0.38" />
                  <stop offset="1" style="stop-color: var(--forest); stop-opacity: 0" />
                </linearGradient>
              </defs>
              <path
                d="M0 3 H596 L600 8 L604 3 H1200"
                fill="none"
                stroke="url(#sig-div-fade)"
                stroke-width="1"
                vector-effect="non-scaling-stroke"
              />
            </svg>
          </div>
          <header class="sig-process-head container">
            <h2 class="sig-title">{sig.processTitle}</h2>
            <p
              class="sig-process-head__sub"
              set:html={T('home.process.sub', 'De la préparation du terrain à la réception du chantier — notre méthode de pose, étape par étape.')}
            />
          </header>
          <section class="sig-process">
      <div class="sig-band" aria-hidden="true"></div>
      <div class="container">
        <div class="sig-arms" aria-hidden="true">
          {sig.steps.map(() => <span class="sig-step__arm" />)}
        </div>
        <ol class="sig-steps">
          {sig.steps.map((s, i) => (
            <li class="sig-step">
              <span class:list={['sig-step__marker', { 'sig-step__marker--iso': s.img }]} aria-hidden="true">
                {s.img ? (
                  <img class="sig-step__photo" src={s.img} alt="" loading="lazy" />
                ) : (
                  <svg
                    class="sig-step__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={ICONS[s.icon] ?? ICONS.check}
                  />
                )}
              </span>
              <div class="sig-step__body">
                <h3 set:html={s.title} />
                <p set:html={s.text} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
        </div>
      </div>
    </div>

    <section class="sig-benefits">
      <div class="container">
        <h2 class="sig-title">{sig.benefitsTitle}</h2>
        <p
          class="sig-benefits__lead"
          set:html={T('home.benefits.lead', 'Clôtures rigides, portails et portillons sur mesure, murets et aménagements extérieurs : votre artisan local pour sécuriser et embellir votre propriété.')}
        />
        <div class="sig-benefits__grid">
          {sig.benefits.map((b) => (
            <div class="sig-benefit">
              <span class="sig-benefit__icon" aria-hidden="true">
                {b.icon === 'shield' && <img src={`${base}icons/benefit-shield.png`} alt="" loading="lazy" />}
                {b.icon === 'finish' && <img src={`${base}icons/benefit-finish.png`} alt="" loading="lazy" />}
                {b.icon === 'clock' && <img src={`${base}icons/benefit-clock.png`} alt="" loading="lazy" />}
              </span>
              <h3 set:html={b.title} />
              <p set:html={b.text} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="sig-installpath">
      <div class="sig-installpath__sticky">
        <div class="sig-installpath__inner">
          <section class="sig-installs">
            <div class="sig-installs__band" aria-hidden="true"></div>
            <div class="container">
              <h2 class="sig-title">{sig.installsTitle}</h2>
              <div class="sig-carousel">
                <button type="button" class="sig-carousel__btn sig-carousel__btn--prev" aria-label="Réalisations précédentes" disabled>
                  <Icon name="chevron-left" size={22} />
                </button>
                <div class="sig-carousel__vp">
                  <div class="sig-carousel__track">
                    {carouselProjects.map((project: Project) => <ProjectCard project={project} />)}
                  </div>
                </div>
                <button type="button" class="sig-carousel__btn sig-carousel__btn--next" aria-label="Réalisations suivantes">
                  <Icon name="chevron-right" size={22} />
                </button>
              </div>
              <div class="sig-installs__more">
                <a href={`${base}realisations/`} class="sig-btn sig-btn--primary"><span>Voir toutes les réalisations</span><Icon name="move-right" size={16} class="cta-arrow" /></a>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <section class="sig-zone container" id="zone-intervention">
      <div class="sig-zone__intro">
        <h2
          class="sig-title"
          set:html={T('home.zone.title', 'Artisan clôturier à Thiers — interventions dans un rayon de 50 km')}
        />
        <p
          class="sig-zone__lead"
          set:html={T('home.zone.p1', 'Basée à Thiers dans le Puy-de-Dôme (63), <strong>Pépito Services</strong> se déplace dans un rayon de 50 km pour la pose de clôtures rigides, portails et portillons sur mesure, palissades, murets avec sous-bassement béton et petits travaux de terrassement.')}
        />
        <p
          class="sig-zone__lead"
          set:html={T('home.zone.p2', 'Nous intervenons à Courpière, Billom, Lezoux, Pont-du-Château, Ambert, Cunlhat, Clermont-Ferrand, Riom, Vichy et Montbrison, ainsi que dans toutes les communes du Livradois-Forez et de la plaine de la Dore. Le chiffrage est gratuit et sans engagement — nous nous déplaçons chez vous pour étudier votre terrain.')}
        />
      </div>
      <div class="sig-zone__map"><CityMap height="440px" /></div>
      <p class="sig-zone__nap">
        <strong>{settings.name}</strong> — {settings.contact.address} — <a href={`tel:${String(settings.contact.phone).replace(/\s/g, '')}`}>{settings.contact.phone}</a>
      </p>
    </section>
  </div>

  <script>

    // Vue figée pilotée par le scroll : la page se bloque quand la
    // section arrive en haut, le contenu se recale pour cadrer le
    // ruban, puis les étapes « pop » une à une à intervalle régulier
    // pendant le gel. Mobile : révélation séquentielle au fil de la
    // descente. Reduced motion : pas de gel, tout visible normalement.
    const scrollPath = document.querySelector<HTMLElement>('.sig-scrollpath');
    const innerEl = scrollPath?.querySelector<HTMLElement>('.sig-scrollpath__inner');
    const stepsEl = scrollPath?.querySelector<HTMLElement>('.sig-steps');
    if (scrollPath && innerEl && stepsEl) {
      const mqNarrow = window.matchMedia('(max-width: 899px)');
      const mqReducedPath = window.matchMedia('(prefers-reduced-motion: reduce)');
      const stepEls = Array.from(
        stepsEl.querySelectorAll<HTMLElement>('.sig-step')
      );
      const bandEl = scrollPath.querySelector<HTMLElement>('.sig-band');
      const procEl = scrollPath.querySelector<HTMLElement>('.sig-process');
      const armsEl = scrollPath.querySelector<HTMLElement>('.sig-arms');
      const armEls = stepEls.map((_, i) =>
        armsEl?.querySelectorAll<HTMLElement>('.sig-step__arm').item(i) ?? null
      );
      // Phases de la vue épinglée : pan du contenu quasi immédiat et
      // court, puis les pops démarrent PENDANT que le bloc finit de se
      // caler — pas de temps mort entre le gel et la 1re étape.
      const HOLD = 0.02;
      const PAN_END = 0.25;
      const H_START = 0.04;
      let panT = 0;
      // Paliers de glisse du bandeau : [q de pop, progression] — le
      // bord vert arrive sur chaque étape au moment où elle pop.
      let bandKnots: Array<[number, number]> = [];
      // Mobile : paliers [q où la pointe de la spine doit atteindre le
      // centre de l'icône i, y de ce centre dans .sig-process] — la
      // descente de la spine suit donc le scroll, icône après icône.
      let tipKnots: Array<[number, number]> = [];
      let iconYs: number[] = [];
      let armLeads: number[] = [];
      let procH = 0;
      // Jouée une seule fois : la séquence terminée reste figée à l'état
      // final même en remontant la piste (pas de lecture inversée), et
      // la piste est sautée au scroll (plus de traversée « morte »).
      let doneP = false;
      let lastYP = window.scrollY;

      // Position de mise en page du ruban dans le bloc inner (offsetTop)
      // : constante, insensible au translateY du pan.
      const naturalTop = () => {
        let n = 0;
        let el: HTMLElement | null = stepsEl;
        while (el && el !== innerEl) {
          n += el.offsetTop;
          el = el.offsetParent as HTMLElement | null;
        }
        return n;
      };

      const measure = () => {
        if (mqNarrow.matches) return;
        const vh = window.innerHeight;
        // Pas de pan : la composition reste figée telle quelle au
        // moment de l'accroche (titre ~mi-page, rien ne se déplace).
        panT = 0;
        // Paliers du bandeau : à chaque q de pop, sa progression bp
        // place son bord droit juste après le bord droit de l'étape
        // (tout son texte est couvert). Bord écran = 106·bp − 6 % de
        // la largeur de la section.
        if (bandEl && procEl && stepEls.length) {
          const pr = procEl.getBoundingClientRect();
          const len = stepEls.length;
          bandKnots = [[0, 0]];
          stepEls.forEach((el, i) => {
            const qi = H_START + (i * (1 - H_START)) / len;
            const sr = el.getBoundingClientRect();
            const tx = (sr.right - pr.left) / pr.width + 0.02;
            bandKnots.push([qi, Math.min(1, (tx * 100 + 6) / 106)]);
          });
          bandKnots.push([H_START + ((len - 1) * (1 - H_START)) / len + 0.09, 1]);
        }
      };

      // Interpolation linéaire entre les paliers [q, valeur].
      const interp = (k: Array<[number, number]>, qq: number) => {
        if (!k.length) return Math.min(1, qq);
        if (qq <= k[0][0]) return k[0][1];
        for (let i = 1; i < k.length; i++) {
          if (qq <= k[i][0]) {
            const [q0, b0] = k[i - 1];
            const [q1, b1] = k[i];
            return b0 + ((qq - q0) / (q1 - q0)) * (b1 - b0);
          }
        }
        return k[k.length - 1][1];
      };
      const bandAt = (qq: number) => interp(bandKnots, qq);
      const tipAt = (qq: number) => interp(tipKnots, qq);

      // Position de mise en page (offsetTop/offsetLeft) : insensible
      // aux transform des états masqués.
      const layoutPos = (el: HTMLElement, stop: HTMLElement) => {
        let x = 0;
        let y = 0;
        let cur: HTMLElement | null = el;
        while (cur && cur !== stop) {
          x += cur.offsetLeft;
          y += cur.offsetTop;
          cur = cur.offsetParent as HTMLElement | null;
        }
        return { x, y };
      };

      // Mobile : paliers de la spine et géométrie des bras — mesurés
      // une fois (positions de mise en page, pas de rect viewport).
      const measureMobile = () => {
        const containerEl = procEl?.querySelector<HTMLElement>('.container');
        if (!mqNarrow.matches || !bandEl || !procEl || !containerEl || !stepEls.length) return;
        const vh = window.innerHeight;
        const span = Math.max(1, scrollPath.getBoundingClientRect().height - vh);
        procH = procEl.offsetHeight;
        tipKnots = [];
        iconYs = [];
        armLeads = [];
        // Rien de tracé tant que le haut de la section n'atteint pas
        // ~30 % du viewport : la pointe part alors de 0 et descend à
        // l'écran — chaque icône est connectée quand son centre arrive
        // sur sa ligne cible, de 45 % (1re) à 75 % (dernière).
        const procPathY = layoutPos(procEl, scrollPath).y;
        const qStart = Math.max(0, (procPathY - vh * 0.3) / span);
        const n = stepEls.length;
        let startY = 0;
        const iconKnots: Array<[number, number]> = [];
        stepEls.forEach((el, i) => {
          const marker = el.querySelector<HTMLElement>('.sig-step__marker');
          const arm = armEls[i];
          if (!marker || !arm) return;
          const mProc = layoutPos(marker, procEl);
          const y = mProc.y + marker.offsetHeight / 2;
          iconYs[i] = y;
          armLeads[i] = marker.offsetHeight;
          // q où le centre de l'icône atteint sa cible à l'écran :
          // yCentre − q·(H−vh) = t·vh. t croît d'icône en icône donc
          // la connexion se fait de plus en plus bas dans le champ.
          const mPath = layoutPos(marker, scrollPath);
          const t = n > 1 ? 0.45 + (0.3 * i) / (n - 1) : 0.6;
          const qi = (mPath.y + marker.offsetHeight / 2 - vh * t) / span;
          if (qi <= qStart) {
            // Icône déjà au-delà de sa cible au départ de la trace.
            startY = Math.max(startY, y);
          } else {
            iconKnots.push([Math.min(1, qi), y]);
          }
          // Bras : trait fin depuis la spine (-1rem) jusqu'au bord
          // droit de l'icône + léger dépassement. Le container sert de
          // repère : .sig-arms le couvre en inset:0.
          const mCont = layoutPos(marker, containerEl);
          arm.style.setProperty('--arm-y', `${Math.round(mCont.y + marker.offsetHeight / 2)}px`);
          arm.style.setProperty('--arm-w', `${Math.round(16 + mCont.x + marker.offsetWidth + 6)}px`);
          arm.style.setProperty('--arm-h', '1rem');
        });
        iconKnots.sort((a, b) => a[0] - b[0]);
        tipKnots = [[qStart, startY], ...iconKnots];
        // La spine s'arrête à la dernière icône.
        tipKnots.push([1, tipKnots[tipKnots.length - 1][1]]);
      };

      const smooth01 = (t: number) => {
        const c = Math.min(1, Math.max(0, t));
        return c * c * (3 - 2 * c);
      };

      const draw = () => {
        const r = scrollPath.getBoundingClientRect();
        const vh = window.innerHeight;
        const q = Math.min(1, Math.max(0, -r.top / (r.height - vh)));
        if (!doneP && q >= 0.95) doneP = true;
        // Séquence terminée : la piste devient transparente au scroll —
        // entrer dedans dans un sens ressort de l'autre côté, sinon le
        // gel consomme ~180vh de scroll sans rien faire bouger. La
        // direction est suivie à chaque événement (pas seulement après
        // le verrou) sinon la 1re remontée partirait dans le mauvais sens.
        const yNow = window.scrollY;
        const goingDown = yNow > lastYP;
        lastYP = yNow;
        if (doneP && !mqNarrow.matches && !mqReducedPath.matches) {
          const docTop = yNow + r.top;
          const trackEnd = docTop + r.height - vh;
          if (goingDown && yNow > docTop + 4 && yNow < trackEnd) {
            window.scrollTo({ top: trackEnd + 4, behavior: 'instant' });
          } else if (!goingDown && yNow < trackEnd - 4 && yNow > docTop) {
            window.scrollTo({ top: docTop - 4, behavior: 'instant' });
          }
        }
        // Le bandeau glisse depuis la gauche pendant tout le gel, le
        // long de sa propre pente : la compensation verticale (4.3rem
        // = pente du bord ~4.05rem × 1.06 de course) annule la dérive
        // vers le bas — le bord biaisé reste à niveau. La bande reste
        // un peu en avance sur l'étape qui pop (le texte clair
        // atterrit toujours sur le vert) — posée à la dernière étape.
        if (bandEl) {
          if (mqReducedPath.matches) {
            bandEl.style.transform = '';
            bandEl.style.height = '';
          } else if (mqNarrow.matches) {
            // Spine verticale : sa hauteur suit la pointe — pilotée en
            // height (pas scaleY) pour garder l'arrondi net en bas.
            const tip = tipAt(q);
            bandEl.style.transform = '';
            bandEl.style.height = `${tip.toFixed(1)}px`;
          } else {
            const bp = doneP ? 1 : bandAt(q);
            const bx = (-106 * (1 - bp)).toFixed(1);
            const by = (4.3 * (1 - bp)).toFixed(2);
            bandEl.style.height = '';
            bandEl.style.transform = `translate3d(${bx}%, ${by}rem, 0)`;
          }
        }
        if (mqNarrow.matches) {
          // Le bras de chaque étape se déploie (scaleX) pendant que la
          // pointe de la spine traverse la hauteur de son icône ;
          // l'étape pop quand la bande est entièrement déployée
          // derrière la vignette (« collée »). Révélée = gardée.
          const tip = tipAt(q);
          stepEls.forEach((el, i) => {
            const lead = armLeads[i] || 1;
            const iy = iconYs[i];
            const p =
              iy === undefined
                ? 1
                : Math.min(1, Math.max(0, (tip - (iy - lead)) / lead));
            if (!mqReducedPath.matches) {
              armEls[i]?.style.setProperty('--arm-p', p.toFixed(3));
            }
            el.classList.toggle(
              'is-on',
              el.classList.contains('is-on') || p >= 1
            );
          });
        } else {
          const panE = smooth01((q - HOLD) / (PAN_END - HOLD));
          innerEl.style.transform = `translate3d(0, ${(-panT * panE).toFixed(1)}px, 0)`;
          // Une étape pop à intervalle régulier pendant le gel — la
          // dernière s'affiche à ~82 % de la piste, il reste un peu de
          // marge avant la libération. Séquence finie (doneP) : tout
          // reste affiché en remontant.
          stepEls.forEach((el, i) =>
            el.classList.toggle(
              'is-on',
              doneP || q >= H_START + (i * (1 - H_START)) / stepEls.length
            )
          );
        }
      };

      const sync = () => {
        const pinned = !mqReducedPath.matches && !mqNarrow.matches;
        scrollPath.classList.toggle('is-pinned', pinned);
        // .is-anim masque les étapes (pop au scroll) ; sans JS ou en
        // reduced-motion tout reste visible normalement.
        scrollPath.classList.toggle('is-anim', !mqReducedPath.matches);
        if (mqReducedPath.matches) {
          innerEl.style.transform = '';
          stepEls.forEach((el) => el.classList.remove('is-on'));
          if (bandEl) {
            bandEl.style.transform = '';
            bandEl.style.height = '';
          }
          return;
        }
        if (!pinned) innerEl.style.transform = '';
        measure();
        measureMobile();
        draw();
      };

      window.addEventListener('scroll', draw, { passive: true });
      window.addEventListener('resize', sync);
      mqNarrow.addEventListener('change', sync);
      mqReducedPath.addEventListener('change', sync);
      sync();
    }

    // Révélation à l'entrée dans le viewport : présentation en cascade,
    // titre du process (une fois ; reduced-motion → pas de masquage).
    const mqReducedRv = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!mqReducedRv.matches) {
      // Présentation : desktop → cascade quand 20 % de la section est
      // visible ; mobile (section plus haute que l'écran) → chaque
      // élément se révèle quand son haut franchit ~60 % du viewport,
      // comme les étapes du process.
      const aboutRv = document.querySelector<HTMLElement>('.sig-about');
      if (aboutRv) {
        aboutRv.classList.add('rv');
        const mqNarrowRv = window.matchMedia('(max-width: 899px)');
        const ioRv = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                ioRv.unobserve(entry.target);
              }
            }
          },
          mqNarrowRv.matches
            ? { threshold: 0, rootMargin: '0px 0px -40% 0px' }
            : { threshold: 0.2 }
        );
        if (mqNarrowRv.matches) {
          aboutRv
            .querySelectorAll<HTMLElement>(
              '.sig-about__photo, .sig-about__title, .sig-about__body p, .sig-about__facts li'
            )
            .forEach((el) => ioRv.observe(el));
        } else {
          ioRv.observe(aboutRv);
        }
      }

      // Séparateur : marge négative — il doit être déjà ~20 % dans le
      // viewport pour se déployer (animation entièrement visible).
      const divEl = document.querySelector<HTMLElement>('.sig-divider');
      if (divEl) {
        divEl.classList.add('rv');
        const ioDiv = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              divEl.classList.add('is-in');
              ioDiv.disconnect();
            }
          },
          { threshold: 0, rootMargin: '0px 0px -20% 0px' }
        );
        ioDiv.observe(divEl);
      }

      // Benefits : marge négative — la section doit être bien remontée
      // dans le viewport avant que les icônes ne poppent.
      const benEl = document.querySelector<HTMLElement>('.sig-benefits');
      if (benEl) {
        benEl.classList.add('rv');
        const ioBen = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              benEl.classList.add('is-in');
              ioBen.disconnect();
            }
          },
          { threshold: 0, rootMargin: '0px 0px -55% 0px' }
        );
        ioBen.observe(benEl);
      }

      // Titre du process : marge négative — il doit être bien remonté
      // dans le viewport avant de se révéler (juste avant le gel).
      const headEl = document.querySelector<HTMLElement>('.sig-process-head');
      if (headEl) {
        headEl.classList.add('rv');
        const ioHead = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              headEl.classList.add('is-in');
              ioHead.disconnect();
            }
          },
          { threshold: 0, rootMargin: '0px 0px -40% 0px' }
        );
        ioHead.observe(headEl);
      }
    }

    // ═══ Piste épinglée des installations ═══
    // Même mécanique que le scrollpath : le bandeau glisse depuis la
    // gauche proportionnellement à q (avec compensation verticale sur
    // sa pente), puis les cards poppent une à une à des seuils de
    // progression. Mobile : pop quand chaque card franchit ~60 % du
    // viewport. Reduced-motion : rien d'épinglé ni de masqué.
    const installPath = document.querySelector<HTMLElement>('.sig-installpath');
    const insBand = installPath?.querySelector<HTMLElement>('.sig-installs__band');
    if (installPath && insBand) {
      const mqNarrowI = window.matchMedia('(max-width: 899px)');
      const mqReducedI = window.matchMedia('(prefers-reduced-motion: reduce)');
      const insCards = Array.from(
        installPath.querySelectorAll<HTMLElement>('.project-card')
      );
      const insMore = installPath.querySelector<HTMLElement>('.sig-installs__more');
      const insSection = installPath.querySelector<HTMLElement>('.sig-installs');
      // Paliers de glisse du bandeau : [q de pop, progression] — le
      // bord vert arrive sur chaque card au moment où elle pop, comme
      // les étapes du process (pas de rectangle vide qui traverse).
      let insKnots: Array<[number, number]> = [];
      // Jouée une seule fois : séquence terminée = état final figé +
      // piste sautée au scroll (pas de traversée « morte »).
      let doneI = false;
      let lastYI = window.scrollY;

      // Carrousel : glisse carte par carte, stop aux extrémités.
      // .is-ready révèle les flèches (séquence jouée ou 1re card mobile).
      const carVp = installPath.querySelector<HTMLElement>('.sig-carousel__vp');
      const carTrack = installPath.querySelector<HTMLElement>('.sig-carousel__track');
      const prevBtn = installPath.querySelector<HTMLButtonElement>('.sig-carousel__btn--prev');
      const nextBtn = installPath.querySelector<HTMLButtonElement>('.sig-carousel__btn--next');
      let carIdx = 0;
      const carPerView = () =>
        window.innerWidth < 640 ? 1 : window.innerWidth < 1024 ? 2 : 3;
      const carMax = () => Math.max(0, insCards.length - carPerView());
      const carApply = () => {
        if (!carTrack || !prevBtn || !nextBtn) return;
        const gap = parseFloat(getComputedStyle(carTrack).gap) || 0;
        const step = (insCards[0]?.getBoundingClientRect().width ?? 0) + gap;
        carTrack.style.transform = `translate3d(${(-carIdx * step).toFixed(1)}px, 0, 0)`;
        prevBtn.disabled = carIdx <= 0;
        nextBtn.disabled = carIdx >= carMax();
      };
      prevBtn?.addEventListener('click', () => {
        if (carIdx > 0) {
          carIdx--;
          carApply();
        }
      });
      nextBtn?.addEventListener('click', () => {
        if (carIdx < carMax()) {
          carIdx++;
          carApply();
        }
      });
      // Swipe tactile : delta > 40px → carte suivante/précédente.
      let swipeX: number | null = null;
      carVp?.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse') swipeX = e.clientX;
      });
      window.addEventListener('pointerup', (e) => {
        if (swipeX === null) return;
        const dx = e.clientX - swipeX;
        swipeX = null;
        if (Math.abs(dx) > 40) {
          if (dx < 0 && carIdx < carMax()) carIdx++;
          else if (dx > 0 && carIdx > 0) carIdx--;
          carApply();
        }
      });

      const measureI = () => {
        if (mqNarrowI.matches || !insSection || !insCards.length) return;
        const pr = insSection.getBoundingClientRect();
        insKnots = [[0, 0]];
        insCards.forEach((el, i) => {
          const qi = 0.34 + i * 0.18;
          const sr = el.getBoundingClientRect();
          const tx = (sr.right - pr.left) / pr.width + 0.02;
          insKnots.push([qi, Math.min(1, (tx * 100 + 6) / 106)]);
        });
        insKnots.push([0.86, 1]);
      };

      const bandAtI = (qq: number) => {
        const k = insKnots;
        if (!k.length) return Math.min(1, qq);
        if (qq <= k[0][0]) return k[0][1];
        for (let i = 1; i < k.length; i++) {
          if (qq <= k[i][0]) {
            const [q0, b0] = k[i - 1];
            const [q1, b1] = k[i];
            return b0 + ((qq - q0) / (q1 - q0)) * (b1 - b0);
          }
        }
        return k[k.length - 1][1];
      };

      const drawI = () => {
        const r = installPath.getBoundingClientRect();
        const vh = window.innerHeight;
        const q = Math.min(1, Math.max(0, -r.top / (r.height - vh)));
        if (!doneI && q >= 0.9) doneI = true;
        // Séquence terminée : la piste est sautée au scroll — entrer
        // dedans ressort de l'autre côté (comme le scrollpath).
        const yNow = window.scrollY;
        const goingDown = yNow > lastYI;
        lastYI = yNow;
        if (doneI && !mqNarrowI.matches && !mqReducedI.matches) {
          const docTop = yNow + r.top;
          const trackEnd = docTop + r.height - vh;
          if (goingDown && yNow > docTop + 4 && yNow < trackEnd) {
            window.scrollTo({ top: trackEnd + 4, behavior: 'instant' });
          } else if (!goingDown && yNow < trackEnd - 4 && yNow > docTop) {
            window.scrollTo({ top: docTop - 4, behavior: 'instant' });
          }
        }
        if (mqNarrowI.matches || mqReducedI.matches) {
          insBand.style.transform = '';
        } else {
          // Glisse depuis la gauche au rythme des pops, le long de sa
          // propre pente (compensation 3.3rem ≈ 3.1rem de pente × 1.06)
          // pour que le bord biaisé reste à niveau pendant le mouvement.
          const bp = doneI ? 1 : bandAtI(q);
          insBand.style.transform = `translate3d(${(-106 * (1 - bp)).toFixed(1)}%, ${(3.3 * (1 - bp)).toFixed(2)}rem, 0)`;
        }
        if (mqNarrowI.matches) {
          // Révélée = gardée : une card qui a pop ne se referme pas en
          // remontant.
          const line = vh * 0.6;
          insCards.forEach((el) =>
            el.classList.toggle(
              'is-on',
              el.classList.contains('is-on') || el.getBoundingClientRect().top < line
            )
          );
          if (insMore)
            insMore.classList.toggle(
              'is-on',
              insMore.classList.contains('is-on') || insMore.getBoundingClientRect().top < line
            );
          // Mobile : flèches révélées dès que la rangée de cards a pop.
          if (insCards.some((el) => el.classList.contains('is-on')))
            installPath.classList.add('is-ready');
        } else {
          // Pop à seuil : la card apparaît quand la bande vient de la
          // couvrir — CTA à 0.86, marge avant la libération. Les flèches
          // (is-ready) n'arrivent qu'une fois la séquence terminée
          // (doneI) ; à partir de là tout reste affiché et le carrousel
          // peut glisser ses cards hors champ déjà visibles.
          const ready =
            doneI || installPath.classList.contains('is-ready');
          if (ready) installPath.classList.add('is-ready');
          insCards.forEach((el, i) =>
            el.classList.toggle('is-on', ready || q >= 0.34 + i * 0.18)
          );
          if (insMore) insMore.classList.toggle('is-on', ready || q >= 0.86);
        }
      };

      const syncI = () => {
        const pinned = !mqReducedI.matches && !mqNarrowI.matches;
        installPath.classList.toggle('is-pinned', pinned);
        installPath.classList.toggle('is-anim', !mqReducedI.matches);
        if (mqReducedI.matches) {
          insBand.style.transform = '';
          insCards.forEach((el) => el.classList.remove('is-on'));
          if (insMore) insMore.classList.remove('is-on');
          return;
        }
        measureI();
        carIdx = Math.min(carIdx, carMax());
        carApply();
        drawI();
      };

      window.addEventListener('scroll', drawI, { passive: true });
      window.addEventListener('resize', syncI);
      mqNarrowI.addEventListener('change', syncI);
      mqReducedI.addEventListener('change', syncI);
      syncI();
    }
  </script>
</MainLayout>

