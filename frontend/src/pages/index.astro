---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import ArrowDivider from '../components/ArrowDivider.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContentBadge from '../components/ContentBadge.astro';
import logo from '../assets/pepito-logo.svg';
import { getSite } from '../lib/site.js';
import { getProjects } from '../lib/api.js';
import type { Project, Service } from '../data/types';

const { settings, services } = await getSite();
const projects = await getProjects();
const previewProjects = projects.slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<MainLayout
  title={settings.name}
  description={settings.description}
  canonicalPath="/"
>
  <HeroSlideshow settings={settings} projects={projects} />

  <ArrowDivider
    background="var(--color-surface)"
    prolongement
  />

  <Section id="a-propos" class="section-alt">
    <div class="section-header">
      <h2 class="section-title">À propos de Pépito Services</h2>
      <p class="section-subtitle">
        Une entreprise artisanale au service de vos projets extérieurs.
      </p>
    </div>

    <div class="about-content">
      <img
        src={logo.src}
        alt="Pépito Services"
        class="about-logo"
        loading="lazy"
      />
      <div class="prose">
        <p>{settings.aboutText || settings.description}</p>
      </div>
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-surface)"
    background="var(--color-cream)"
  />

  <Section id="services" class="section-cream">
    <div class="section-header">
      <h2 class="section-title">Nos services</h2>
      <p class="section-subtitle">
        Des solutions de clôture, portails et aménagements extérieurs sur
        mesure, à adapter ensemble selon votre terrain et vos envies.
      </p>
      <ContentBadge />
    </div>

    <div class="services-grid">
      {services.map((service: Service) => <ServiceCard service={service} />)}
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-cream)"
    background="var(--color-surface)"
  />

  <Section id="realisations" class="section-alt">
    <div class="section-header">
      <h2 class="section-title">Quelques réalisations</h2>
      <p class="section-subtitle">
        Découvrez un aperçu de nos chantiers. Les descriptions et catégories
        sont provisoires en attendant les informations validées par
        l'entreprise.
      </p>
    </div>

    <div class="projects-grid-preview">
      {previewProjects.map((project: Project) => <ProjectCard project={project} />)}
    </div>

    <div class="section-actions">
      <a href={`${base}realisations/`} class="btn btn-secondary">Voir toutes les réalisations</a>
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-surface)"
    background="var(--color-secondary)"
  />

  <Section class="section-cta">
    <div class="cta-box">
      <h2 class="section-title">Un projet en tête ?</h2>
      <p class="cta-text">
        Discutons-en ensemble. Demandez une estimation personnalisée pour votre
        clôture, portail, palissade ou aménagement extérieur.
      </p>
      <a href={`${base}contact/`} class="btn btn-primary">Demander un chiffrage</a>
    </div>
  </Section>
</MainLayout>

<style>
  .section-header {
    margin-bottom: var(--space-8);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .projects-grid-preview {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .projects-grid-preview {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid-preview {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .section-actions {
    margin-top: var(--space-8);
    text-align: center;
  }

  .cta-box {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
  }

  .cta-text {
    margin-bottom: var(--space-6);
    opacity: 0.95;
  }

  .prose {
    max-width: 70ch;
    margin-inline: auto;
    color: var(--color-text);
    line-height: var(--leading-relaxed);
  }

  .prose p + p {
    margin-top: var(--space-4);
  }

  .about-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    max-width: 80ch;
    margin-inline: auto;
  }

  .about-logo {
    width: 100%;
    max-width: 264px;
    height: auto;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .about-content {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
    }

    .about-logo {
      max-width: 288px;
    }
  }

</style>
