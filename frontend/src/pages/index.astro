---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import ArrowDivider from '../components/ArrowDivider.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import logo from '../assets/pepito-logo.svg';
import isoCloture from '../assets/iso/cloture-rigide.webp';
import isoGrillage from '../assets/iso/grillage.webp';
import isoPalissade from '../assets/iso/palissade.webp';
import isoPortail from '../assets/iso/portail.webp';
import isoMotorisation from '../assets/iso/motorisation.webp';
import isoMinipelle from '../assets/iso/minipelle.webp';

import heroCloture from '../assets/hero/cloture-rigide-sousbassement.webp';
import GateScene from '../components/GateScene.astro';
import { getSite } from '../lib/site.js';
import { getProjects } from '../lib/api.js';
import type { Project, Service } from '../data/types';

const { settings, services, slides } = await getSite();
const projects = await getProjects();
const previewProjects = projects.slice(0, 3);
const base = import.meta.env.BASE_URL;

// ── Thème « Signature » : contenu de la landing produit ──
// Tout le texte de la page est regroupé ici pour être facile à modifier.
const signature = {
  heroTitle: 'La Clôture Rigide avec Sous-bassement Béton',
  // Photos du hero : diaporama en fondu (~5 s/image, cycle 30 s pour 6).
  // Liste vide = repli auto sur la réalisation « sous-bassement ».
  heroImages: [
    heroCloture.src,
    '/uploads/fb-import/lot-086/lot-086-01-hd.webp',
    '/uploads/fb-import/lot-021/lot-021-01-hd.webp',
  ],
  heroSubtitle:
    'Sécurisez et valorisez votre propriété avec notre solution de clôture grillagée robuste, surélevée sur des plaques de béton de protection contre l’humidité et le passage d’animaux.',
  ctaPrimary: { label: 'Découvrir nos réalisations', href: `${base}realisations/` },
  ctaSecondary: { label: 'Nous contacter', href: `${base}contact/` },
  activitiesTitle: 'Nos activités',
  activities: [
    { img: isoGrillage, label: 'Grillage souple' },
    { img: isoCloture, label: 'Clôture rigide' },
    { img: isoPalissade, label: 'Palissade occultante' },
    { img: isoPortail, label: 'Portails & portillons' },
    { img: isoMotorisation, label: 'Motorisation' },
    { img: isoMinipelle, label: 'Terrassement mini-pelle' },
  ],
  benefitsTitle: 'Pourquoi choisir notre clôture avec sous-bassement béton ?',
  benefits: [
    {
      icon: 'shield',
      title: 'Robustesse maximale',
      text: 'Sécurité, rigidité — les plaques béton stabilisent la clôture et retiennent la terre.',
    },
    {
      icon: 'finish',
      title: 'Finition parfaite et propre',
      text: 'Pas d’entretien de coupe en lisière de grillage — propreté et délimitation claire.',
    },
    {
      icon: 'clock',
      title: 'Longévité exceptionnelle',
      text: 'Anti-humidité : pas de contact du métal avec le sol humide, résistant aux intempéries.',
    },
  ],
  processTitle: 'Notre processus de pose en 5 étapes',
  steps: [
    { title: 'Étude & traçage', text: 'Analyse du terrain, alignement, repères.' },
    { title: 'Terrassement', text: 'Petites excavations pour les poteaux à la mini-pelle.' },
    {
      title: 'Scellement & sous-bassement',
      text: 'Mise en place des poteaux et glissement des plaques de sous-bassement béton.',
    },
    { title: 'Pose des panneaux', text: 'Installation et fixation des grilles en acier rigide.' },
    { title: 'Réception', text: 'Ajustements finaux — chantier livré clé en main.' },
  ],
  installsTitle: 'Nos dernières installations',
};

// Photo du hero Signature : de préférence la réalisation « sous-bassement »
// la plus récente (le produit de la landing), sinon « rigide », sinon la
// première avec image. « Récent » = sortOrder maximal (tri de l'API :
// sortOrder ASC puis createdAt DESC).
const hasImg = (p: Project) => p.images?.length || p.imageUrl;
const haystack = (p: Project) => `${p.title} ${(p.tags || []).join(' ')}`;
const bestMatch = (re: RegExp) =>
  projects
    .filter((p: Project) => hasImg(p) && re.test(haystack(p)))
    .sort((a: Project, b: Project) => b.sortOrder - a.sortOrder)[0];
const sigHeroProject =
  bestMatch(/sous?-?bassement/i) ||
  bestMatch(/rigide/i) ||
  projects.find((p: Project) => hasImg(p));
const sigHeroImgs = signature.heroImages.length
  ? signature.heroImages
  : [sigHeroProject?.images?.[0]?.imageUrl || sigHeroProject?.imageUrl].filter(Boolean);

// Entité locale canonique (@id #business, référencée par les pages villes
// et réalisations). sameAs relie la fiche Google et les réseaux au site —
// Google s'en sert pour associer l'entité web à la fiche Business Profile.
const siteUrl = settings.siteUrl.replace(/\/$/, '');
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${siteUrl}/#business`,
  name: settings.name,
  url: siteUrl,
  image: `${siteUrl}/pepito-logo.svg`,
  ...(settings.contact.phone && { telephone: settings.contact.phone }),
  ...(settings.contact.email && { email: settings.contact.email }),
  ...(settings.contact.address && {
    address: { '@type': 'PostalAddress', streetAddress: settings.contact.address, addressCountry: 'FR' },
  }),
  ...(settings.contact.serviceArea && { areaServed: settings.contact.serviceArea }),
  ...(settings.sameAs?.length && { sameAs: settings.sameAs }),
}];
---

<MainLayout
  title={settings.name}
  description={settings.description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <HeroSlideshow settings={settings} projects={projects} slides={slides} />

  <ArrowDivider
    background="var(--color-surface)"
    prolongement
  />

  {/* GateScroll en pause — remonter ce composant autour de #a-propos pour réactiver le portail au scroll */}
  <Section id="a-propos" class="section-alt">
    <div class="section-header">
      <h2 class="section-title">À propos de Pépito Services</h2>
      <p class="section-subtitle">
        Une entreprise artisanale au service de vos projets extérieurs.
      </p>
    </div>

    <div class="about-content">
      <img
        src={logo.src}
        alt="Pépito Services"
        class="about-logo"
        loading="lazy"
      />
      <div class="prose">
        <p>{settings.aboutText || settings.description}</p>
      </div>
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-surface)"
    background="var(--color-cream)"
  />

  <Section id="services" class="section-cream">
    <div class="section-header">
      <h2 class="section-title">Nos services</h2>
      <p class="section-subtitle">
        Des solutions de clôture, portails et aménagements extérieurs sur
        mesure, à adapter ensemble selon votre terrain et vos envies.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service: Service, i: number) => <ServiceCard service={service} index={i} />)}
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-cream)"
    background="var(--color-surface)"
  />

  <Section id="realisations" class="section-alt">
    <div class="section-header">
      <h2 class="section-title">Quelques réalisations</h2>
      <p class="section-subtitle">
        Découvrez un aperçu de nos chantiers réalisés sur mesure,
        du terrain à la pose.
      </p>
    </div>

    <div class="projects-grid-preview">
      {previewProjects.map((project: Project) => <ProjectCard project={project} />)}
    </div>

    <div class="section-actions">
      <a href={`${base}realisations/`} class="btn btn-secondary">Voir toutes les réalisations</a>
    </div>
  </Section>

  <ArrowDivider
    fill="var(--color-surface)"
    background="var(--color-secondary)"
  />

  <Section class="section-cta">
    <div class="cta-box">
      <h2 class="section-title">Un projet en tête ?</h2>
      <p class="cta-text">
        Discutons-en ensemble. Demandez une estimation personnalisée pour votre
        clôture, portail, palissade ou aménagement extérieur.
      </p>
      <a href={`${base}contact/`} class="btn btn-primary">Demander un chiffrage</a>
    </div>
  </Section>

  {/* ── Thème « Signature » : landing produit (visible uniquement sous
      data-theme='signature', masquée via theme-signature.css) ── */}
  <div class="signature-home">
    <section class="sig-hero">
      <div class="container sig-hero__grid">
        <div class="sig-hero__content">
          <h1>{signature.heroTitle}</h1>
          <p class="sig-hero__sub">{signature.heroSubtitle}</p>
          <div class="sig-hero__actions">
            <a href={signature.ctaPrimary.href} class="sig-btn sig-btn--primary">
              {signature.ctaPrimary.label}
            </a>
            <a href={signature.ctaSecondary.href} class="sig-btn sig-btn--ghost">
              {signature.ctaSecondary.label}
            </a>
          </div>
        </div>
        <div class="sig-hero__visual">
          {sigHeroImgs.length > 0 && (
            <div class="sig-hero__photo">
              {sigHeroImgs.map((src, i) => (
                <img
                  src={src}
                  alt={i === 0 ? 'Clôture rigide posée par Pépito Services' : ''}
                  aria-hidden={i === 0 ? undefined : 'true'}
                  style={`--d:${(i * 30) / sigHeroImgs.length}s`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ))}
            </div>
          )}
        </div>
      </div>
      {/* Pictos des activités circulant le long de la courbe du bas, en
          léger surplomb du diaporama (positionnés par JS, desktop ≥900px) */}
      <div class="sig-hero__orbit" aria-hidden="true">
        {signature.activities.map((a) => (
          <span class="sig-hero__orbit-item">
            <img src={a.img.src} alt="" loading="eager" />
            <span class="sig-hero__orbit-label">{a.label}</span>
          </span>
        ))}
      </div>
      <div class="sig-hero__veil" aria-hidden="true"></div>
    </section>

    <GateScene />

    <div class="sig-scrollpath">
      <svg class="sig-scrollpath__svg" aria-hidden="true" preserveAspectRatio="none">
        <path class="sig-scrollpath__path" />
      </svg>
      <div class="sig-scrollpath__sticky">
        <div class="sig-scrollpath__inner">
          <section class="sig-benefits">
      <div class="container">
        <h2 class="sig-title">{signature.benefitsTitle}</h2>
        <div class="sig-benefits__grid">
          {signature.benefits.map((b) => (
            <div class="sig-benefit">
              <span class="sig-benefit__icon" aria-hidden="true">
                {b.icon === 'shield' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z" />
                    <path d="M9 12l2 2 4-4" />
                  </svg>
                )}
                {b.icon === 'finish' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 20l4-1 11-11a2.1 2.1 0 0 0-3-3L5 16l-1 4z" />
                    <path d="M13.5 6.5l3 3" />
                  </svg>
                )}
                {b.icon === 'clock' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="13" r="8" />
                    <path d="M12 9v4l2.5 2.5" />
                    <path d="M9 2h6" />
                  </svg>
                )}
              </span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sig-process">
      <div class="container">
        <h2 class="sig-title">{signature.processTitle}</h2>
        <ol class="sig-steps">
          {signature.steps.map((s, i) => (
            <li class="sig-step">
              <span class="sig-step__chev" aria-hidden="true">{i + 1}.</span>
              <div class="sig-step__body">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
        </div>
      </div>
    </div>

    <section class="sig-activities container" id="activites">
      <h2 class="sig-title">{signature.activitiesTitle}</h2>
      <ul class="sig-activities__row">
        {signature.activities.map((a) => (
          <li class="sig-activity">
            <img src={a.img.src} alt="" aria-hidden="true" loading="lazy" />
            <span>{a.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="sig-installs container">
      <h2 class="sig-title">{signature.installsTitle}</h2>
      <div class="projects-grid-preview">
        {previewProjects.map((project: Project) => <ProjectCard project={project} />)}
      </div>
      <div class="sig-installs__more">
        <a href={`${base}realisations/`} class="sig-btn sig-btn--primary">Voir toutes les réalisations</a>
      </div>
    </section>
  </div>

  <script>
    // Pictos des activités roulant le long de la courbe concave du hero
    // Signature. L'ellipse RÉELLE du ::after est échantillonnée en 49
    // keyframes (transform + opacity) joués par element.animate() :
    // animation DÉCLARATIVE → compositée GPU, y compris dans Firefox où
    // le JS par frame ne l'est jamais (cause des saccades). Le fondu
    // entrée/sortie est en opacity par item — pas de mask-image sur le
    // conteneur, qui forçait le repaint du groupe à chaque frame.
    const sigHero = document.querySelector('.sig-hero');
    const sigOrbit = sigHero?.querySelector('.sig-hero__orbit');
    if (sigHero && sigOrbit) {
      const icons = Array.from(sigOrbit.querySelectorAll<HTMLElement>('.sig-hero__orbit-item'));
      const mqDesktop = window.matchMedia('(min-width: 900px)');
      const mqReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const SPEED = 0.028; // fraction de la largeur du hero parcourue / s
      const SPAN = 1.25; // amplitude de la boucle (× largeur du hero)
      const KEYS = 48; // points du chemin précalculé
      let W = 0, cx = 0, cy = 0, rx = 1, ry = 1;
      let T = 45000, range = 0;
      let dragPx = 0, dragging = false, dragX = 0;
      let anims: Animation[] = [];
      let dims: { w: number; h: number }[] = [];

      // Géométrie de l'ellipse ::after : son bord supérieur forme l'arc
      // visible sous le hero. Dimensions des items mises en cache ici
      // (relues au resize) pour ne pas forcer de layout à chaque frame.
      const measure = () => {
        const cs = getComputedStyle(sigHero, '::after');
        W = sigHero.clientWidth;
        rx = parseFloat(cs.width) / 2;
        ry = parseFloat(cs.height) / 2;
        cx = parseFloat(cs.left) + rx;
        cy = parseFloat(cs.top) + ry;
        range = SPAN * W;
        T = (range / (SPEED * W)) * 1000;
        // Le picto est carré (aspect-ratio: 1) : sa hauteur vaut sa largeur.
        dims = icons.map((item) => {
          const w = item.offsetWidth;
          return { w, h: w };
        });
      };

      // Ordonnée du bord supérieur de l'ellipse à l'abscisse x.
      const arcY = (x: number) => {
        const t = (x - cx) / rx;
        return cy - ry * Math.sqrt(Math.max(0, 1 - t * t));
      };

      // Fondus en smoothstep. Sens gauche → droite : sortie à droite en
      // longue dissolution sur ~30 % de la largeur, nulle dès que le
      // picto approche le bord — aucune coupure nette à l'overflow.
      const smooth = (t: number) => t * t * (3 - 2 * t);
      const fade = (sx: number) => {
        const finLeft = smooth(Math.min(1, Math.max(0, (sx + 0.02 * W) / (0.12 * W))));
        const foutRight = smooth(Math.min(1, Math.max(0, (0.95 * W - sx) / (0.3 * W))));
        return Math.min(finLeft, foutRight);
      };

      // Transform de l'item à l'abscisse sx : base du picto légèrement
      // sous l'arc (~85 % de sa hauteur chevauche la photo), le libellé
      // flotte sous la courbe.
      const place = (item: HTMLElement, d: { w: number; h: number }, sx: number) => {
        item.style.transform = `translate3d(${(sx - d.w / 2).toFixed(2)}px, ${(
          arcY(sx) - d.h * 0.85
        ).toFixed(2)}px, 0)`;
        item.style.opacity = fade(sx).toFixed(3);
      };

      // Progression 0→1 = gauche → droite. Items tous de même taille :
      // un seul tableau de keyframes partagé.
      const buildFrames = (d: { w: number; h: number }) => {
        const frames: Keyframe[] = [];
        for (let k = 0; k <= KEYS; k++) {
          const sx = (k / KEYS) * range - 0.1 * W;
          frames.push({
            transform: `translate3d(${(sx - d.w / 2).toFixed(2)}px, ${(
              arcY(sx) - d.h * 0.85
            ).toFixed(2)}px, 0)`,
            opacity: fade(sx).toFixed(3),
          });
        }
        return frames;
      };

      // Délai de l'item i : déphasage régulier + décalage du drag,
      // replié dans (-T, 0] pour rester négatif (boucle continue).
      const delayOf = (i: number) => {
        const raw = (-i * T) / icons.length - (dragPx * T) / range;
        return ((raw % T) + T) % T - T;
      };

      const apply = () => {
        anims.forEach((a) => a.cancel());
        anims = [];
        if (mqReduced.matches) {
          // Reduced motion : pictos répartis statiquement sur l'arc.
          const spacing = range / icons.length;
          icons.forEach((item, i) => {
            let sx = ((i * spacing + dragPx) % range + range) % range - 0.1 * W;
            place(item, dims[i] ?? { w: 0, h: 0 }, sx);
          });
          return;
        }
        const frames = buildFrames(dims[0] ?? { w: 0, h: 0 });
        icons.forEach((item, i) => {
          anims.push(
            item.animate(frames, {
              duration: T,
              iterations: Infinity,
              delay: delayOf(i),
            })
          );
        });
      };

      const update = () => {
        if (!mqDesktop.matches) {
          anims.forEach((a) => a.cancel());
          anims = [];
          sigOrbit.classList.remove('is-running');
          return;
        }
        sigOrbit.classList.add('is-running');
        measure();
        apply();
      };

      // Drag : clic maintenu → pause des animations + décalage du
      // currentTime de chaque item ; le défilement reprend au relâchement
      // depuis la position tirée.
      sigOrbit.addEventListener('pointerdown', (e) => {
        dragging = true;
        dragX = (e as PointerEvent).clientX;
        anims.forEach((a) => a.pause());
        sigOrbit.classList.add('is-dragging');
        e.preventDefault(); // empêche le drag natif de l'image
      });
      window.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - dragX;
        dragX = e.clientX;
        dragPx += dx;
        const dms = (dx * T) / range; // px → ms sur la timeline
        anims.forEach((a) => {
          a.currentTime = (((Number(a.currentTime) || 0) + dms) % T + T) % T;
        });
        if (mqReduced.matches) {
          const spacing = range / icons.length;
          icons.forEach((item, i) => {
            let sx = (((i * spacing + dragPx) % range) + range) % range - 0.1 * W;
            place(item, dims[i] ?? { w: 0, h: 0 }, sx);
          });
        }
      });
      const endDrag = () => {
        dragging = false;
        anims.forEach((a) => a.play());
        sigOrbit.classList.remove('is-dragging');
      };
      window.addEventListener('pointerup', endDrag);
      window.addEventListener('pointercancel', endDrag);

      mqDesktop.addEventListener('change', update);
      mqReduced.addEventListener('change', update);
      window.addEventListener('resize', () => {
        if (!mqDesktop.matches) return;
        measure();
        apply();
      });
      update();
    }

    // Ligne épaisse pilotée par le scroll : descend le bord gauche de
    // l'écran pendant les arguments, vire à droite au niveau du ruban
    // et le « devient » — le clip-path de .sig-steps révèle chaque
    // chevron quand la pointe du trait l'atteint. Mobile : tracé
    // vertical simple, étapes révélées de haut en bas. Reduced motion :
    // pas de ligne, ruban visible normalement.
    const scrollPath = document.querySelector<HTMLElement>('.sig-scrollpath');
    const svgEl = scrollPath?.querySelector<SVGElement>('.sig-scrollpath__svg');
    const pathEl = scrollPath?.querySelector<SVGPathElement>('.sig-scrollpath__path');
    const innerEl = scrollPath?.querySelector<HTMLElement>('.sig-scrollpath__inner');
    const stepsEl = scrollPath?.querySelector<HTMLElement>('.sig-steps');
    if (scrollPath && svgEl && pathEl && innerEl && stepsEl) {
      const mqNarrow = window.matchMedia('(max-width: 899px)');
      const mqReducedPath = window.matchMedia('(prefers-reduced-motion: reduce)');
      const chevEl = stepsEl.querySelector<HTMLElement>('.sig-step__chev');
      const X0 = 11; // bord gauche écran ≈ demi-épaisseur du trait
      // Phases de la vue épinglée : temps mort, puis pan du contenu +
      // descente de la ligne, puis ruban horizontal chevron à chevron.
      const HOLD = 0.05;
      const PAN_END = 0.38;
      let dashTotal = 1, downLen = 0, sideLen = 0, endX = 0;
      let ryFinal = 0, panT = 0;

      // Position de mise en page du ruban dans le bloc inner (offsetTop)
      // : constante, insensible au translateY du pan.
      const naturalTop = () => {
        let n = 0;
        let el: HTMLElement | null = stepsEl;
        while (el && el !== innerEl) {
          n += el.offsetTop;
          el = el.offsetParent as HTMLElement | null;
        }
        return n;
      };

      const measurePath = () => {
        const sr = stepsEl.getBoundingClientRect();
        const ir = innerEl.getBoundingClientRect();
        if (mqNarrow.matches) {
          downLen = window.innerHeight;
          pathEl.setAttribute('d', `M ${X0} 0 L ${X0} ${downLen.toFixed(1)}`);
          sideLen = 0;
        } else {
          const vh = window.innerHeight;
          const chevH = chevEl?.offsetHeight ?? 42;
          const stepsTop = naturalTop();
          // Pan : remonte le contenu pour placer le haut du ruban à
          // ~62 % de l'écran — le cadre figé montre le tracé complet.
          panT = Math.max(0, Math.min(stepsTop - vh * 0.6, innerEl.scrollHeight - vh));
          ryFinal = stepsTop - panT + chevH / 2;
          endX = sr.right - ir.left - 4;
          sideLen = Math.max(0, endX - X0);
          pathEl.setAttribute(
            'd',
            `M ${X0} 0 L ${X0} ${ryFinal.toFixed(1)} L ${endX.toFixed(1)} ${ryFinal.toFixed(1)}`
          );
        }
        dashTotal = (mqNarrow.matches ? downLen : ryFinal) + sideLen;
        pathEl.style.strokeDasharray = `${dashTotal}`;
      };

      const smooth01 = (t: number) => {
        const c = Math.min(1, Math.max(0, t));
        return c * c * (3 - 2 * c);
      };

      const drawPath = () => {
        const r = scrollPath.getBoundingClientRect();
        const vh = window.innerHeight;
        let drawn: number;
        // Le SVG (fixed) est clippé sous le haut de la section : la
        // ligne ne peut pas s'afficher par-dessus la vidéo — elle
        // « émerge » du bord inférieur de la vidéo.
        svgEl.style.clipPath = `inset(${Math.max(0, r.top).toFixed(1)}px 0 0 0)`;
        if (mqNarrow.matches) {
          // SVG fixed : visible seulement tant que la section est à
          // l'écran.
          svgEl.style.display = r.top < vh && r.bottom > 0 ? '' : 'none';
          const d0 = vh * 0.3;
          const p = Math.min(1, Math.max(0, (vh - r.top - d0) / (r.height - d0)));
          drawn = p * dashTotal;
          const rev = Math.floor(p * 5.999) / 5;
          stepsEl.style.clipPath = `inset(0 0 ${(100 - rev * 100).toFixed(2)}% 0)`;
        } else {
          // Descente de la ligne PENDANT le scroll normal : 0 quand la
          // piste entre en bas d'écran, 1 (= ryFinal, au coin du futur
          // ruban) quand la page se fige. Continu ensuite avec le
          // virage horizontal pendant le gel.
          svgEl.style.display = r.top < vh && r.bottom > vh ? '' : 'none';
          const a = smooth01(Math.min(1, Math.max(0, (vh - r.top) / vh)));
          const q = Math.min(1, Math.max(0, -r.top / (r.height - vh)));
          const panE = smooth01((q - HOLD) / (PAN_END - HOLD));
          innerEl.style.transform = `translate3d(0, ${(-panT * panE).toFixed(1)}px, 0)`;
          const hfrac = Math.min(1, Math.max(0, (q - PAN_END) / (1 - PAN_END)));
          drawn = a * ryFinal + hfrac * sideLen;
          // Révélation par paliers : le 1er chevron (colonne = 20 %)
          // dès le virage, puis chaque chevron apparaît ENTIER quand la
          // pointe atteint son début — jamais de flèche à moitié
          // découpée à l'arrêt. Le clip transite en douceur (CSS).
          const shown =
            hfrac <= 0 ? 0 : 20 + Math.min(4, Math.floor(hfrac * 5)) * 20;
          stepsEl.style.clipPath = `inset(0 ${(100 - shown).toFixed(2)}% 0 0)`;
        }
        pathEl.style.strokeDashoffset = `${Math.max(0, dashTotal - drawn)}`;
      };

      const syncPath = () => {
        const pinned = !mqReducedPath.matches && !mqNarrow.matches;
        scrollPath.classList.toggle('is-pinned', pinned);
        if (mqReducedPath.matches) {
          svgEl.style.display = 'none';
          stepsEl.style.clipPath = 'none';
          innerEl.style.transform = '';
          return;
        }
        if (!pinned) innerEl.style.transform = '';
        measurePath();
        drawPath();
      };

      window.addEventListener('scroll', drawPath, { passive: true });
      window.addEventListener('resize', syncPath);
      mqNarrow.addEventListener('change', syncPath);
      mqReducedPath.addEventListener('change', syncPath);
      syncPath();
    }
  </script>
</MainLayout>

