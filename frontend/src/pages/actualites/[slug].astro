---
import MainLayout from '../../layouts/MainLayout.astro';
import { getArticle } from '../../lib/api.js';
import Icon from '../../components/Icon.astro';

const preview = Astro.url.searchParams.get('preview') === '1';
const headers = preview ? { cookie: Astro.request.headers.get('cookie') ?? '' } : undefined;
const article = await getArticle(Astro.params.slug ?? '', { preview, headers });
if (!article) {
  return new Response(null, { status: 404, statusText: 'Article introuvable' });
}
const base = import.meta.env.BASE_URL;
const articleImage = article.imageUrl
  ? (article.imageUrl.startsWith('http') ? article.imageUrl : `https://pepito-services.fr${article.imageUrl}`)
  : undefined;
---

<MainLayout
  title={article.title}
  description={article.summary ?? undefined}
  image={articleImage}
  canonicalPath={`/actualites/${article.slug}`}
  noIndex={preview}
>
  {preview && (
    <div class="preview-banner">👁 Prévisualisation — ce brouillon n'est pas publié.</div>
  )}
  <article class="section">
    <div class="container article-container">
      <header class="article-header">
        <h1 class="section-title">{article.title}</h1>
        <time datetime={article.publishedAt ?? article.createdAt} class="article-date">
          {
            new Date(article.publishedAt ?? article.createdAt).toLocaleDateString('fr-FR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
      </header>

      {article.imageUrl && (
        <img src={article.imageUrl} alt={`Illustration de l’article ${article.title}`} class="article-image" />
      )}

      <div class="article-content" set:html={article.content ?? ''} />

      <footer class="article-footer">
        <a href={`${base}actualites/`} class="btn btn-secondary"><Icon name="arrow-left" size={15} /> Retour aux actualités</a>
      </footer>
    </div>
  </article>
</MainLayout>

<style>
  .preview-banner {
    padding: 10px 16px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: #92400e;
    background: #fef3c7;
    border-bottom: 1px solid #f59e0b;
  }

  .article-container {
    max-width: 70ch;
  }

  .article-header {
    margin-bottom: var(--space-8);
  }

  .article-date {
    display: block;
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .article-image {
    width: 100%;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
  }

  .article-content {
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-10);
  }

  .article-footer {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
</style>
