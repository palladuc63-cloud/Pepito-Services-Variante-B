---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/Section.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import CityMap from '../components/CityMap.astro';
import { getSite } from '../lib/site.js';
import { getProjects, getCityPages } from '../lib/api.js';
import type { CityPage } from '../data/types';

const { categories } = await getSite();
const preview = Astro.url.searchParams.get('preview') === '1';
const headers = preview ? { cookie: Astro.request.headers.get('cookie') ?? '' } : undefined;
const [projects, cityPagesRaw] = await Promise.all([getProjects({ preview, headers }), getCityPages()]);
const cityPages = cityPagesRaw as CityPage[];
const base = import.meta.env.BASE_URL;
---

<MainLayout
  title="Réalisations"
  description="Découvrez les réalisations de Pépito Services : clôtures, palissades, portails, portillons et petits terrassements."
  canonicalPath="/realisations"
>
  <Section>
    <div class="page-header">
      <h1 class="section-title">Nos réalisations</h1>
      <p class="section-subtitle">
        Aperçu de chantiers réalisés par Pépito Services :
        clôtures, portails et aménagements extérieurs sur mesure.
      </p>
    </div>

    {preview && (
      <div class="preview-banner">👁 Prévisualisation — les brouillons sont visibles.</div>
    )}
    <ProjectFilter projects={projects} categories={categories} preview={preview} />

    {cityPages.length > 0 && (
      <section class="zone-section">
        <h2 class="section-title">Nos zones d'intervention</h2>
        <p class="section-subtitle">
          Cliquez sur une ville pour découvrir nos réalisations et prestations locales.
        </p>
        <CityMap pages={cityPages} />
        <ul class="zone-links">
          {cityPages.map((c) => (
            <li><a href={`${base}${c.serviceSlug}/${c.slug}/`}>{c.city}</a></li>
          ))}
        </ul>
      </section>
    )}
  </Section>
</MainLayout>

<style>
  .page-header {
    margin-bottom: var(--space-8);
  }

  .zone-section {
    margin-top: var(--space-12);
  }

  .zone-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
  }

  .zone-links a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: inherit;
  }

  .preview-banner {
    padding: 10px 16px;
    margin-bottom: var(--space-6);
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: #92400e;
    background: #fef3c7;
    border: 1px solid #f59e0b;
    border-radius: var(--radius-md);
  }
</style>
