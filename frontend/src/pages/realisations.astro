---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/Section.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import ContentBadge from '../components/ContentBadge.astro';
import { getSite } from '../lib/site.js';
import { getProjects } from '../lib/api.js';

const { categories } = await getSite();
const projects = await getProjects();
---

<MainLayout
  title="Réalisations"
  description="Découvrez les réalisations de Pépito Services : clôtures, palissades, portails, portillons et petits terrassements."
  canonicalPath="/realisations"
>
  <Section>
    <div class="page-header">
      <h1 class="section-title">Nos réalisations</h1>
      <p class="section-subtitle">
        Aperçu de chantiers réalisés par Pépito Services. Les descriptions et
        catégories sont provisoires et seront validées avec l’entreprise.
      </p>
      <ContentBadge />
    </div>

    <ProjectFilter projects={projects} categories={categories} />
  </Section>
</MainLayout>

<style>
  .page-header {
    margin-bottom: var(--space-8);
  }
</style>
