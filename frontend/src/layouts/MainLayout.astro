---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ArrowDivider from '../components/ArrowDivider.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { getSite } from '../lib/site.js';
import type { SeoMeta } from '../data/types';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  seoMeta?: SeoMeta | null;
  jsonLd?: object[];
}

const { title, description, image, canonicalPath, noIndex, seoMeta, jsonLd } = Astro.props;
const { settings } = await getSite();
const umamiSrc = process.env.UMAMI_SCRIPT_URL || import.meta.env.UMAMI_SCRIPT_URL;
const umamiId = process.env.UMAMI_WEBSITE_ID || import.meta.env.UMAMI_WEBSITE_ID;
const umamiHost = umamiSrc ? umamiSrc.replace(/\/[^/]*$/, '') : '';
---

<!doctype html>
<html lang="fr" data-theme="nature">
  <head>
    <script is:inline>
      try {
        var themes = ['nature', 'immersif', 'bento', 'editorial'];
        var fromUrl = new URLSearchParams(location.search).get('theme');
        if (themes.indexOf(fromUrl) !== -1) localStorage.setItem('pepito-theme', fromUrl);
        var t = localStorage.getItem('pepito-theme');
        if (themes.indexOf(t) !== -1) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <ClientRouter />
    <SeoHead
      settings={settings}
      title={title}
      description={description}
      image={image}
      canonicalPath={canonicalPath}
      noIndex={noIndex}
      seoMeta={seoMeta}
      jsonLd={jsonLd}
    />
    <script
      is:inline
      src="https://app.agencepoint.fr/janus.js"
      data-org="pepito-services"
      data-color="#16a34a"
      async
    ></script>
    {umamiSrc && umamiId && (
      <script is:inline defer src={umamiSrc} data-website-id={umamiId} data-host-url={umamiHost}></script>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>
    <Navbar settings={settings} />
    <main id="main-content">
      <slot />
    </main>
    <div class="footer-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 96" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M0 150 L0 52 C75.6 52 104.4 32 180 32 C255.6 32 284.4 52 360 52 C435.6 52 464.4 62 540 62 C615.6 62 644.4 52 720 52 C795.6 52 824.4 32 900 32 C975.6 32 1004.4 52 1080 52 C1155.6 52 1184.4 62 1260 62 C1335.6 62 1364.4 52 1440 52 C1515.6 52 1544.4 32 1620 32 C1695.6 32 1724.4 52 1800 52 C1875.6 52 1904.4 62 1980 62 C2055.6 62 2084.4 52 2160 52 L2160 150 Z"
          fill="var(--copper)"
          opacity="0.55"
        />
        <path
          d="M0 150 L0 62 C100.8 62 139.2 48 240 48 C340.8 48 379.2 62 480 62 C580.8 62 619.2 71 720 71 C820.8 71 859.2 62 960 62 C1060.8 62 1099.2 48 1200 48 C1300.8 48 1339.2 62 1440 62 C1540.8 62 1579.2 71 1680 71 C1780.8 71 1819.2 62 1920 62 C2020.8 62 2059.2 48 2160 48 C2260.8 48 2299.2 62 2400 62 C2500.8 62 2539.2 71 2640 71 C2740.8 71 2779.2 62 2880 62 L2400 150 Z"
          fill="var(--basalt-dark)"
        />
      </svg>
    </div>
    <Footer settings={settings} />
    <ThemeSwitcher />
    <script>
      document.addEventListener('astro:page-load', () => {
        // Le thème immersif gère ses propres animations (GSAP) — pas de reveal ici.
        if (document.documentElement.dataset.theme === 'immersif') return;
        const targets = document.querySelectorAll<HTMLElement>(
          '.section-header, .about-content, .cta-box, .page-header, .card'
        );
        targets.forEach((el, i) => {
          el.classList.add('reveal');
          el.style.setProperty('--reveal-delay', `${Math.min((i % 4) * 70, 210)}ms`);
        });
        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                el.classList.add('is-visible');
                observer.unobserve(el);
                // Libère transform/transition pour que les effets de survol reprennent la main.
                setTimeout(() => el.classList.remove('reveal', 'is-visible'), 900);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      });
    </script>
    <script>
      // ── Thème « Immersif — La Galerie » : Lenis persistant + animations GSAP par page.
      // Librairies chargées à la demande, uniquement quand le thème est actif.
      let __libs: any = null;
      let __libsLoading: Promise<any> | null = null;

      function __loadLibs() {
        if (__libsLoading) return __libsLoading;
        __libsLoading = Promise.all([
          import('lenis'),
          import('gsap'),
          import('gsap/ScrollTrigger'),
          import('split-type'),
        ]).then(([{ default: Lenis }, { gsap }, { ScrollTrigger }, { default: SplitType }]) => {
          gsap.registerPlugin(ScrollTrigger);
          const lenis = new Lenis({ duration: 1.15, smoothWheel: true });
          lenis.on('scroll', ScrollTrigger.update);
          gsap.ticker.add((t: number) => lenis.raf(t * 1000));
          gsap.ticker.lagSmoothing(0);
          __libs = { gsap, ScrollTrigger, SplitType, lenis };
          return __libs;
        });
        return __libsLoading;
      }

      async function __setupImmersifPage() {
        if (document.documentElement.dataset.theme !== 'immersif') return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try {
          const libs = await __loadLibs();
          if (!libs || document.documentElement.dataset.theme !== 'immersif') return;
          const { gsap, ScrollTrigger, SplitType } = libs;

          // Nettoie les triggers de la page précédente (DOM remplacé)
          ScrollTrigger.getAll().forEach((t: any) => t.kill());

          // Titres : reveal lettre par lettre
          document.querySelectorAll<HTMLElement>('.section-title').forEach((t) => {
            const split = new SplitType(t, { types: 'chars' });
            gsap.from(split.chars ?? [], {
              yPercent: 115,
              opacity: 0,
              stagger: 0.018,
              duration: 0.7,
              ease: 'power4.out',
              scrollTrigger: { trigger: t, start: 'top 90%', once: true },
            });
          });

          // Cards & blocs : reveal au scroll
          gsap.utils.toArray('.card, .cta-box, .zone-section, .faq-item').forEach((el: HTMLElement) => {
            gsap.from(el, {
              y: 44,
              opacity: 0,
              duration: 0.9,
              ease: 'power3.out',
              scrollTrigger: { trigger: el, start: 'top 88%', once: true },
            });
          });

          // Parallaxe sur les médias
          gsap.utils.toArray('.card-media img, .article-image').forEach((img: HTMLElement) => {
            gsap.fromTo(img, { yPercent: -8 }, {
              yPercent: 8,
              ease: 'none',
              scrollTrigger: { trigger: img, start: 'top bottom', end: 'bottom top', scrub: 0.6 },
            });
          });

          // Hero : parallaxe + légère réduction en sortie d'écran
          const hero = document.querySelector('.hero-slideshow');
          if (hero) {
            gsap.to(hero, {
              yPercent: 12,
              opacity: 0.75,
              ease: 'none',
              scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
            });
          }
          ScrollTrigger.refresh();
        } catch (e) {
          console.warn('Immersif: effets non chargés', e);
        }
      }

      document.addEventListener('astro:page-load', __setupImmersifPage);
      window.addEventListener('pepito:theme', __setupImmersifPage);
      document.addEventListener('astro:before-swap', () => {
        if (!__libs) return;
        __libs.ScrollTrigger.getAll().forEach((t: any) => t.kill());
        __libs.lenis?.scrollTo(0, { immediate: true, force: true });
      });
    </script>
  </body>
</html>
