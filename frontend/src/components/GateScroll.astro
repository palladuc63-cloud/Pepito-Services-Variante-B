---
import { Image } from 'astro:assets';
import leafLeft from '../assets/gate-scroll-left.webp';
import leafRight from '../assets/gate-scroll-right.webp';
import backdrop from '../assets/gate-scroll-backdrop.webp';
---

<section class="gs" id="portail" data-gs>
  <div class="gs__sticky">
    <div class="gs__back">
      <Image class="gs__backimg" src={backdrop} alt="Portail aluminium anthracite posé par Pépito Services" widths={[960, 1600]} sizes="100vw" loading="lazy" />
      <div class="gs__inner">
        <p class="gs__kicker">Clôtures &amp; portails sur mesure</p>
        <h2 class="gs__title">Entrez, vous êtes chez vous</h2>
        <p class="gs__sub">Chaque entrée mérite un portail à sa hauteur — posé, motorisé, garanti.</p>
        <a class="gs__cta" href="/realisations">Voir nos réalisations</a>
      </div>
    </div>
    <div class="gs__scene" aria-hidden="true">
      <div class="gs__leaf gs__leaf--l"><Image src={leafLeft} alt="" widths={[560]} loading="eager" /></div>
      <div class="gs__leaf gs__leaf--r"><Image src={leafRight} alt="" widths={[560]} loading="eager" /></div>
      <div class="gs__latch"></div>
    </div>
    <p class="gs__hint" aria-hidden="true"><span>Faites défiler pour ouvrir</span></p>
  </div>
</section>

<style>
  .gs { display: none; }
  :global([data-theme='nature']) .gs { display: block; height: 320vh; position: relative; }

  .gs__sticky {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    background: #14181a;
  }

  .gs__back { position: absolute; inset: 0; }
  .gs__backimg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; filter: brightness(.62) saturate(.95);
    transform: scale(1.12); transform-origin: center;
    will-change: transform;
  }

  .gs__inner {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    padding: 0 1.5rem; gap: .9rem;
    opacity: 0; transform: translateY(14px);
    will-change: opacity, transform;
  }
  .gs__kicker {
    margin: 0; font-family: var(--font-heading); font-size: .8rem;
    letter-spacing: .32em; text-transform: uppercase;
    color: #cfe3c9;
  }
  .gs__title {
    margin: 0; font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.6rem); font-weight: 600;
    color: #f5f1e6; letter-spacing: .01em;
    text-shadow: 0 2px 30px rgba(0,0,0,.45);
  }
  .gs__sub {
    margin: 0; max-width: 34rem; color: rgba(245,241,230,.82);
    font-size: clamp(.95rem, 1.6vw, 1.1rem); line-height: 1.55;
  }
  .gs__cta {
    margin-top: .6rem; display: inline-block;
    padding: .8rem 1.9rem; border-radius: 999px;
    background: var(--color-primary, #3a7d44); color: #fff;
    font-weight: 600; font-size: .95rem; text-decoration: none;
    box-shadow: 0 10px 30px rgba(0,0,0,.35);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .gs__cta:hover { transform: translateY(-2px); box-shadow: 0 14px 38px rgba(0,0,0,.4); }

  .gs__scene {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    perspective: 1400px; perspective-origin: 50% 50%;
  }
  .gs__leaf {
    height: min(58vh, 47vw);
    aspect-ratio: var(--ar);
    will-change: transform;
    backface-visibility: hidden;
  }
  .gs__leaf img { display: block; width: 100%; height: 100%; }
  .gs__leaf--l { --ar: 536/463; transform-origin: left center; box-shadow: -18px 0 40px -12px rgba(0,0,0,.55); }
  .gs__leaf--r { --ar: 488/463; transform-origin: right center; box-shadow: 18px 0 40px -12px rgba(0,0,0,.55); }

  .gs__latch {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    width: 10px; height: 9%; border-radius: 4px;
    background: linear-gradient(#6a7076, #3c4045);
    box-shadow: 0 0 0 1px rgba(0,0,0,.4), 0 4px 10px rgba(0,0,0,.45);
    will-change: transform, opacity;
  }

  .gs__hint {
    position: absolute; left: 0; right: 0; bottom: 4.5vh; margin: 0;
    text-align: center; color: rgba(245,241,230,.75);
    font-size: .78rem; letter-spacing: .22em; text-transform: uppercase;
    animation: gs-pulse 2.4s ease-in-out infinite;
    will-change: opacity;
  }
  .gs__hint span { border-bottom: 1px solid rgba(245,241,230,.35); padding-bottom: .35rem; }
  @keyframes gs-pulse { 0%,100% { opacity: .55 } 50% { opacity: 1 } }

  @media (max-width: 640px) {
    .gs__scene { perspective: 900px; }
    .gs__leaf { height: min(44vh, 52vw); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-theme='nature']) .gs { display: none; }
  }
</style>

<script>
  const sections = document.querySelectorAll<HTMLElement>('[data-gs]');
  if (sections.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ease = (t: number) => t < .5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
    const updaters = [...sections].map((sec) => {
      const scene = sec.querySelector<HTMLElement>('.gs__scene')!;
      const l = sec.querySelector<HTMLElement>('.gs__leaf--l')!;
      const r = sec.querySelector<HTMLElement>('.gs__leaf--r')!;
      const latch = sec.querySelector<HTMLElement>('.gs__latch')!;
      const hint = sec.querySelector<HTMLElement>('.gs__hint')!;
      const backimg = sec.querySelector<HTMLElement>('.gs__backimg')!;
      const inner = sec.querySelector<HTMLElement>('.gs__inner')!;
      const fixed = new URLSearchParams(location.search).get('gs');
      if (fixed !== null) {
        const sticky = sec.querySelector<HTMLElement>('.gs__sticky')!;
        sticky.style.position = 'fixed';
        sticky.style.inset = '0';
        sticky.style.zIndex = '9999';
      }
      return () => {
        const rect = sec.getBoundingClientRect();
        const total = rect.height - innerHeight;
        const p = fixed !== null
          ? Math.min(1, Math.max(0, parseFloat(fixed) || 0))
          : Math.min(1, Math.max(0, -rect.top / total));
        if (fixed === null && (rect.bottom < -100 || rect.top > innerHeight + 100)) return;

        const op = ease(Math.min(1, Math.max(0, (p - .12) / .68)));   // ouverture 12%→80%
        const a = op * 104;
        l.style.transform = `rotateY(${a}deg)`;
        r.style.transform = `rotateY(${-a}deg)`;
        scene.style.opacity = a >= 103 ? '0' : '1';

        const lp = Math.min(1, Math.max(0, (p - .04) / .12));         // loquet 4%→16%
        latch.style.transform = `translateY(${-lp * 130}%)`;
        latch.style.opacity = String(1 - lp);

        hint.style.opacity = String(Math.max(0, 1 - p * 5));

        backimg.style.transform = `scale(${1.12 - .12 * op})`;        // traversée : zoom vers l'ouverture
        const ip = Math.min(1, Math.max(0, (op - .45) / .4));         // contenu visible à mi-ouverture
        inner.style.opacity = String(ip);
        inner.style.transform = `translateY(${14 - 14 * ip}px)`;
      };
    });
    let tick = false;
    const onScroll = () => {
      if (tick) return;
      tick = true;
      requestAnimationFrame(() => { updaters.forEach(u => u()); tick = false; });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    onScroll();
  }
</script>
