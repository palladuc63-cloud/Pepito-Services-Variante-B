---
import { Image } from 'astro:assets';
import leafLeft from '../assets/gate-scroll-left.webp';
import leafRight from '../assets/gate-scroll-right.webp';
---

<section class="gs" data-gs>
  <div class="gs__sticky">
    <div class="gs__back">
      <div class="gs__reveal"><slot /></div>
    </div>
    <div class="gs__scene" aria-hidden="true">
      <div class="gs__leaf gs__leaf--l"><Image src={leafLeft} alt="" widths={[560]} loading="eager" /></div>
      <div class="gs__leaf gs__leaf--r"><Image src={leafRight} alt="" widths={[560]} loading="eager" /></div>
    </div>
    <p class="gs__hint" aria-hidden="true"><span>Faites défiler pour ouvrir</span></p>
  </div>
</section>

<style>
  .gs { display: contents; }
  .gs__scene, .gs__hint { display: none; }

  :global([data-theme='nature']) .gs {
    display: block; height: 240vh; position: relative;
  }

  :global([data-theme='nature']) .gs__sticky {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    background: var(--color-surface, #f3efe5);
  }

  :global([data-theme='nature']) .gs__back {
    position: absolute; inset: 0; overflow: hidden;
  }
  .gs__reveal {
    min-height: 100%; display: flex; flex-direction: column;
    justify-content: center; will-change: transform;
  }
  :global([data-theme='nature']) .gs__reveal > :global(.section) {
    min-height: 100vh; display: flex; flex-direction: column;
    justify-content: center;
  }

  :global([data-theme='nature']) .gs__scene {
    display: flex; position: absolute; inset: 0;
    align-items: center; justify-content: center;
    perspective: 1400px; perspective-origin: 50% 50%;
    pointer-events: none;
  }
  .gs__leaf {
    height: min(58vh, 47vw);
    aspect-ratio: 512/463;
    will-change: transform;
    backface-visibility: hidden;
  }
  .gs__leaf img { display: block; width: 100%; height: 100%; }
  .gs__leaf--l { transform-origin: left center; box-shadow: -18px 0 40px -12px rgba(0,0,0,.55); }
  .gs__leaf--r { transform-origin: right center; box-shadow: 18px 0 40px -12px rgba(0,0,0,.55); }

  :global([data-theme='nature']) .gs__hint {
    display: block;
    position: absolute; left: 0; right: 0; bottom: 4.5vh; margin: 0;
    text-align: center; color: rgba(60,70,60,.75);
    font-size: .78rem; letter-spacing: .22em; text-transform: uppercase;
    will-change: opacity;
  }
  .gs__hint span {
    border-bottom: 1px solid rgba(60,70,60,.35); padding-bottom: .35rem;
    animation: gs-pulse 2.4s ease-in-out infinite; display: inline-block;
  }
  @keyframes gs-pulse { 0%,100% { opacity: .55 } 50% { opacity: 1 } }

  @media (max-width: 640px) {
    :global([data-theme='nature']) .gs__scene { perspective: 900px; }
    .gs__leaf { height: min(44vh, 52vw); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-theme='nature']) .gs { display: contents; }
    :global([data-theme='nature']) .gs__scene,
    :global([data-theme='nature']) .gs__hint { display: none; }
  }
</style>

<script>
  const sections = document.querySelectorAll<HTMLElement>('[data-gs]');
  if (sections.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ease = (t: number) => t < .5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
    const updaters = [...sections].map((sec) => {
      const scene = sec.querySelector<HTMLElement>('.gs__scene')!;
      const l = sec.querySelector<HTMLElement>('.gs__leaf--l')!;
      const r = sec.querySelector<HTMLElement>('.gs__leaf--r')!;
      const hint = sec.querySelector<HTMLElement>('.gs__hint')!;
      const back = sec.querySelector<HTMLElement>('.gs__back')!;
      const reveal = sec.querySelector<HTMLElement>('.gs__reveal')!;
      const fixed = new URLSearchParams(location.search).get('gs');
      if (fixed !== null) {
        const sticky = sec.querySelector<HTMLElement>('.gs__sticky')!;
        sticky.style.position = 'fixed';
        sticky.style.inset = '0';
        sticky.style.zIndex = '9999';
      }
      return () => {
        if (getComputedStyle(sec).display === 'contents') return;
        const rect = sec.getBoundingClientRect();
        const total = rect.height - innerHeight;
        const p = fixed !== null
          ? Math.min(1, Math.max(0, parseFloat(fixed) || 0))
          : Math.min(1, Math.max(0, -rect.top / total));
        if (fixed === null && (rect.bottom < -100 || rect.top > innerHeight + 100)) return;

        const op = ease(Math.min(1, Math.max(0, (p - .08) / .52)));   // ouverture 8%→60%
        const a = op * 104;
        l.style.transform = `rotateY(${a}deg)`;
        r.style.transform = `rotateY(${-a}deg)`;
        scene.style.opacity = a >= 103 ? '0' : '1';

        hint.style.opacity = String(Math.max(0, 1 - p * 5));

        // fin de course : le contenu défile dans le cadre s'il dépasse
        const over = Math.max(0, reveal.scrollHeight - back.clientHeight);
        const ip = Math.min(1, Math.max(0, (p - .62) / .38));
        reveal.style.transform = over > 0 ? `translateY(${-over * ip}px)` : '';
      };
    });
    let tick = false;
    const onScroll = () => {
      if (tick) return;
      tick = true;
      requestAnimationFrame(() => { updaters.forEach(u => u()); tick = false; });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    onScroll();
  }
</script>
