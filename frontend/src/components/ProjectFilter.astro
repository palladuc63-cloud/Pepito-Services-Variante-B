---
import type { Project, Category } from '../data/types';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
import { categoryIcon } from '../lib/icons';

export interface Props {
  projects: Project[];
  categories: Category[];
  preview?: boolean;
}

const { projects, categories, preview = false } = Astro.props;
---

<div class="project-filter">
  <div class="filter-bar" role="group" aria-label="Filtrer les réalisations par catégorie">
    <button
      type="button"
      class="filter-btn is-active"
      data-filter="all"
      aria-pressed="true"
    >
      <Icon name="grid" size={15} />
      Toutes
    </button>
    {
      categories.map((category) => (
        <button
          type="button"
          class="filter-btn"
          data-filter={category.slug}
          aria-pressed="false"
        >
          <Icon name={categoryIcon(category.slug)} size={15} />
          {category.label}
        </button>
      ))
    }
    <span class="filter-chip" id="filter-chip" hidden>
      Type : <strong id="filter-chip-label"></strong>
      <button type="button" id="filter-chip-clear" aria-label="Retirer le filtre de type">×</button>
    </span>
  </div>

  <div class="project-grid">
    {projects.map((project) => <ProjectCard project={project} showDraft={preview} />)}
  </div>

  <p class="filter-empty" id="filter-empty" role="status" hidden>
    Aucune réalisation ne correspond à ce filtre.
  </p>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const projectCards = document.querySelectorAll<HTMLElement>('.project-card');
    const emptyMessage = document.getElementById('filter-empty') as HTMLParagraphElement | null;

    // Renumérote les cards visibles : :nth-child compte aussi les
    // cards masquées par le filtre, ce qui déséquilibrait la grille.
    const renumber = () => {
      const visible = Array.from(
        document.querySelectorAll<HTMLElement>('.project-grid > .project-card:not([hidden])')
      );
      if (!visible.length) return;
      const grid = visible[0].closest('.project-grid');
      grid?.classList.add('pg-numbered');
      document
        .querySelectorAll<HTMLElement>('.project-grid > .project-card')
        .forEach((c) => c.classList.remove('pg1', 'pg2', 'pg3', 'pg4', 'pg5', 'pg6'));
      visible.forEach((c, i) => c.classList.add(`pg${(i % 6) + 1}`));
    };

    const updateEmptyState = () => {
      if (!emptyMessage) return;
      const visibleCards = document.querySelectorAll('.project-card:not([hidden])');
      emptyMessage.hidden = visibleCards.length > 0;
    };

    const tagChip = document.getElementById('filter-chip') as HTMLSpanElement | null;
    const tagChipLabel = document.getElementById('filter-chip-label');
    const tagChipClear = document.getElementById('filter-chip-clear');

    const params = new URLSearchParams(window.location.search);
    let activeCat = params.get('categorie') ?? 'all';
    let activeTag = params.get('tag');
    if (activeCat !== 'all' && !document.querySelector(`.filter-btn[data-filter="${activeCat}"]`)) {
      activeCat = 'all';
    }

    const applyFilters = () => {
      filterButtons.forEach((btn) => {
        const match = (btn.dataset.filter ?? 'all') === activeCat;
        btn.classList.toggle('is-active', match);
        btn.setAttribute('aria-pressed', String(match));
      });
      if (tagChip) {
        tagChip.hidden = !activeTag;
        if (activeTag && tagChipLabel) tagChipLabel.textContent = activeTag;
      }
      projectCards.forEach((card) => {
        const cat = card.dataset.category;
        const tags = (card.dataset.tags ?? '').split('|');
        const show =
          (activeCat === 'all' || cat === activeCat) &&
          (!activeTag || tags.includes(activeTag));
        card.hidden = !show;
      });
      renumber();
      updateEmptyState();
    };

    const syncUrl = () => {
      const url = new URL(window.location.href);
      if (activeCat === 'all') url.searchParams.delete('categorie');
      else url.searchParams.set('categorie', activeCat);
      if (activeTag) url.searchParams.set('tag', activeTag);
      else url.searchParams.delete('tag');
      history.replaceState(null, '', url);
    };

    // Changer de catégorie efface le sous-type : il peut ne pas exister
    // dans la nouvelle catégorie.
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCat = button.dataset.filter ?? 'all';
        activeTag = null;
        applyFilters();
        syncUrl();
      });
    });

    tagChipClear?.addEventListener('click', () => {
      activeTag = null;
      applyFilters();
      syncUrl();
    });

    applyFilters();
  });
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--transition-fast),
      border-color var(--transition-fast), color var(--transition-fast);
  }

  .filter-btn:hover,
  .filter-btn:focus-visible {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .filter-btn.is-active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--cta-text);
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: var(--space-2) var(--space-4);
    background-color: var(--tag-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--tag-color);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: capitalize;
  }

  .filter-chip button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
  }

  .filter-chip button:hover,
  .filter-chip button:focus-visible {
    background-color: var(--color-primary);
    color: var(--cta-text);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .filter-empty {
    padding: var(--space-8);
    text-align: center;
    color: var(--color-text-muted);
    background-color: var(--color-surface-soft);
    border-radius: var(--radius-md);
  }
</style>
