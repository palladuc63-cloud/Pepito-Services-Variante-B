---
import type { ImageMetadata } from 'astro';

export interface Props {
  fill?: string;
  background?: string;
  height?: string;
  direction?: 'down' | 'up';
  image?: ImageMetadata | string;
  syncWithHero?: boolean;
  prolongement?: boolean;
}

const {
  fill = 'currentColor',
  background = 'transparent',
  height = '80px',
  direction = 'down',
  image,
  syncWithHero = false,
  prolongement = false,
} = Astro.props;

const imageSrc =
  typeof image === 'string' ? image : image?.src ?? null;

const svgPath =
  direction === 'down'
    ? 'M0 0 L50 100 L100 0 Z'
    : 'M0 100 L50 0 L100 100 Z';

const clipPath =
  direction === 'down'
    ? 'polygon(0 0, 50% 100%, 100% 0)'
    : 'polygon(0 100%, 50% 0, 100% 100%)';

const maskId = `arrow-mask-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['arrow-divider', { 'arrow-divider--prolongement': prolongement }]}
  aria-hidden="true"
  style={`height: ${height}; background-color: ${
    prolongement ? 'transparent' : background
  }; ${prolongement ? `margin-top: calc(-${height} + 0.2px);` : ''}`}
  data-hero-divider={syncWithHero ? 'true' : undefined}
>
  {
    prolongement ? (
      <svg
        class="arrow-divider__svg"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <mask id={maskId}>
            <rect x="0" y="0" width="100" height="100" fill="white" />
            <path d={svgPath} fill="black" />
          </mask>
        </defs>
        <rect
          x="0"
          y="0"
          width="100"
          height="100"
          fill={background}
          mask={`url(#${maskId})`}
        />
      </svg>
    ) : imageSrc ? (
      <img
        class="arrow-divider__image"
        src={imageSrc}
        alt=""
        loading="eager"
        decoding="sync"
        style={`clip-path: ${clipPath};`}
      />
    ) : (
      <svg
        class="arrow-divider__svg"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d={svgPath} style={`fill: ${fill};`} />
      </svg>
    )
  }
</div>

{syncWithHero && (
  <script>
    (function () {
      function updateDividerImage(src: string) {
        document
          .querySelectorAll('[data-hero-divider] .arrow-divider__image')
          .forEach((img) => img.setAttribute('src', src));
      }

      window.addEventListener('heroSlideChange', (event: Event) => {
        const customEvent = event as CustomEvent<{ src?: string }>;
        if (customEvent.detail?.src) {
          updateDividerImage(customEvent.detail.src);
        }
      });
    })();
  </script>
)}

<style>
  .arrow-divider {
    position: relative;
    z-index: 2;
    width: 100%;
    display: block;
    line-height: 0;
    overflow: hidden;
  }

  .arrow-divider--prolongement {
    z-index: 4;
  }

  .arrow-divider__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .arrow-divider__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
</style>
