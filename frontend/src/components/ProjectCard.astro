---
import type { Project } from '../data/types';
import ContentBadge from './ContentBadge.astro';

export interface Props {
  project: Project;
  categoryLabel?: string;
  logoVariants?: string[];
}

const { project, categoryLabel: customCategoryLabel, logoVariants } = Astro.props;
const categoryLabel = customCategoryLabel ?? project.category?.label ?? 'Réalisation';
---

<article class="card project-card" data-category={project.category?.slug ?? ''} id={project.slug}>
  <div class:list={['card-media', { 'card-media--logo': logoVariants }] }>
    {logoVariants ? (
      <img
        src={logoVariants[0]}
        alt={`Aperçu de la réalisation ${project.title}`}
        class="logo-mockup"
        data-logo-mockup
        data-logo-0={logoVariants[0]}
        data-logo-1={logoVariants[1]}
        data-logo-2={logoVariants[2]}
        data-logo-3={logoVariants[3]}
        loading="lazy"
      />
    ) : project.imageUrl ? (
      <img
        src={project.imageUrl}
        alt={`Aperçu de la réalisation ${project.title}`}
        loading="lazy"
      />
    ) : null}
  </div>
  <div class="card-body">
    <span class="project-category">{categoryLabel}</span>
    <h3 class="card-title">{project.title}</h3>
    <p class="card-text">{project.summary}</p>
    <div class="project-footer">
      <ContentBadge />
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-media--mockup {
    position: relative;
  }

  .card-media--logo {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-surface);
  }

  .logo-mockup {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mockup-thumbnail {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 30%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 3px solid var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .mockup-thumbnail :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-category {
    display: inline-block;
    width: fit-content;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-secondary);
    background-color: var(--color-secondary-light);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .project-footer {
    margin-top: auto;
    padding-top: var(--space-4);
  }
</style>
