---
import type { Project } from '../data/types';
import ContentBadge from './ContentBadge.astro';

export interface Props {
  project: Project;
  categoryLabel?: string;
}

const { project, categoryLabel: customCategoryLabel } = Astro.props;
const categoryLabel = customCategoryLabel ?? project.category?.label ?? 'Réalisation';
---

<article class="card project-card" data-category={project.category?.slug ?? ''} id={project.slug}>
  <div class="card-media">
    {project.imageUrl ? (
      <img
        src={project.imageUrl}
        alt={`Aperçu de la réalisation ${project.title}`}
        loading="lazy"
      />
    ) : null}
  </div>
  <div class="card-body">
    <span class="project-category">{categoryLabel}</span>
    <h3 class="card-title">{project.title}</h3>
    <p class="card-text">{project.summary}</p>
    <div class="project-footer">
      <ContentBadge />
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-category {
    position: relative;
    display: inline-block;
    width: fit-content;
    padding: var(--tag-pad);
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tag-ls);
    color: var(--tag-color);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    border-radius: var(--tag-radius);
    box-shadow: var(--tag-shadow);
  }

  .project-category::before,
  .project-category::after {
    content: '';
    display: var(--tag-rivet);
    position: absolute;
    top: 50%;
    width: 3px;
    height: 3px;
    margin-top: -1.5px;
    border-radius: 50%;
    background: #8d9492;
  }

  .project-category::before {
    left: 5px;
  }

  .project-category::after {
    right: 5px;
  }

  .project-footer {
    margin-top: auto;
    padding-top: var(--space-4);
  }
</style>
