---
import type { Project } from '../data/types';
import ContentBadge from './ContentBadge.astro';

export interface Props {
  project: Project;
  categoryLabel?: string;
}

const { project, categoryLabel: customCategoryLabel } = Astro.props;
const categoryLabel = customCategoryLabel ?? project.category?.label ?? 'Réalisation';
---

<article class="card project-card" data-category={project.category?.slug ?? ''} id={project.slug}>
  <div class="card-media">
    {project.imageUrl ? (
      <img
        src={project.imageUrl}
        alt={`Aperçu de la réalisation ${project.title}`}
        loading="lazy"
      />
    ) : null}
  </div>
  <div class="card-body">
    <span class="project-category">{categoryLabel}</span>
    <h3 class="card-title">{project.title}</h3>
    <p class="card-text">{project.summary}</p>
    <div class="project-footer">
      <ContentBadge />
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-category {
    display: inline-block;
    width: fit-content;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-secondary);
    background-color: var(--color-secondary-light);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .project-footer {
    margin-top: auto;
    padding-top: var(--space-4);
  }
</style>
