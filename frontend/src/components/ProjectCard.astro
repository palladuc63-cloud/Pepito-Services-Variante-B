---
import type { Project } from '../data/types';
import ContentBadge from './ContentBadge.astro';

export interface Props {
  project: Project;
  categoryLabel?: string;
  showDraft?: boolean;
}

const { project, categoryLabel: customCategoryLabel, showDraft = false } = Astro.props;
const categoryLabel = customCategoryLabel ?? project.category?.label ?? 'Réalisation';
const gallery = project.images?.length
  ? project.images.map((i) => i.imageUrl)
  : (project.imageUrl ? [project.imageUrl] : []);
---

<article class="card project-card" data-category={project.category?.slug ?? ''} id={project.slug}>
  <div class="card-media" data-gallery={gallery.length > 1 ? '' : undefined}>
    {gallery.map((url, i) => (
      <img
        src={url}
        alt={i === 0 ? `Aperçu de la réalisation ${project.title}` : ''}
        loading="lazy"
        class:list={[i === 0 && 'is-active']}
      />
    ))}
    {gallery.length > 1 && <span class="gallery-count" aria-hidden="true">{gallery.length} photos</span>}
    {showDraft && !project.published && <span class="draft-badge">Brouillon</span>}
  </div>
  <div class="card-body">
    <span class="project-category">{categoryLabel}</span>
    <h3 class="card-title">{project.title}</h3>
    <p class="card-text">{project.summary}</p>
    <div class="project-footer">
      <ContentBadge />
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-category {
    position: relative;
    display: inline-block;
    width: fit-content;
    padding: var(--tag-pad);
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tag-ls);
    color: var(--tag-color);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    border-radius: var(--tag-radius);
    box-shadow: var(--tag-shadow);
  }

  .project-category::before,
  .project-category::after {
    content: '';
    display: var(--tag-rivet);
    position: absolute;
    top: 50%;
    width: 3px;
    height: 3px;
    margin-top: -1.5px;
    border-radius: 50%;
    background: #8d9492;
  }

  .project-category::before {
    left: 5px;
  }

  .project-category::after {
    right: 5px;
  }

  .project-footer {
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .card-media {
    position: relative;
  }

  .card-media[data-gallery] img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.45s ease, transform var(--transition-base);
  }

  .card-media[data-gallery] img.is-active {
    opacity: 1;
  }

  .draft-badge {
    position: absolute;
    left: 8px;
    top: 8px;
    padding: 2px 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #92400e;
    background: #fef3c7;
    border: 1px solid #f59e0b;
    border-radius: 20px;
  }

  .gallery-count {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    border-radius: 20px;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-media[data-gallery] img {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.card-media[data-gallery]').forEach((media) => {
    const imgs = media.querySelectorAll<HTMLImageElement>('img');
    if (imgs.length < 2) return;
    let idx = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const start = () => {
      if (timer || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = setInterval(() => {
        imgs[idx].classList.remove('is-active');
        idx = (idx + 1) % imgs.length;
        imgs[idx].classList.add('is-active');
      }, 1400);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
      imgs.forEach((img, i) => img.classList.toggle('is-active', i === 0));
      idx = 0;
    };
    media.addEventListener('mouseenter', start);
    media.addEventListener('mouseleave', stop);
    media.addEventListener('focusin', start);
    media.addEventListener('focusout', stop);
  });
</script>
