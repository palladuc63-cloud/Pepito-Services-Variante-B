---
const projectTypes = [
  { value: '', label: 'Sélectionnez une option' },
  { value: 'clotures', label: 'Clôture / palissade' },
  { value: 'portails', label: 'Portail / portillon' },
  { value: 'terrassements', label: 'Petit terrassement' },
  { value: 'autre', label: 'Autre projet' },
];
---

<form
  id="contact-form"
  class="contact-form"
  action="#"
  method="post"
  novalidate
  aria-labelledby="contact-form-title"
>
  <h2 id="contact-form-title" class="sr-only">Formulaire de contact</h2>

  <p class="form-notice" role="note">
    Votre demande est transmise directement à Pépito Services. Réponse sous 48h ouvrées.
  </p>

  <div class="form-group">
    <label for="contact-name" class="form-label">
      Nom <span class="required" aria-hidden="true">*</span>
    </label>
    <input
      type="text"
      id="contact-name"
      name="name"
      class="form-input"
      autocomplete="name"
      required
      aria-required="true"
    />
    <span class="form-error" id="error-name" role="alert" aria-live="assertive"></span>
  </div>

  <div class="form-group">
    <label for="contact-email" class="form-label">
      Email <span class="required" aria-hidden="true">*</span>
    </label>
    <input
      type="email"
      id="contact-email"
      name="email"
      class="form-input"
      autocomplete="email"
      required
      aria-required="true"
    />
    <span class="form-error" id="error-email" role="alert" aria-live="assertive"></span>
  </div>

  <div class="form-group">
    <label for="contact-phone" class="form-label">Téléphone</label>
    <input
      type="tel"
      id="contact-phone"
      name="phone"
      class="form-input"
      autocomplete="tel"
    />
    <span class="form-hint">Optionnel. Format : 01 23 45 67 89</span>
  </div>

  <div class="form-group">
    <label for="contact-project" class="form-label">Type de projet</label>
    <select id="contact-project" name="projectType" class="form-select">
      {projectTypes.map((type) => (
        <option value={type.value}>{type.label}</option>
      ))}
    </select>
  </div>

  <div class="form-group">
    <label for="contact-message" class="form-label">
      Message <span class="required" aria-hidden="true">*</span>
    </label>
    <textarea
      id="contact-message"
      name="message"
      class="form-textarea"
      rows="6"
      required
      aria-required="true"
    ></textarea>
    <span class="form-error" id="error-message" role="alert" aria-live="assertive"></span>
  </div>

  <button type="submit" class="btn btn-primary form-submit">
    Envoyer ma demande
  </button>

  <div id="form-success" class="form-success" role="status" aria-live="polite" hidden>
    <p>Merci pour votre message, <span class="success-name"></span> !</p>
    <p>Votre demande a bien été envoyée. Pépito Services vous recontactera rapidement.</p>
  </div>

  <div id="form-error" class="form-error-box" role="alert" hidden>
    <p>Une erreur est survenue lors de l’envoi. Réessayez ou contactez-nous directement.</p>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBlock = document.getElementById('form-success');

  if (form && successBlock) {
    const nameError = document.getElementById('error-name');
    const emailError = document.getElementById('error-email');
    const messageError = document.getElementById('error-message');
    const errorBox = document.getElementById('form-error');

    const clearErrors = () => {
      [nameError, emailError, messageError].forEach((el) => {
        if (el) el.textContent = '';
      });
      form.querySelectorAll('.form-input, .form-textarea').forEach((field) => {
        field.removeAttribute('aria-invalid');
      });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      if (errorBox) errorBox.hidden = true;

      const formData = new FormData(form);
      const name = String(formData.get('name') ?? '').trim();
      const email = String(formData.get('email') ?? '').trim();
      const message = String(formData.get('message') ?? '').trim();

      let isValid = true;

      if (!name) {
        if (nameError) nameError.textContent = 'Veuillez indiquer votre nom.';
        document.getElementById('contact-name')?.setAttribute('aria-invalid', 'true');
        isValid = false;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailRegex.test(email)) {
        if (emailError) emailError.textContent = 'Veuillez saisir une adresse email valide.';
        document.getElementById('contact-email')?.setAttribute('aria-invalid', 'true');
        isValid = false;
      }

      if (!message) {
        if (messageError) messageError.textContent = 'Veuillez écrire un message.';
        document.getElementById('contact-message')?.setAttribute('aria-invalid', 'true');
        isValid = false;
      }

      if (!isValid) {
        const firstInvalid = form.querySelector('[aria-invalid="true"]') as HTMLElement | null;
        firstInvalid?.focus();
        return;
      }

      const submitBtn = form.querySelector('.form-submit') as HTMLButtonElement | null;
      try {
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Envoi en cours…'; }
        const res = await fetch('/api/public/messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            phone: String(formData.get('phone') ?? '').trim() || null,
            projectType: String(formData.get('projectType') ?? '') || null,
            message,
            source: 'contact',
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const nameSpan = successBlock.querySelector('.success-name');
        if (nameSpan) nameSpan.textContent = name;
        successBlock.hidden = false;
        form.reset();
        successBlock.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch {
        if (errorBox) {
          errorBox.hidden = false;
          errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Envoyer ma demande'; }
      }
    });
  }
</script>

<style>
  .contact-form {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
  }

  .form-notice {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-info-bg);
    color: var(--color-info-text);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  .form-submit {
    width: 100%;
  }

  @media (min-width: 768px) {
    .form-submit {
      width: auto;
    }
  }

  .form-success {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background-color: var(--color-success-bg);
    color: var(--color-success-text);
    border-radius: var(--radius-md);
  }

  .form-error-box {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background-color: #fee2e2;
    color: #991b1b;
    border-radius: var(--radius-md);
  }

  .form-success p:first-child {
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
</style>
