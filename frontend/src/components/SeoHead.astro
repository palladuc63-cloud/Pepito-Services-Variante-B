---
import { Font } from 'astro:assets';
import type { SiteSettings, SeoMeta } from '../data/types';

export interface Props {
  settings: SiteSettings;
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  /** Override issu de seo_meta — prioritaire sur title/description/image. */
  seoMeta?: SeoMeta | null;
  /** Objets JSON-LD (schema.org) sérialisés dans le head. */
  jsonLd?: object[];
}

const {
  settings,
  title: rawTitle,
  description: rawDescription,
  image: rawImage,
  canonicalPath,
  noIndex = false,
  seoMeta,
  jsonLd,
} = Astro.props;

const title = seoMeta?.metaTitle ?? rawTitle;
const description = seoMeta?.metaDesc ?? rawDescription ?? settings.description;
const image = seoMeta?.ogImage ?? rawImage;

const base = import.meta.env.BASE_URL;
const siteTitle = title ? `${title} — ${settings.name}` : settings.name;
const canonicalUrl = canonicalPath
  ? `${settings.siteUrl.replace(/\/$/, '')}${canonicalPath}`
  : settings.siteUrl;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
<title>{siteTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noIndex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={settings.name} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content="website" />
{image && <meta property="og:image" content={image} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}

<Font cssVariable="--font-bricolage" preload />
<Font cssVariable="--font-fraunces" />
<Font cssVariable="--font-barlow" />
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-poppins" preload />

{jsonLd?.map((entry) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
))}
