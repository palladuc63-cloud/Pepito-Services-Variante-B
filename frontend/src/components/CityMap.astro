---
import type { CityPage } from '../data/types';

export interface Props {
  pages: CityPage[];
  height?: string;
}

const { pages, height = '420px' } = Astro.props;
const base = import.meta.env.BASE_URL;

// Marqueurs : pages villes publiées géocodées
const markers = pages
  .filter((p) => p.lat != null && p.lng != null)
  .map((p) => ({
    lat: p.lat,
    lng: p.lng,
    label: p.city,
    url: `${base}${p.serviceSlug}/${p.slug}/`,
  }));
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>
<div class="city-map-wrap">
  <div id="city-map" style={`height:${height}`} data-markers={JSON.stringify(markers)}></div>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>
<script is:inline>
  (function () {
    function initCityMap() {
      var el = document.getElementById('city-map');
      if (!el || el.dataset.done || typeof L === 'undefined') return;
      el.dataset.done = '1';
      var markers = [];
      try { markers = JSON.parse(el.dataset.markers || '[]'); } catch (e) {}
      var map = L.map('city-map', { scrollWheelZoom: false });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);
      var icon = L.divIcon({
        className: 'city-marker',
        html: '<span class="city-marker-dot"></span>',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });
      var bounds = [];
      markers.forEach(function (m) {
        var ll = [m.lat, m.lng];
        bounds.push(ll);
        L.marker(ll, { icon: icon })
          .addTo(map)
          .bindPopup('<a href="' + m.url + '"><strong>' + m.label + '</strong></a>');
      });
      if (bounds.length) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 10 });
      else map.setView([45.4397, 4.3872], 8);
    }
    if (typeof L !== 'undefined') initCityMap();
    else window.addEventListener('load', initCityMap);
  })();
</script>

<style>
  .city-map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  #city-map {
    width: 100%;
  }

  :global(.city-marker-dot) {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-primary, #16a34a);
    border: 3px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 35%);
  }

  :global(.leaflet-popup-content a) {
    color: var(--color-primary, #16a34a);
    font-weight: 600;
  }
</style>
