---
import type { CityPage } from '../data/types';
import { getCityMarkers } from '../lib/api.js';
import { getSite } from '../lib/site.js';

export interface Props {
  pages?: CityPage[];
  height?: string;
  focusCity?: string; // mode « localisation » : un seul marqueur centré
}

const { pages, height = '420px', focusCity } = Astro.props;
const base = import.meta.env.BASE_URL;

const slugify = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

// Marqueurs : toutes les villes publiées géocodées — les pages encore
// programmées apparaissent sur la carte sans lien (zone réelle d'intervention)
interface Marker { lat: number; lng: number; city: string; url: string | null }
let markers: Marker[] = [];
try {
  markers = await getCityMarkers();
} catch {}
if (!markers.length && pages?.length) {
  markers = pages
    .filter((p) => p.lat != null && p.lng != null)
    .map((p) => ({ lat: p.lat!, lng: p.lng!, city: p.city, url: `/${p.serviceSlug}/${p.slug}/` }));
}
markers = markers.map((m) => ({ ...m, url: m.url ? `${base}${m.url.replace(/^\/+/, '')}` : null }));

// Mode focus : ne garder que la ville demandée (page réalisation)
if (focusCity) {
  const wanted = slugify(focusCity);
  markers = markers.filter((m) => slugify(m.city) === wanted);
}

// Zone d'intervention : cercle centré sur la ville de l'entreprise (Thiers)
const { settings } = await getSite();
const radiusKm = focusCity ? 0 : Number(String(settings.contact.serviceArea || '').replace(/[^\d]/g, '')) || 0;
const home = markers.find((m) => m.city?.toLowerCase() === 'thiers') || { lat: 45.8567, lng: 3.5489 };
const zone = radiusKm ? { lat: home.lat, lng: home.lng, radius: radiusKm * 1000 } : null;
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>
<div class="city-map-wrap">
  <div
    id="city-map"
    style={`height:${height}`}
    data-markers={JSON.stringify(markers)}
    data-zone={zone ? JSON.stringify(zone) : ''}
  ></div>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>
<script is:inline>
  (function () {
    function initCityMap() {
      var el = document.getElementById('city-map');
      if (!el || el.dataset.done || typeof L === 'undefined') return;
      try {
      var markers = [];
      try { markers = JSON.parse(el.dataset.markers || '[]'); } catch (e) {}
      var map = L.map('city-map', { scrollWheelZoom: false });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);
      var icon = L.divIcon({
        className: 'city-marker',
        html: '<span class="city-marker-dot"></span>',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });
      var iconSoon = L.divIcon({
        className: 'city-marker',
        html: '<span class="city-marker-dot city-marker-dot--soon"></span>',
        iconSize: [14, 14],
        iconAnchor: [7, 7],
      });
      var zone = null;
      try { zone = JSON.parse(el.dataset.zone || 'null'); } catch (e) {}
      if (zone && zone.radius) {
        L.circle([zone.lat, zone.lng], {
          radius: zone.radius,
          color: 'rgba(22, 163, 74, 0.75)',
          weight: 2,
          dashArray: '8 6',
          fillColor: 'rgba(22, 163, 74, 0.08)',
          fillOpacity: 1,
        }).addTo(map);
      }
      var bounds = [];
      markers.forEach(function (m) {
        var ll = [m.lat, m.lng];
        bounds.push(ll);
        var popup = m.url
          ? '<a href="' + m.url + '"><strong>' + m.city + '</strong></a>'
          : '<strong>' + m.city + '</strong><br/><span class="city-marker-soon">Bientôt en ligne</span>';
        L.marker(ll, { icon: m.url ? icon : iconSoon }).addTo(map).bindPopup(popup);
      });
      if (zone && zone.radius) {
        // LatLng.toBounds : bounds sans avoir besoin d'une carte (Circle.getBounds exige _map)
        map.fitBounds(L.latLng(zone.lat, zone.lng).toBounds(zone.radius * 2));
      } else if (bounds.length === 1) map.setView(bounds[0], 13);
      else if (bounds.length) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 10 });
      else map.setView([45.8567, 3.5489], 9);
      // Navigation SPA : la carte peut être init avant que son conteneur
      // ait sa taille finale → recalcul différé pour forcer le chargement
      setTimeout(function () { map.invalidateSize(); }, 150);
      setTimeout(function () { map.invalidateSize(); }, 600);
      el.dataset.done = '1';
      } catch (err) {
        // Init incomplète : nettoyer la carte partielle pour pouvoir retenter
        try { if (map && map.remove) map.remove(); } catch (e) {}
        console.error('CityMap init failed', err);
      }
    }
    function whenReady() {
      if (typeof L !== 'undefined') initCityMap();
      else window.addEventListener('load', initCityMap, { once: true });
    }
    // Navigation SPA (ClientRouter) : ré-init à chaque affichage de page
    document.addEventListener('astro:page-load', whenReady);
    whenReady();
  })();
</script>

<style>
  .city-map-wrap {
    position: relative;
    z-index: 0; /* contexte d'empilement : contient les z-index internes de Leaflet */
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  #city-map {
    width: 100%;
  }

  :global(.city-marker-dot) {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-primary, #16a34a);
    border: 3px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 35%);
  }

  :global(.city-marker-dot--soon) {
    width: 12px;
    height: 12px;
    background: #fff;
    border: 3px solid #9aa39b;
    opacity: 0.9;
  }

  :global(.city-marker-soon) {
    font-size: 11px;
    color: #6a604f;
  }

  :global(.leaflet-popup-content a) {
    color: var(--color-primary, #16a34a);
    font-weight: 600;
  }
</style>
