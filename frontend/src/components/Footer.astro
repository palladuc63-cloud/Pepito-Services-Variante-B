---
import type { SiteSettings } from '../data/types';

export interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;

const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <strong class="footer-name">{settings.name}</strong>
      <p class="footer-tagline">{settings.baseline}</p>
    </div>

    <nav class="footer-nav" aria-label="Pied de page">
      <ul class="footer-links">
        {settings.nav.map((link) => {
          const linkHref = link.href === '/' ? base : `${base}${link.href.replace(/^\//, '')}`;
          return <li><a href={linkHref}>{link.label}</a></li>;
        })}
        <li><a href={`${base}mentions-legales/`}>Mentions légales</a></li>
        <li><a href={`${base}politique-confidentialite/`}>Politique de confidentialité</a></li>
      </ul>
    </nav>

    <div class="footer-socials">
      {settings.socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${settings.name} sur ${social.name} (nouvelle fenêtre)`}
        >
          {social.name}
        </a>
      ))}
    </div>

    <p class="footer-legal">
      © {currentYear} {settings.name} – Tous droits réservés.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: 1rem;
    padding-block: var(--space-12) var(--space-10);
    background-color: var(--basalt-dark);
    background-image: var(--grain-img);
    color: var(--on-dark);
  }

  /* Piquets qui « sortent » du pied de page */
  .site-footer::before {
    content: '';
    display: var(--deco);
    position: absolute;
    top: -1rem;
    left: 0;
    right: 0;
    height: 1rem;
    background: var(--basalt-dark);
    -webkit-mask: var(--picket-mask) 0 0 / 8px 16px repeat-x;
    mask: var(--picket-mask) 0 0 / 8px 16px repeat-x;
  }

  .footer-inner {
    display: grid;
    gap: var(--space-6);
    text-align: center;
  }

  .footer-name {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--on-dark);
    margin-bottom: var(--space-2);
  }

  .footer-tagline {
    color: var(--copper-light);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .footer-links a,
  .footer-socials a {
    color: var(--on-dark);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .footer-links a:hover,
  .footer-socials a:hover {
    color: var(--copper-light);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer-socials {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
  }

  .footer-socials a {
    font-weight: 600;
  }

  .footer-legal {
    padding-top: var(--space-4);
    border-top: 1px solid rgb(245 242 234 / 0.18);
    color: rgb(245 242 234 / 0.7);
    font-size: var(--text-sm);
  }
</style>
