---
import type { SiteSettings } from '../data/types';
import logo from '../assets/pepito-logo.svg';
import Icon from './Icon.astro';

export interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const navLinks = settings.nav.map((link) => ({
  ...link,
  href: link.href === '/' ? base : `${base}${link.href.replace(/^\//, '')}`,
  isActive: link.href === '/'
    ? currentPath === base || currentPath === `${base}`
    : currentPath.startsWith(`${base}${link.href.replace(/^\//, '')}`),
  children: link.children?.map((c) => ({
    ...c,
    href: `${base}${c.href.replace(/^\//, '')}`,
    subs: c.subs?.map((s) => ({ ...s, href: `${base}${s.href.replace(/^\//, '')}` })),
  })),
}));
---

<header class="site-header sticky top-0 z-50 bg-[color:var(--paper)]/92 backdrop-blur-md border-b border-[color:var(--line)]">
  <div class="container mx-auto px-4">
    <nav class="main-nav flex items-center justify-between min-h-20" aria-label="Navigation principale">
      <div class="brand-area">
        <a href={base} class="inline-flex items-center flex-shrink-0" aria-label={`Accueil ${settings.name}`}>
          <img
            src={logo.src}
            alt=""
            width="553"
            height="256"
            class="site-logo w-auto object-contain"
          />
        </a>
      </div>

      <ul class="desktop-nav hidden md:flex items-center gap-2 list-none m-0 p-0" role="menubar">
        {
          navLinks.map((link, i) => (
            <li role="none" class:list={['nav-item', { 'nav-item--has-dd': link.children?.length }]}>
              {link.children?.length ? (
                <>
                  <button
                    type="button"
                    class:list={[
                      'nav-link nav-dd-parent inline-flex items-center rounded-[var(--r-btn)] px-4 py-2 text-sm font-semibold tracking-wide transition-colors',
                      link.isActive
                        ? 'text-[color:var(--forest-dark)] bg-[color:var(--nav-active-bg)] nav-link--active'
                        : 'text-[color:var(--ink)] hover:bg-[color:var(--forest-soft)] hover:text-[color:var(--forest-dark)]',
                    ]}
                    aria-expanded="false"
                    aria-haspopup="menu"
                    aria-controls={`nav-dd-${i}`}
                  >
                    {link.icon && <Icon name={link.icon} size={15} class="nav-icon" />}
                    {link.label}
                    <Icon name="chevron-down" size={13} class="nav-dd-caret" />
                  </button>
                  <div class="nav-dd" id={`nav-dd-${i}`} role="menu" aria-label={`Sous-menu ${link.label}`}>
                    <div class="nav-dd__grid">
                      <div class="nav-dd__item" role="none">
                        <a href={link.href} class="nav-dd__link" role="menuitem">
                          <span class="nav-dd__media">
                            <Icon name="grid" size={18} class="nav-dd__icon" />
                          </span>
                          <span class="nav-dd__label">
                            {link.label === 'Réalisations' ? 'Toutes les réalisations' : 'Tout voir'}
                          </span>
                        </a>
                      </div>
                      {link.children.map((child) => (
                        <div class="nav-dd__item" role="none">
                          <a href={child.href} class="nav-dd__link" role="menuitem">
                            <span class:list={['nav-dd__media', { 'nav-dd__media--img': child.image }]}>
                              {child.image && (
                                <img src={child.image} alt="" loading="lazy" class="nav-dd__thumb" />
                              )}
                              <Icon name={child.icon ?? 'grid'} size={18} class="nav-dd__icon" />
                            </span>
                            <span class="nav-dd__label">{child.label}</span>
                          </a>
                          {child.subs?.length ? (
                            <ul class="nav-dd__subs">
                              {child.subs.map((sub) => (
                                <li>
                                  <a href={sub.href} class="nav-dd__sub" role="menuitem">
                                    {sub.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          ) : null}
                        </div>
                      ))}
                    </div>
                  </div>
                </>
              ) : (
                <a
                  href={link.href}
                  class:list={[
                    'nav-link inline-flex items-center rounded-[var(--r-btn)] px-4 py-2 text-sm font-semibold tracking-wide no-underline transition-colors',
                    link.isActive
                      ? 'text-[color:var(--forest-dark)] bg-[color:var(--nav-active-bg)] nav-link--active'
                      : 'text-[color:var(--ink)] hover:bg-[color:var(--forest-soft)] hover:text-[color:var(--forest-dark)]',
                  ]}
                  aria-current={link.isActive ? 'page' : undefined}
                  role="menuitem"
                >
                  {link.icon && <Icon name={link.icon} size={15} class="nav-icon" />}
                  {link.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        class="mobile-menu-toggle md:hidden inline-flex items-center justify-center w-11 h-11 rounded-full border border-[color:var(--line)] bg-[color:var(--panel)] shadow-sm"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Ouvrir le menu"
      >
        <span class="hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </nav>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu principal" hidden>
  <div class="mobile-menu__header">
    <span class="mobile-menu__title">Menu</span>
    <button type="button" class="mobile-menu__close" aria-label="Fermer le menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <ul class="mobile-menu__list" role="menubar">
    {
      navLinks.map((link, i) => (
        <li
          class:list={['mobile-menu__item', { 'mobile-menu__item--has-sub': link.children?.length }]}
          role="none"
        >
          {link.children?.length ? (
            <>
              <button
                type="button"
                class="mobile-menu__link mobile-sub-toggle"
                aria-expanded="false"
                aria-controls={`mobile-sub-${i}`}
              >
                {link.icon && <Icon name={link.icon} size={20} class="mobile-nav-icon" />}
                {link.label}
                <Icon name="chevron-down" size={18} class="mobile-sub-caret" />
              </button>
              <ul class="mobile-sub-list" id={`mobile-sub-${i}`} role="menu">
                <li class="mobile-sub-item" role="none">
                  <a href={link.href} class="mobile-sub-link" role="menuitem">
                    <Icon name="grid" size={16} class="mobile-nav-icon" />
                    {link.label === 'Réalisations' ? 'Toutes les réalisations' : 'Tout voir'}
                  </a>
                </li>
                {link.children.map((child) => (
                  <li class="mobile-sub-item" role="none">
                    <a href={child.href} class="mobile-sub-link" role="menuitem">
                      <Icon name={child.icon ?? 'grid'} size={16} class="mobile-nav-icon" />
                      {child.label}
                    </a>
                    {child.subs?.length ? (
                      <ul class="mobile-sub-sub" role="menu">
                        {child.subs.map((sub) => (
                          <li role="none">
                            <a href={sub.href} class="mobile-sub-link mobile-sub-link--mini" role="menuitem">
                              {sub.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <a
              href={link.href}
              class="mobile-menu__link"
              aria-current={link.isActive ? 'page' : undefined}
              role="menuitem"
            >
              {link.icon && <Icon name={link.icon} size={20} class="mobile-nav-icon" />}
              {link.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>

<script>
  (function () {
    function getMenu() {
      return {
        toggle: document.querySelector('.mobile-menu-toggle') as HTMLButtonElement | null,
        menu: document.getElementById('mobile-menu') as HTMLElement | null,
      };
    }

    function openMenu() {
      const { toggle, menu } = getMenu();
      if (!toggle || !menu) return;
      menu.hidden = false;
      document.body.style.overflow = 'hidden';
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Fermer le menu');
      (menu.querySelector('.mobile-menu__close') as HTMLButtonElement | null)?.focus();
    }

    function closeMenu() {
      const { toggle, menu } = getMenu();
      if (!toggle || !menu || menu.hidden) return;
      menu.classList.add('menu-leaving');
      setTimeout(() => {
        menu.hidden = true;
        menu.classList.remove('menu-leaving');
      }, 220);
      document.body.style.overflow = '';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Ouvrir le menu');
      toggle.focus();
    }

    function closeDropdowns() {
      document.querySelectorAll('.nav-item--has-dd.is-open').forEach((item) => {
        item.classList.remove('is-open');
        item
          .querySelector('.nav-dd-parent')
          ?.setAttribute('aria-expanded', 'false');
      });
    }

    document.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;

      const ddParent = el.closest('.nav-dd-parent');
      if (ddParent) {
        const item = ddParent.closest('.nav-item--has-dd');
        if (item) {
          const willOpen = !item.classList.contains('is-open');
          closeDropdowns();
          item.classList.toggle('is-open', willOpen);
          ddParent.setAttribute('aria-expanded', String(willOpen));
        }
        return;
      }

      const subToggle = el.closest('.mobile-sub-toggle');
      if (subToggle) {
        const item = subToggle.closest('.mobile-menu__item--has-sub');
        item?.classList.toggle('is-open');
        subToggle.setAttribute(
          'aria-expanded',
          String(item?.classList.contains('is-open') ?? false)
        );
        return;
      }

      if (!el.closest('.nav-item--has-dd')) closeDropdowns();

      if (el.closest('.mobile-menu-toggle')) {
        const { menu } = getMenu();
        menu?.hidden ? openMenu() : closeMenu();
      } else if (el.closest('.mobile-menu__close') || el.closest('.mobile-menu a')) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const openItem = document.querySelector('.nav-item--has-dd.is-open');
        if (openItem?.contains(document.activeElement)) {
          (openItem.querySelector('.nav-dd-parent') as HTMLElement | null)?.focus();
        }
        closeDropdowns();
        closeMenu();
      }
    });

    // Logo rétractable : classe sur le header passé un seuil de scroll
    const header = document.querySelector('.site-header');
    if (header) {
      const onScroll = () =>
        header.classList.toggle('is-scrolled', window.scrollY > 28);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  })();
</script>

<style>
  .site-header {
    border-top: var(--header-top-border);
  }

  :global(.nav-link--active) {
    box-shadow: var(--nav-active-shadow);
  }

  .brand-area {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-logo {
    width: 11.25rem;
    height: 5.25rem;
    object-fit: contain;
  }

  :global(.nav-icon) {
    margin-right: 0.4rem;
    flex-shrink: 0;
  }

  :global(.mobile-menu__link) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 420px) {
    .brand-area {
      gap: 0.4rem;
    }

    .site-logo {
      width: 8.25rem;
      height: 5.25rem;
    }
  }

  /* Hamburger icon */
  .hamburger {
    width: 1.25rem;
    height: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--ink);
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
    transform-origin: center;
  }

  .mobile-menu-toggle[aria-expanded='true'] .hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-toggle[aria-expanded='true'] .hamburger span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle[aria-expanded='true'] .hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu overlay */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
    background: var(--color-secondary);
    color: var(--color-warm-white);
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    overflow-y: auto;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .mobile-menu:not([hidden]) {
    animation: menu-in 0.22s ease-out;
  }

  .mobile-menu.menu-leaving {
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s ease-in, transform 0.2s ease-in;
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .mobile-menu:not([hidden]) .mobile-menu__item {
    animation: menu-item-in 0.28s ease-out backwards;
  }

  .mobile-menu:not([hidden]) .mobile-menu__item:nth-child(1) { animation-delay: 60ms; }
  .mobile-menu:not([hidden]) .mobile-menu__item:nth-child(2) { animation-delay: 100ms; }
  .mobile-menu:not([hidden]) .mobile-menu__item:nth-child(3) { animation-delay: 140ms; }
  .mobile-menu:not([hidden]) .mobile-menu__item:nth-child(4) { animation-delay: 180ms; }
  .mobile-menu:not([hidden]) .mobile-menu__item:nth-child(5) { animation-delay: 220ms; }
  .mobile-menu:not([hidden]) .mobile-menu__item:nth-child(6) { animation-delay: 260ms; }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .mobile-menu__title {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .mobile-menu__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-warm-white);
    border: none;
    cursor: pointer;
    transition: background-color 200ms ease;
  }

  .mobile-menu__close:hover,
  .mobile-menu__close:focus {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .mobile-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu__item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-menu__link {
    display: block;
    padding: 1rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-warm-white);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link:focus {
    color: var(--color-sand);
  }

  .mobile-menu__link[aria-current='page'] {
    color: var(--color-primary-light);
  }

  /* ─── Dropdown « Réalisations » ───
     Markup unique ; chaque thème choisit sa présentation via
     [data-theme] — nature = icônes, immersif = mega-menu photo,
     bento = vignettes, editorial = typographique. */
  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-item--has-dd {
    padding-bottom: 0.7rem;
    margin-bottom: -0.7rem;
  }

  .nav-dd-parent {
    cursor: pointer;
  }

  .nav-dd-parent :global(.nav-dd-caret) {
    margin-left: 0.15rem;
  }

  :global(.nav-dd-caret) {
    transition: transform 0.18s ease;
  }

  .nav-item--has-dd:is(:hover, :focus-within, .is-open) :global(.nav-dd-caret) {
    transform: rotate(180deg);
  }

  .nav-dd {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 18rem;
    padding: var(--space-3);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
    z-index: 60;
  }

  .nav-item--has-dd:is(:hover, :focus-within, .is-open) .nav-dd {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav-dd__grid {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .nav-dd__link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-md);
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .nav-dd__link:hover,
  .nav-dd__link:focus-visible {
    background: var(--forest-soft);
    color: var(--forest-dark);
  }

  .nav-dd__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    color: var(--forest);
  }

  .nav-dd__thumb {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nav-dd__subs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.85rem;
    margin: 0 0 0.35rem;
    padding: 0 0 0 3.35rem;
    list-style: none;
  }

  .nav-dd__sub {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--stone);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-dd__sub:hover,
  .nav-dd__sub:focus-visible {
    color: var(--forest-dark);
  }

  /* Immersif — mega-menu pleine largeur, cards photo */
  :global([data-theme='immersif']) .nav-item--has-dd {
    position: static;
  }

  :global([data-theme='immersif']) .nav-dd {
    left: 0;
    right: 0;
    padding: 0;
    background: var(--paper);
    border-right: none;
    border-left: none;
    border-radius: 0;
  }

  :global([data-theme='immersif']) .nav-dd__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: var(--space-6);
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  :global([data-theme='immersif']) .nav-dd__link {
    flex-direction: column;
    align-items: stretch;
    gap: 0.65rem;
    padding: 0;
  }

  :global([data-theme='immersif']) .nav-dd__link:hover,
  :global([data-theme='immersif']) .nav-dd__link:focus-visible {
    background: transparent;
    color: var(--forest);
  }

  :global([data-theme='immersif']) .nav-dd__media {
    width: 100%;
    height: 6.25rem;
    overflow: hidden;
    background: var(--paper-deep);
  }

  :global([data-theme='immersif']) .nav-dd__media :global(.nav-dd__icon) {
    width: 1.75rem;
    height: 1.75rem;
  }

  :global([data-theme='immersif']) .nav-dd__media--img :global(.nav-dd__icon) {
    display: none;
  }

  :global([data-theme='immersif']) .nav-dd__thumb {
    display: block;
    transition: transform 0.3s ease;
  }

  :global([data-theme='immersif']) .nav-dd__link:hover .nav-dd__thumb,
  :global([data-theme='immersif']) .nav-dd__link:focus-visible .nav-dd__thumb {
    transform: scale(1.05);
  }

  :global([data-theme='immersif']) .nav-dd__label {
    font-family: var(--font-display, var(--font-heading));
    font-size: 1.05rem;
  }

  :global([data-theme='immersif']) .nav-dd__subs {
    flex-direction: column;
    gap: 0.15rem;
    padding-left: 0;
  }

  /* Bento — grille de tuiles arrondies (esprit « bento box ») */
  :global([data-theme='bento']) .nav-dd {
    min-width: 27rem;
    padding: var(--space-2);
    background: var(--paper-deep);
  }

  :global([data-theme='bento']) .nav-dd__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  :global([data-theme='bento']) .nav-dd__item {
    padding: var(--space-3);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    transition: transform var(--transition-fast), border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  :global([data-theme='bento']) .nav-dd__item:hover {
    transform: translateY(-2px);
    border-color: var(--card-hover-border);
    box-shadow: var(--shadow-md);
  }

  :global([data-theme='bento']) .nav-dd__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  :global([data-theme='bento']) .nav-dd__link {
    flex-direction: column;
    align-items: stretch;
    gap: 0.55rem;
    padding: 0;
  }

  :global([data-theme='bento']) .nav-dd__link:hover,
  :global([data-theme='bento']) .nav-dd__link:focus-visible {
    background: transparent;
    color: var(--forest-dark);
  }

  :global([data-theme='bento']) .nav-dd__media {
    width: 100%;
    height: 4.25rem;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--paper-deep);
  }

  :global([data-theme='bento']) .nav-dd__media--img :global(.nav-dd__icon) {
    display: none;
  }

  :global([data-theme='bento']) .nav-dd__thumb {
    display: block;
  }

  :global([data-theme='bento']) .nav-dd__label {
    font-size: 0.88rem;
  }

  :global([data-theme='bento']) .nav-dd__subs {
    flex-direction: column;
    gap: 0.1rem;
    padding-left: 0;
  }

