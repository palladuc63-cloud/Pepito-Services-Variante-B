---
import gatePlate from '../assets/gate/gate-plate.webp';
import gatePhoto from '../assets/gate/portail-reference.webp';
---

<section class="gate-scene" aria-label="Portail battant aluminium sur mesure">
  <div class="gate-scene__sticky">
    <div class="gate-scene__canvas" data-plate={gatePlate.src}></div>
    <img
      class="gate-scene__fallback"
      src={gatePhoto.src}
      alt="Portail battant aluminium anthracite posé par Pépito Services"
      loading="lazy"
    />
    <div class="gate-scene__caption" aria-hidden="true">
      <p class="gate-scene__hint">Faites défiler pour entrer</p>
    </div>
  </div>
</section>

<style>
  .gate-scene {
    position: relative;
    height: 320vh;
  }
  .gate-scene__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #dfe4e6;
  }
  .gate-scene__canvas {
    position: absolute;
    inset: 0;
  }
  .gate-scene__canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .gate-scene__fallback {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gate-scene--fallback .gate-scene__fallback {
    display: block;
  }
  .gate-scene__caption {
    position: absolute;
    top: clamp(3rem, 10vh, 6rem);
    left: 0;
    right: 0;
    z-index: 2;
    text-align: center;
    pointer-events: none;
  }
  .gate-scene__hint {
    font-size: 0.85rem;
    color: #5b6167;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
  }
  @media (max-width: 900px) {
    .gate-scene {
      height: 260vh;
    }
  }
</style>

<script>
  const gateScene = document.querySelector<HTMLElement>('.gate-scene');
  const canvasHost = gateScene?.querySelector<HTMLElement>('.gate-scene__canvas');
  const caption = gateScene?.querySelector<HTMLElement>('.gate-scene__caption');

  if (gateScene && canvasHost) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const showFallback = () => gateScene.classList.add('gate-scene--fallback');

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          void boot();
        }
      },
      { rootMargin: '600px' }
    );
    io.observe(gateScene);

    async function boot() {
      try {
        const THREE = await import('three');
        init(THREE);
      } catch {
        showFallback();
      }
    }

    const init = (THREE: typeof import('three')) => {
      let renderer: InstanceType<typeof THREE.WebGLRenderer>;
      try {
        renderer = new THREE.WebGLRenderer({ antialias: true });
      } catch {
        showFallback();
        return;
      }
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      canvasHost.appendChild(renderer.domElement);

      // La scène vit dans l'espace pixel de la photo (1024x571) :
      // la plaque (photo sans vantaux) est le fond, les deux vantaux
      // sont des plans colorés pivotant sur leurs gonds.
      const IMG_W = 1024;
      const IMG_H = 571;

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0xdfe4e6);

      const camera = new THREE.OrthographicCamera(0, 1, 0, 1, 0.1, 2000);
      camera.position.z = 500;

      // Lumière : comme sur la photo (soleil haut devant à gauche).
      scene.add(new THREE.AmbientLight(0xffffff, 0.55));
      const sun = new THREE.DirectionalLight(0xfff4e4, 1.9);
      sun.position.set(-0.35, -0.9, 1).normalize();
      scene.add(sun);

      // Vantaux — anthracite RAL 7016, pivot au bord côté gonds.
      const anthracite = new THREE.MeshLambertMaterial({ color: 0x353b3f });
      const gateGroup = new THREE.Group();
      scene.add(gateGroup);

      const GAP_L = 160; // bord intérieur pilier gauche (px image)
      const GAP_R = 870; // bord intérieur pilier droit
      const PANEL_W = (GAP_R - GAP_L) / 2; // 355
      const PANEL_H = 330;
      const PANEL_Y = 278; // centre vertical des vantaux

      const geoL = new THREE.BoxGeometry(PANEL_W, PANEL_H, 6);
      geoL.translate(PANEL_W / 2, 0, 0);
      const geoR = new THREE.BoxGeometry(PANEL_W, PANEL_H, 6);
      geoR.translate(-PANEL_W / 2, 0, 0);

      const hingeL = new THREE.Group();
      hingeL.position.set(GAP_L, PANEL_Y, 0);
      hingeL.add(new THREE.Mesh(geoL, anthracite));
      const hingeR = new THREE.Group();
      hingeR.position.set(GAP_R, PANEL_Y, 0);
      hingeR.add(new THREE.Mesh(geoR, anthracite));
      gateGroup.add(hingeL, hingeR);

      const render = () => renderer.render(scene, camera);

      let bgTex: InstanceType<typeof THREE.Texture> | null = null;
      new THREE.TextureLoader().load(canvasHost.dataset.plate ?? '', (t) => {
        t.colorSpace = THREE.SRGBColorSpace;
        bgTex = t;
        scene.background = t;
        onResize();
      });

      const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
      const smooth = (t: number) => t * t * (3 - 2 * t);

      const update = (p: number) => {
        const open = smooth(clamp01((p - 0.15) / 0.85));
        const angle = open * 1.0; // ~57°, comme sur la photo
        hingeL.rotation.y = angle;
        hingeR.rotation.y = -angle;
        // Léger glissement latéral des vantaux vs le fond = parallaxe.
        gateGroup.position.x = (window.innerWidth - IMG_W * gateGroup.scale.x) / 2 + (p - 0.5) * 14;
        if (caption) caption.style.opacity = String(Math.max(0, 1 - p * 4));
        render();
      };

      const onScroll = () => {
        const rect = gateScene.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > window.innerHeight) return;
        update(clamp01(-rect.top / (rect.height - window.innerHeight)));
      };

      const onResize = () => {
        const w = canvasHost.clientWidth;
        const h = canvasHost.clientHeight;
        if (!w || !h) return;
        renderer.setSize(w, h, false);
        camera.right = w;
        camera.bottom = h;
        camera.updateProjectionMatrix();

        // Mise à l'échelle « cover » : la photo remplit l'écran.
        const s = Math.max(w / IMG_W, h / IMG_H);
        gateGroup.scale.set(s, s, 1);
        gateGroup.position.set((w - IMG_W * s) / 2, (h - IMG_H * s) / 2, 0);

        if (bgTex) {
          const fracX = Math.min(1, w / (IMG_W * s));
          const fracY = Math.min(1, h / (IMG_H * s));
          bgTex.repeat.set(fracX, fracY);
          bgTex.offset.set((1 - fracX) / 2, (1 - fracY) / 2);
        }
        render();
      };

      new ResizeObserver(() => {
        onResize();
        onScroll();
      }).observe(canvasHost);
      onResize();

      if (reduced) {
        update(0.55);
      } else {
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    };
  }
</script>
