---
import gatePoster from '../assets/gate/gate-poster.webp';
import logo from '../assets/pepito-logo.svg';
const videoSrc = `${import.meta.env.BASE_URL}gate/gate-scroll.mp4`;
---

<section class="gate-scene" aria-label="Portail battant aluminium sur mesure">
  <div class="gate-scene__sticky">
    <video
      class="gate-scene__video"
      src={videoSrc}
      poster={gatePoster.src}
      muted
      playsinline
      preload="auto"
      disablepictureinpicture
      aria-hidden="true"
    ></video>
    <img
      class="gate-scene__fallback"
      src={gatePoster.src}
      alt="Portail battant aluminium anthracite posé par Pépito Services"
      loading="lazy"
    />
    <div class="gate-scene__welcome">
      <img src={logo.src} alt="Pépito Services" />
      <p>
        Clôtures rigides, portails et portillons sur mesure, murets et
        aménagements extérieurs&nbsp;: votre artisan local pour sécuriser et
        embellir votre propriété.
      </p>
    </div>
    <div class="gate-scene__hint" aria-hidden="true">
      <span class="gate-scene__hint-mouse">
        <span class="gate-scene__hint-dot"></span>
      </span>
      <svg class="gate-scene__hint-chevs" viewBox="0 0 20 24" aria-hidden="true">
        <path d="M3 3l7 6 7-6" />
        <path d="M3 10l7 6 7-6" />
        <path d="M3 17l7 6 7-6" />
      </svg>
      <span class="gate-scene__hint-label">Faites défiler</span>
    </div>
  </div>
</section>

<style>
  .gate-scene {
    position: relative;
    height: 320vh;
    /* Fond uni (sans le grain du body) : la zone entre la courbe du
       hero et le haut de la vidéo reste propre et plane. */
    background: var(--paper, #eeece6);
  }
  .gate-scene__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--paper, #eeece6);
  }
  .gate-scene__video,
  .gate-scene__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gate-scene__fallback {
    display: none;
  }
  .gate-scene--fallback .gate-scene__fallback {
    display: block;
  }
  .gate-scene__welcome {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.7rem, 1.8vh, 1.1rem);
    padding: 0 1.5rem 5vh;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    will-change: opacity, transform;
    /* Halo blanc resserré sur le logo (~7x moins étendu). */
    background: radial-gradient(
      ellipse 7.4% 6.6% at 50% 40%,
      rgb(255 255 255 / 0.72),
      rgb(255 255 255 / 0.35) 55%,
      transparent 80%
    );
  }
  .gate-scene__welcome img {
    height: clamp(6.4rem, 18vh, 11rem);
    width: auto;
    filter: drop-shadow(0 2px 26px rgb(255 255 255 / 0.9));
  }
  .gate-scene__welcome p {
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    line-height: 1.55;
    color: #3f454a;
    margin: 0;
    max-width: 34rem;
    text-shadow: 0 1px 14px rgb(255 255 255 / 0.7);
  }
  /* Indication de scroll en bas de l'écran épinglé : souris dont le
     point descend en s'estompant (opacité + position), chevrons en
     cascade, libellé qui respire. Teinte sombre — le bas de la vidéo
     est un sol clair. L'ensemble s'efface au premier scroll (JS). */
  .gate-scene__hint {
    position: absolute;
    left: 50%;
    bottom: 3.5vh;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: #2f3a35;
    pointer-events: none;
    will-change: opacity;
  }
  .gate-scene__hint-mouse {
    position: relative;
    width: 1.4rem;
    height: 2.3rem;
    border: 2px solid currentColor;
    border-radius: 999px;
    opacity: 0.9;
  }
  .gate-scene__hint-dot {
    position: absolute;
    left: 50%;
    top: 20%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: currentColor;
    animation: gate-hint-dot 1.9s ease-in-out infinite;
  }
  @keyframes gate-hint-dot {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    62% {
      transform: translateY(0.85rem);
      opacity: 1;
    }
    100% {
      transform: translateY(1.05rem);
      opacity: 0;
    }
  }
  .gate-scene__hint-chevs {
    width: 1.05rem;
    height: auto;
    display: block;
  }
  .gate-scene__hint-chevs path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: gate-hint-chev 1.9s ease-in-out infinite;
  }
  .gate-scene__hint-chevs path:nth-child(2) {
    animation-delay: 0.16s;
  }
  .gate-scene__hint-chevs path:nth-child(3) {
    animation-delay: 0.32s;
  }
  @keyframes gate-hint-chev {
    0%,
    100% {
      opacity: 0.22;
      transform: translateY(0);
    }
    42% {
      opacity: 1;
      transform: translateY(1.5px);
    }
  }
  .gate-scene__hint-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: gate-hint-breathe 1.9s ease-in-out infinite;
  }
  @keyframes gate-hint-breathe {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gate-scene__hint-mouse,
    .gate-scene__hint-dot,
    .gate-scene__hint-chevs path,
    .gate-scene__hint-label {
      animation: none;
    }
  }
  @media (max-width: 900px) {
    .gate-scene {
      height: 260vh;
    }
  }
</style>

<script>
  const gateScene = document.querySelector<HTMLElement>('.gate-scene');
  const video = gateScene?.querySelector<HTMLVideoElement>('video');
  const welcome = gateScene?.querySelector<HTMLElement>('.gate-scene__welcome');
  const hint = gateScene?.querySelector<HTMLElement>('.gate-scene__hint');

  if (gateScene && video) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

    video.addEventListener('error', () => gateScene.classList.add('gate-scene--fallback'));

    let target = 0;
    let visT = 0;
    let raf = 0;

    const tick = () => {
      raf = 0;
      if (video.readyState >= 2 && video.duration > 0) {
        const t = target * video.duration;
        // Seek uniquement si l'écart dépasse ~1 frame : la vidéo est
        // encodée avec une keyframe tous les 6 frames, les seeks sont
        // quasi instantanés mais on évite le travail inutile.
        if (Math.abs(video.currentTime - t) > 0.033) video.currentTime = t;
      }
      // Fade-in piloté par l'entrée de la section dans le viewport (visT,
      // calculé dans onScroll) : le fondu ne démarre qu'à ~30 % de remontée
      // et se termine à ~95 %, quasiment à l'épinglage.
      const fin = clamp01((visT - 0.3) / 0.65);
      video.style.opacity = String(fin * fin * (3 - 2 * fin));
      if (welcome) {
        // Le logo + le message apparaissent dans l'ouverture des vantaux.
        const w = clamp01((target - 0.45) / 0.35);
        const ws = w * w * (3 - 2 * w);
        welcome.style.opacity = String(ws);
        welcome.style.transform = `translateY(${(1 - ws) * 24}px)`;
      }
      if (hint) {
        // L'indication de scroll s'efface sur les premiers ~10 % de la
        // piste — elle a rempli son rôle dès que l'utilisateur défile.
        hint.style.opacity = String(1 - clamp01(target / 0.1));
      }
    };

    const onScroll = () => {
      const rect = gateScene.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      target = clamp01(-rect.top / (rect.height - window.innerHeight));
      visT = clamp01(1 - rect.top / window.innerHeight);
      if (!raf) raf = requestAnimationFrame(tick);
    };

    if (reduced) {
      video.addEventListener('loadedmetadata', () => {
        video.currentTime = video.duration * 0.5;
      });
      video.style.opacity = '1';
      if (welcome) welcome.style.opacity = '1';
    } else {
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }
</script>
