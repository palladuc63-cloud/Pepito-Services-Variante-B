---
import type { Service } from '../data/types';
import ContentBadge from './ContentBadge.astro';

export interface Props {
  service: Service;
  index?: number;
}

const { service, index } = Astro.props;
const number = index === undefined ? null : String(index + 1).padStart(2, '0');
const base = import.meta.env.BASE_URL;
---

<article class="card service-card">
  <div class="card-media">
    {service.imageUrl && (
      <img
        src={service.imageUrl}
        alt={`Illustration du service ${service.title}`}
        loading="lazy"
      />
    )}
  </div>
  <div class="card-body">
    {number && <span class="service-number" aria-hidden="true">N° {number}</span>}
    <h3 class="card-title">{service.title}</h3>
    <p class="card-text">{service.summary}</p>
    {service.provisional && (
      <div class="service-badge">
        <ContentBadge />
      </div>
    )}
    <a href={`${base}contact/`} class="service-link">En savoir plus</a>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .service-card .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-number {
    display: var(--deco);
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copper-dark);
  }

  .service-badge {
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .service-link {
    margin-top: var(--space-4);
    font-weight: 600;
    color: var(--forest);
    text-decoration: none;
    border-bottom: 2px solid var(--copper);
    align-self: flex-start;
  }

  .service-link:hover {
    color: var(--copper-dark);
  }
</style>
