---
import type { Service } from '../data/types';
import Icon from './Icon.astro';
import { categoryIcon } from '../lib/icons';

export interface Props {
  service: Service;
  index?: number;
}

const { service, index } = Astro.props;
const number = index === undefined ? null : String(index + 1).padStart(2, '0');
const base = import.meta.env.BASE_URL;
---

<article class="card service-card">
  <div class="card-media">
    {service.imageUrl && (
      <img
        src={service.imageUrl}
        alt={`Illustration du service ${service.title}`}
        loading="lazy"
      />
    )}
  </div>
  <div class="card-body">
    {number && <span class="service-number" aria-hidden="true">N° {number}</span>}
    <h3 class="card-title service-title"><Icon name={categoryIcon(service.slug)} size={22} class="service-icon" /> {service.title}</h3>
    <p class="card-text">{service.summary}</p>
    <a href={`${base}contact/`} class="service-link">En savoir plus</a>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .service-card .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .service-icon {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .service-number {
    display: var(--deco);
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copper-dark);
  }

  .service-link {
    margin-top: auto;
    padding-top: var(--space-4);
    font-weight: 600;
    color: var(--forest);
    text-decoration: none;
    border-bottom: 2px solid var(--copper);
    align-self: flex-start;
  }

  .service-link:hover {
    color: var(--copper-dark);
  }

  /* ═══ Nature : CTA « pilule » qui se remplit au survol ═══ */

  :global([data-theme='nature']) .service-link {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    border: 1.5px solid var(--forest);
    border-bottom-width: 1.5px;
    border-radius: 999px;
    font-size: 0.92rem;
    transition: color 0.35s ease;
  }

  /* Balayage de fond gauche → droite */
  :global([data-theme='nature']) .service-link::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    background: var(--forest);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global([data-theme='nature']) .service-link::after {
    content: '→';
    font-weight: 700;
    transition: transform 0.35s ease;
  }

  :global([data-theme='nature']) .service-link:hover,
  :global([data-theme='nature']) .service-link:focus-visible {
    color: var(--on-dark);
  }

  :global([data-theme='nature']) .service-link:hover::before,
  :global([data-theme='nature']) .service-link:focus-visible::before {
    transform: scaleX(1);
  }

  :global([data-theme='nature']) .service-link:hover::after,
  :global([data-theme='nature']) .service-link:focus-visible::after {
    transform: translateX(4px);
  }

  :global([data-theme='nature']) .service-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-theme='nature']) .service-link::before,
    :global([data-theme='nature']) .service-link::after {
      transition: none;
    }
  }
</style>
