---
export interface Props {
  variant?: 'wood' | 'stained';
}

const { variant = 'wood' } = Astro.props;
const imgUrl = variant === 'wood' ? '/fence-wood.svg' : '/fence-stained.svg';
---

<div
  class:list={['picket-separator', `picket-separator--${variant}`]}
  style={`background-image: url('${imgUrl}')`}
  aria-hidden="true"
>
</div>

<style>
  .picket-separator {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 72px;
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: center;
  }

  .picket-separator--wood {
    background-color: #f5efe6;
  }

  .picket-separator--stained {
    background-color: #3e2723;
  }
</style>
