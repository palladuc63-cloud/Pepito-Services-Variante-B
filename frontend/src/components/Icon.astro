---
import { ICONS } from '../lib/icons';

export interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name] ?? ''}
/>
