---
import logo from '../assets/pepito-logo-white.svg';
import gateWood from '../assets/gate-metal.webp';
---

<div class="gate-intro" aria-hidden="true">
  <div class="gate-veil"></div>
  <div class="gate-scene">
    <div class="gate-panel gate-left">
      <span class="gate-rim"><i class="gate-latch"></i></span>
      <span class="gate-shade"></span>
      <img class="gate-logo" src={logo.src} alt="" width="553" height="256" />
    </div>
    <div class="gate-panel gate-right">
      <span class="gate-rim"><i class="gate-latch"></i></span>
      <span class="gate-shade"></span>
      <img class="gate-logo" src={logo.src} alt="" width="553" height="256" />
    </div>
  </div>
  <div class="gate-seam"></div>
  <div class="gate-halo"></div>
  <p class="gate-skip">Cliquer pour entrer</p>
</div>

<style define:vars={{ gateWood: `url(${gateWood.src})` }}>
  .gate-intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    cursor: pointer;
  }

  :global(html.gate-intro-pending) .gate-intro {
    display: block;
  }

  .gate-veil {
    position: absolute;
    inset: 0;
    background: rgb(10 14 8 / 0.92);
  }

  .gate-scene {
    position: absolute;
    inset: 0;
    perspective: 1500px;
  }

  /* Portail battant métal : texture photographique tôle (Poly Haven,
     CC0 — panneaux soudés + usure) tuilée sur la hauteur du battant. */
  .gate-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    backface-visibility: hidden;
    will-change: transform;
    background-image:
      linear-gradient(
        180deg,
        rgb(190 215 235 / 0.1),
        transparent 26%,
        rgb(0 0 0 / 0.22) 74%,
        rgb(0 0 0 / 0.55)
      ),
      var(--gateWood);
    background-size:
      auto,
      auto 100%;
    background-repeat:
      no-repeat,
      repeat-x;
  }

  /* Cadre bois : traverses haut/bas + montant extérieur */
  .gate-left {
    left: 0;
    transform-origin: left center;
    box-shadow:
      inset 12px 0 0 rgb(10 12 15 / 0.9),
      inset 0 14px 0 rgb(10 12 15 / 0.85),
      inset 0 -14px 0 rgb(10 12 15 / 0.85);
  }

  .gate-right {
    right: 0;
    transform-origin: right center;
    background-position:
      0 0,
      -340px 0;
    box-shadow:
      inset -12px 0 0 rgb(10 12 15 / 0.9),
      inset 0 14px 0 rgb(10 12 15 / 0.85),
      inset 0 -14px 0 rgb(10 12 15 / 0.85);
  }

  /* Gonds fer noir sur le bord extérieur de chaque battant */
  .gate-panel::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 12px;
    background:
      radial-gradient(circle 4px at 6px 13%, #3a3a34 0 3px, #0c0c0b 4px 5px, transparent 6px),
      radial-gradient(circle 4px at 6px 87%, #3a3a34 0 3px, #0c0c0b 4px 5px, transparent 6px);
    background-repeat: no-repeat;
  }

  .gate-left::after {
    left: 1px;
  }

  .gate-right::after {
    right: 1px;
  }

  /* Montant métallique le long de la jointure + loquet */
  .gate-rim {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 12px;
    background: linear-gradient(90deg, #0e1013, #3a3f46 45%, #0d0f12);
  }

  /* Loquet : vrai élément animable — il se retire avant le battement */
  .gate-latch {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 26px;
    margin: -13px 0 0 -5px;
    border-radius: 5px;
    background: linear-gradient(90deg, #0b0d10, #565e66 50%, #0b0d10);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.6);
  }

  .gate-left .gate-rim {
    right: 0;
  }

  .gate-right .gate-rim {
    left: 0;
  }

  /* Le battant s'assombrit en pivotant dans l'ombre */
  .gate-shade {
    position: absolute;
    inset: 0;
    background: #060805;
    opacity: 0;
    pointer-events: none;
  }

  /* Contact au sol : ombre en bas de la scène */
  .gate-scene::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6%;
    background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.5));
    pointer-events: none;
  }

  /* Chaque battant porte une moitié du logo, centré sur la jointure :
     l'ouverture le scinde en deux. */
  .gate-logo {
    --gate-logo-w: min(300px, 62vw);
    position: absolute;
    top: 50%;
    width: var(--gate-logo-w);
    height: auto;
    transform: translateY(-50%);
    filter: drop-shadow(0 4px 18px rgb(0 0 0 / 0.55));
  }

  .gate-left .gate-logo {
    right: calc(var(--gate-logo-w) / -2);
  }

  .gate-right .gate-logo {
    left: calc(var(--gate-logo-w) / -2);
  }

  /* Halo de lumière qui s'infiltre par la fente — s'élargit avec l'écart */
  .gate-seam {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 26px;
    opacity: 0;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      rgb(255 246 224 / 0.98),
      rgb(255 246 224 / 0) 70%
    );
    filter: blur(7px);
    pointer-events: none;
  }

  /* Lumière plein écran une fois le portail ouvert — on marche dedans */
  .gate-halo {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(
      ellipse 78% 68% at center,
      rgb(255 248 230 / 0.95),
      rgb(255 248 230 / 0) 72%
    );
    pointer-events: none;
  }

  .gate-skip {
    position: absolute;
    left: 50%;
    bottom: 6%;
    margin: 0;
    transform: translateX(-50%);
    color: rgb(233 241 214 / 0.75);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    pointer-events: none;
  }
</style>

<script>
  function __playGate() {
    const root = document.querySelector<HTMLElement>('.gate-intro');
    const pending = document.documentElement.classList.contains('gate-intro-pending');
    if (!root || !pending) return;
    try {
      sessionStorage.setItem('pepito-intro-seen', '1');
    } catch (e) {}

    const left = root.querySelector<HTMLElement>('.gate-left');
    const right = root.querySelector<HTMLElement>('.gate-right');
    const veil = root.querySelector<HTMLElement>('.gate-veil');
    const seam = root.querySelector<HTMLElement>('.gate-seam');
    const scene = root.querySelector<HTMLElement>('.gate-scene');
    const skip = root.querySelector<HTMLElement>('.gate-skip');
    const shadeL = left?.querySelector<HTMLElement>('.gate-shade');
    const shadeR = right?.querySelector<HTMLElement>('.gate-shade');
    const latchL = left?.querySelector<HTMLElement>('.gate-latch');
    const latchR = right?.querySelector<HTMLElement>('.gate-latch');
    const main = document.getElementById('main-content');
    if (!left || !right || !veil || !seam) return;

    const prevOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';

    const anims: Animation[] = [];

    // Phase 0 — le loquet se retire (petit a-coup vers le haut puis sortie)
    for (const latch of [latchL, latchR]) {
      if (!latch) continue;
      anims.push(
        latch.animate(
          [
            { transform: 'translateY(0)', opacity: 1 },
            { transform: 'translateY(-4px)', opacity: 1, offset: 0.45 },
            { transform: 'translateY(-14px)', opacity: 0 },
          ],
          { duration: 300, delay: 160, easing: 'ease-in', fill: 'forwards' }
        )
      );
    }

    // Phase 1 — battement réaliste : la charnière « prend » lentement,
    // la course accélère, le battant dépasse légèrement sa butée et se
    // stabilise (décalage droite plus tardif = vantaux pas synchrones).
    const swingKeys = (dir: number) => [
      { transform: 'rotateY(0deg)', easing: 'cubic-bezier(0.55, 0, 0.85, 0.4)', offset: 0 },
      { transform: `rotateY(${5 * dir}deg)`, easing: 'cubic-bezier(0.25, 0.5, 0.3, 1)', offset: 0.24 },
      { transform: `rotateY(${108 * dir}deg)`, offset: 1 },
    ];
    anims.push(
      left.animate(swingKeys(1), { duration: 1450, delay: 460, fill: 'forwards' }),
      right.animate(swingKeys(-1), { duration: 1450, delay: 640, fill: 'forwards' })
    );

    // Le voile se lève pendant la course — le site apparaît par l'écart.
    anims.push(
      veil.animate([{ opacity: 0.92 }, { opacity: 0 }], {
        duration: 850,
        delay: 700,
        easing: 'ease-out',
        fill: 'forwards',
      })
    );

    // Lumière de la fente : s'allume puis s'élargit avec l'écart des
    // vantaux, puis se dissout quand on « passe ».
    anims.push(
      seam.animate(
        [
          { opacity: 0, transform: 'translateX(-50%) scaleX(0.3)' },
          { opacity: 0.95, transform: 'translateX(-50%) scaleX(1)', offset: 0.3 },
          { opacity: 0.9, transform: 'translateX(-50%) scaleX(5)', offset: 0.72 },
          { opacity: 0, transform: 'translateX(-50%) scaleX(8)' },
        ],
        { duration: 1500, delay: 460, easing: 'ease-out', fill: 'forwards' }
      )
    );

    // Halo plein écran : la lumière envahit tout quand le portail est
    // ouvert — maintenue jusqu'au fondu final (traversée dans le jour).
    const halo = root.querySelector<HTMLElement>('.gate-halo');
    if (halo) {
      anims.push(
        halo.animate(
          [
            { opacity: 0 },
            { opacity: 0.85, offset: 0.55 },
            { opacity: 0.9 },
          ],
          { duration: 1500, delay: 950, easing: 'ease-out', fill: 'forwards' }
        )
      );
    }

    // Ombre portée suivant le rythme du battement
    if (shadeL) {
      anims.push(
        shadeL.animate(
          [{ opacity: 0 }, { opacity: 0.2, offset: 0.4 }, { opacity: 0.55 }],
          { duration: 1000, delay: 560, easing: 'ease-out', fill: 'forwards' }
        )
      );
    }
    if (shadeR) {
      anims.push(
        shadeR.animate(
          [{ opacity: 0 }, { opacity: 0.2, offset: 0.4 }, { opacity: 0.55 }],
          { duration: 1000, delay: 700, easing: 'ease-out', fill: 'forwards' }
        )
      );
    }

    // Phase 2 — traversée : la caméra avance dans l'ouverture.
    if (scene) {
      anims.push(
        scene.animate(
          [{ transform: 'scale(1)' }, { transform: 'scale(1.085)' }],
          { duration: 850, delay: 1400, easing: 'cubic-bezier(0.6, 0, 0.8, 0.4)', fill: 'forwards' }
        )
      );
    }

    const fadeOut = root.animate(
      [{ opacity: 1 }, { opacity: 1, offset: 0.88 }, { opacity: 0 }],
      { duration: 2500, fill: 'forwards' }
    );
    anims.push(fadeOut);
    if (main) {
      anims.push(
        main.animate(
          [
            { transform: 'scale(1.045)' },
            { transform: 'scale(1)' },
          ],
          { duration: 1150, delay: 620, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' }
        )
      );
    }
    if (skip) {
      anims.push(
        skip.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: 400,
          delay: 1400,
          fill: 'forwards',
        })
      );
    }

    let done = false;
    const onSkip = () => finish();
    const finish = () => {
      if (done) return;
      done = true;
      anims.forEach((a) => a.cancel());
      document.body.style.overflow = prevOverflow;
      window.removeEventListener('pointerdown', onSkip);
      window.removeEventListener('keydown', onSkip);
      document.documentElement.classList.remove('gate-intro-pending');
      root.remove();
    };
    window.addEventListener('pointerdown', onSkip, { once: true });
    window.addEventListener('keydown', onSkip, { once: true });
    fadeOut.finished.then(finish).catch(finish);
    setTimeout(finish, 3500);
    document.addEventListener('astro:before-swap', finish, { once: true });
  }

  document.addEventListener('astro:page-load', __playGate);
</script>
