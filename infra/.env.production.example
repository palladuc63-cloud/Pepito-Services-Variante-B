# ── Base de données ──
DB_HOST=db
DB_PORT=3306
DB_NAME=pepito
DB_USER=pepito
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ── Secrets applicatifs ──
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

# ── URLs ──
FRONTEND_URL=https://pepito-services.fr
PUBLIC_SITE_URL=https://pepito-services.fr
NODE_ENV=production
PORT=3002

# ── Compte admin initial (seed) ──
ADMIN_EMAIL=admin@pepito-services.fr
ADMIN_PASSWORD=CHANGE_ME

# ── Notifications ntfy (optionnel) ──
NTFY_BASE=
NTFY_TOPIC=

# ── Facebook Graph API (publication auto des posts) ──
# À renseigner quand la Meta app + token de page seront disponibles.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
